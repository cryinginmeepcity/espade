	window:_connect(UserInputService.InputBegan, function(input)
		local t = input.UserInputType
		if window._menu and (isPress(input) or t == Enum.UserInputType.MouseButton2) then
			if contains(window._menu.Frame, pointer()) then
				return
			end
			window:CloseMenu()
		end
		if not isPress(input) or not window.Visible or window._vis < 0.5 then
			return
		end
		local p = pointer()
		if contains(handleHit, p) then
			beginDrag("handle")
		elseif contains(card, p) then
			if not overControl(card, p) then
				beginDrag("card")
			end
		elseif contains(navBack, p) then
			if not overControl(nav, p) then
				beginDrag("nav")
			end
		end
	end)
	handleHit.MouseEnter:Connect(function()
		handleHover = true
		tween(handle, Ease.Smooth, { Size = UDim2.fromOffset(132, HANDLE_H + 1) })
		chrome()
	end)
	handleHit.MouseLeave:Connect(function()
		handleHover = false
		if not dragging then
			tween(handle, Ease.Smooth, { Size = UDim2.fromOffset(96, HANDLE_H) })
		end
		chrome()
	end)

	window:_connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			local camera = workspace.CurrentCamera
			local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
			local delta = UserInputService:GetMouseLocation() - dragStartMouse
			local size = root.AbsoluteSize
			local predicted = dragStartAbs + delta
			local clamped = Vector2.new(
				math.clamp(predicted.X, -size.X * 0.5, viewport.X - size.X * 0.5),
				math.clamp(predicted.Y, 0, viewport.Y - 120)
			)
			dragTarget = dragStartOffset + (clamped - dragStartAbs)
		end
	end)
	window:_connect(UserInputService.InputEnded, function(input)
		if dragging and isPress(input) then
			dragging = false
			if not handleHover then
				tween(handle, Ease.Smooth, { Size = UDim2.fromOffset(96, HANDLE_H) })
			end
		end
	end)

	window:_connect(UserInputService.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if window._capture then
			local capture = window._capture
			window._capture = nil
			capture(key)
			return
		end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		if ctrl and (key == Enum.KeyCode.F or key == Enum.KeyCode.K) then
			window:FocusSearch()
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if key == window.ToggleKey then
			window:Toggle()
			return
		end
		if window.Visible and key == Enum.KeyCode.Backspace then
			window:Back()
			return
		end
		if window.Visible and not ctrl then
			local index = DIGITS[key]
			if index then
				local shown = {}
				for _, page in ipairs(window.Pages) do
					if page.NavItem.Visible then
						table.insert(shown, page)
					end
				end
				if shown[index] then
					window:SelectPage(shown[index])
				end
			end
		end
	end)

	local indicatorPos, indicatorSize

	window:_connect(RunService.RenderStepped, function(dt)
		local target = window.Visible and 1 or 0
		if math.abs(window._vis - target) > 0.001 then
			window._vis += (target - window._vis) * damp(window.Visible and 9 or 13, dt)
			if math.abs(window._vis - target) < 0.002 then
				window._vis = target
			end
			chrome()
		end

		if shadeT < 1 then
			shadeT = math.min(1, shadeT + dt / 0.6)
			setShade(shadeFrom + (shadeTo - shadeFrom) * smooth(shadeT))
		end

		local s = scale.Scale > 0 and scale.Scale or 1
		local camera = workspace.CurrentCamera
		local viewportY = camera and camera.ViewportSize.Y or 1080
		local room = (viewportY - card.AbsolutePosition.Y) / s - (HANDLE_GAP + HANDLE_H + 24)
		local limit = math.max(math.min(window.MaxHeight, room), window.MinHeight)

		local active = window.ActivePage
		local wanted = window.MinHeight
		if active then
			wanted = HEADER + active.Content.AbsoluteSize.Y / s
		end
		wanted = math.clamp(wanted, window.MinHeight, limit)
		if math.abs(window._height - wanted) > 0.1 then
			window._height += (wanted - window._height) * damp(13, dt)
			if math.abs(window._height - wanted) < 0.1 then
				window._height = wanted
			end
		end
		local h = math.floor(window._height + 0.5)
		if card.Size.Y.Offset ~= h then
			card.Size = UDim2.fromOffset(W, h)
			root.Size = UDim2.fromOffset(W, totalHeight(h))
			if dots then
				dots.SetHeight(h)
			end
		end
		local handleY = NAV_H + NAV_GAP + h + HANDLE_GAP + HANDLE_H / 2
		handle.Position = UDim2.new(0.5, springs.handle.off.X, 0, handleY + springs.handle.off.Y)
		handleHit.Position = handle.Position

		local mouse = (pointer() - card.AbsolutePosition) / s
		local overCard = window.Visible and mouse.X >= 0 and mouse.Y >= 0 and mouse.X <= W and mouse.Y <= h
		if dots then
			dots.Step(dt, mouse, window.Visible)
		end
		local edgeGoal = overCard and theme:Get("EdgeHover") or theme:Get("EdgeLight")
		window._edge += (edgeGoal - window._edge) * damp(5, dt)
		setEdge(1 - (1 - window._edge) * window._vis)

		for _, page in ipairs(window.Pages) do
			local goal = page == active and 1 or 0
			if math.abs(page._alpha - goal) > 0.001 or page._dirty then
				page._dirty = false
				page._alpha += (goal - page._alpha) * damp(goal == 1 and 10 or 18, dt)
				if math.abs(page._alpha - goal) < 0.003 then
					page._alpha = goal
				end
				local a = page._alpha
				page.Canvas.Visible = a > 0.003
				page.Canvas.Position = UDim2.fromOffset(0, (1 - smooth(a)) * (goal == 1 and 8 or -4))
			end
			local groupT = 1 - page._alpha * window._vis
			if math.abs(page.Canvas.GroupTransparency - groupT) > 0.0005 then
				page.Canvas.GroupTransparency = groupT
			end
		end

		navIndicator.Visible = active ~= nil and active.NavItem.Visible
		if active and active.NavItem.Visible then
			local item = active.NavItem
			local targetPos = (item.AbsolutePosition - nav.AbsolutePosition) / s
			local targetSize = item.AbsoluteSize / s
			if not indicatorPos or window._snapIndicator then
				window._snapIndicator = false
				indicatorPos, indicatorSize = targetPos, targetSize
			else
				local a = damp(18, dt)
				indicatorPos = indicatorPos:Lerp(targetPos, a)
				indicatorSize = indicatorSize:Lerp(targetSize, a)
			end
			navIndicator.Position = UDim2.fromOffset(indicatorPos.X, indicatorPos.Y)
			navIndicator.Size = UDim2.fromOffset(indicatorSize.X, indicatorSize.Y)
		end
		local navSize = nav.AbsoluteSize / s
		navBack.Size = UDim2.fromOffset(navSize.X, navSize.Y)

		local moved = Vector2.zero
		if dragTarget then
			local current = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
			moved = dragTarget - current
			root.Position = UDim2.new(root.Position.X.Scale, dragTarget.X, root.Position.Y.Scale, dragTarget.Y)
			if not dragging then
				dragTarget = nil
			end
		end

		local lag = LAG[dragMode]
		local step = math.min(dt, 0.1)
		local substeps = math.max(1, math.ceil(step / (1 / 120)))
		local h_ = step / substeps
		for name, spring in pairs(springs) do
			local params = lag[name]
			if params == false then
				params = { 900, 1 }
			else
				spring.off -= moved / s
			end
			local k, zeta = params[1], params[2]
			local c = 2 * zeta * math.sqrt(k)
			for _ = 1, substeps do
				spring.vel += (-k * spring.off - c * spring.vel) * h_
				spring.off += spring.vel * h_
			end
			if spring.off.Magnitude > MAX_LAG then
				spring.off = spring.off.Unit * MAX_LAG
			end
			if spring.off.Magnitude < 0.01 and spring.vel.Magnitude < 0.01 then
				spring.off, spring.vel = Vector2.zero, Vector2.zero
			end
		end

		local navOff, cardOff = springs.nav.off, springs.card.off
		nav.Position = UDim2.new(0.5, navOff.X, 0, navOff.Y)
		navBack.Position = nav.Position
		card.Position = UDim2.fromOffset(cardOff.X, NAV_H + NAV_GAP + cardOff.Y)
	end)

	themeBtn.MouseButton1Click:Connect(function()
		window:ToggleTheme()
	end)
	closeBtn.MouseButton1Click:Connect(function()
		window:SetVisible(false)
		window:Notify({ Title = "Hidden", Content = "Press " .. window.ToggleKey.Name .. " to open", Duration = 2.5 })
	end)

	mount(gui)
	window:_themeIcon(false)
	chrome()
	return window
end

function Window:_connect(signal, fn)
	local connection = signal:Connect(fn)
	table.insert(self._connections, connection)
	return connection
end

function Window:SetVisible(visible)
	if not self._destroyed then
		self.Visible = visible
		if not visible then
			self:CloseMenu()
		end
	end
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

function Window:SetTheme(name, instant)
	if not Themes[name] or name == self.Theme.Name then
		return
	end
	self.Theme.Name = name
	self.Theme:Apply(not instant)
	self:_themeIcon(not instant)
	if self._onTheme then
		fire(self._onTheme, name)
	end
end

function Window:ToggleTheme()
	self:SetTheme(self.Theme.Name == "Dark" and "Light" or "Dark")
end

function Window:OnThemeChanged(fn)
	self._onTheme = fn
end

function Window:OnPageChanged(fn)
	self._onPage = fn
end

function Window:SetGlow(enabled)
	if self.Dots then
		self.Dots.SetEnabled(enabled)
	end
end

function Window:SetScale(value)
	self.UserScale = math.clamp(value, self.MinScale, self.MaxScale)
	self._chrome()
	if self._onScale then
		fire(self._onScale, self.UserScale)
	end
end

function Window:OnScaleChanged(fn)
	self._onScale = fn
end

function Window:SetToggleKey(key)
	self.ToggleKey = key
end

function Window:SetTitle(title, subtitle)
	if title then
		self.TitleLabel.Text = title
	end
	if subtitle then
		self.SubtitleLabel.Text = subtitle
		self.SubtitleLabel.Visible = subtitle ~= ""
	end
end

function Window:SetLogo(logo)
	self.LogoImage.Image = self._toImage(logo) or ""
	self.LogoImage.Visible = logo ~= nil
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self.Visible = false
	self._destroyed = true
	task.delay(0.5, function()
		for _, connection in ipairs(self._connections) do
			connection:Disconnect()
		end
		self.Gui:Destroy()
	end)
end

function Window:Notify(opts)
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	table.insert(self._toasts, opts or {})
	if self._toastBusy then
		return
	end
	self._toastBusy = true
	task.spawn(function()
		while #self._toasts > 0 and not self._destroyed do
			self:_showToast(table.remove(self._toasts, 1))
		end
		self._toastBusy = false
	end)
end

function Window:_showToast(opts)
	local theme = self.Theme
	local island = self._island
	local canvas = island.Canvas
	local toneKey = ({ Danger = "Danger", Safe = "Safe", Warning = "Warning", Success = "Safe", Error = "Danger" })[opts.Type]
		or "Accent"

	for _, child in ipairs(canvas:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local row = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = canvas,
		pad(0, 18, 0, 16),
		list({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 9),
		}),
	})
	local toneDot = create("Frame", { Size = UDim2.fromOffset(7, 7), LayoutOrder = 1, Parent = row, round() })
	theme:Bind(toneDot, { BackgroundColor3 = toneKey })
	local title = label(theme, {
		Text = opts.Title or "",
		FontFace = Fonts.Medium,
		TextSize = 14,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		TextTransparency = 1,
		LayoutOrder = 2,
		Parent = row,
	})
	local content
	if opts.Content and opts.Content ~= "" then
		content = label(theme, {
			Text = opts.Content,
			TextSize = 14,
			Color = "SubText",
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			TextTruncate = Enum.TextTruncate.None,
			TextTransparency = 1,
			LayoutOrder = 3,
			Parent = row,
		})
	end

	local width = 16 + 7 + 9 + textWidth(title.Text, Fonts.Medium, 14) + 18
	if content then
		width += 9 + textWidth(content.Text, Fonts.Regular, 14)
	end
	width = math.min(math.ceil(width), 520)

	local morph = TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local back = island.Back
	back.Size = UDim2.fromOffset(40, 40)
	canvas.Size = back.Size
	tween(back, Ease.Smooth, { BackgroundTransparency = 0 })
	tween(island.Stroke, Ease.Smooth, { Transparency = theme:Get("StrokeT") })
	tween(canvas, Ease.Smooth, { GroupTransparency = 0 })
	if island.Shadow then
		tween(island.Shadow, Ease.Smooth, { Transparency = theme:Get("ShadowT") })
	end
	task.wait(0.1)
	tween(back, morph, { Size = UDim2.fromOffset(width, 40) })
	tween(canvas, morph, { Size = UDim2.fromOffset(width, 40) })
	task.wait(0.16)
	tween(title, Ease.Smooth, { TextTransparency = 0 })
	if content then
		tween(content, Ease.Smooth, { TextTransparency = 0 })
	end

	task.wait(opts.Duration or 3)

	tween(title, Ease.Hover, { TextTransparency = 1 })
	if content then
		tween(content, Ease.Hover, { TextTransparency = 1 })
	end
	task.wait(0.14)
	tween(back, morph, { Size = UDim2.fromOffset(40, 40) })
	tween(canvas, morph, { Size = UDim2.fromOffset(40, 40) })
	task.wait(0.28)
	tween(back, Ease.Smooth, { BackgroundTransparency = 1 })
	tween(island.Stroke, Ease.Smooth, { Transparency = 1 })
	tween(canvas, Ease.Smooth, { GroupTransparency = 1 })
	if island.Shadow then
		tween(island.Shadow, Ease.Smooth, { Transparency = 1 })
	end
	task.wait(0.35)
end

function Window:FocusSearch()
	if self._destroyed then
		return
	end
	if not self.Visible then
		self:SetVisible(true)
	end
	local page = self.ActivePage
	if not (page and page.FocusTarget) then
		for _, candidate in ipairs(self.Pages) do
			if candidate.FocusTarget then
				page = candidate
				break
			end
		end
	end
	if page and page.FocusTarget then
		self:SelectPage(page)
		task.defer(function()
			page.FocusTarget:Focus()
		end)
	end
end

function Window:Copy(text, what)
	local fn = setclipboard or toclipboard or (Clipboard and Clipboard.set)
	if type(fn) == "function" and pcall(fn, tostring(text)) then
		self:Notify({ Title = "Copied", Content = what, Type = "Safe", Duration = 2 })
		return true
	end
	self:Notify({ Title = "Can't copy", Content = "Clipboard isn't available here", Type = "Warning", Duration = 2.5 })
	return false
end

function Window:CloseMenu()
	local menu = self._menu
	if not menu then
		return
	end
	self._menu = nil
	tween(menu.Scale, Ease.Hover, { Scale = self.UserScale * 0.96 })
	tween(menu.Frame, Ease.Hover, { BackgroundTransparency = 1 })
	tween(menu.Stroke, Ease.Hover, { Transparency = 1 })
	if menu.Shadow then
		tween(menu.Shadow, Ease.Hover, { Transparency = 1 })
	end
	for _, text in ipairs(menu.Labels) do
		tween(text, Ease.Hover, { TextTransparency = 1 })
	end
	task.delay(0.22, function()
		menu.Frame:Destroy()
	end)
end

function Window:OpenMenu(items)
	self:CloseMenu()
	if self._destroyed or not items or #items == 0 then
		return
	end
	local theme = self.Theme
	local WIDTH = 196
	local pos = self._pointer()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local height = 8 + #items * 34
	local x = math.min(pos.X + 6, viewport.X - WIDTH * self.UserScale - 8)
	local y = math.min(pos.Y + 6, viewport.Y - height * self.UserScale - 60)

	local frame = create("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(WIDTH, height),
		BackgroundTransparency = 1,
		ZIndex = 60,
		Parent = self.Gui,
		corner(12),
		pad(4),
		list({ Padding = UDim.new(0, 0) }),
	})
	theme:Bind(frame, { BackgroundColor3 = "Elevated" })
	local menuStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = frame })
	theme:Bind(menuStroke, { Color = "StrokeColor" })
	local menuShadow = newShadow(frame, {
		BlurRadius = UDim.new(0, 24),
		Offset = UDim2.fromOffset(0, 8),
		Transparency = 1,
		ShowBehindParent = false,
	})
	if menuShadow then
		theme:Bind(menuShadow, { Color = "Shadow" })
	end
	local menuScale = create("UIScale", { Scale = self.UserScale * 0.96, Parent = frame })

	local labels = {}
	for i, item in ipairs(items) do
		local btn = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = i,
			ZIndex = 61,
			Parent = frame,
			corner(8),
		})
		theme:Bind(btn, { BackgroundColor3 = "HoverColor" })
		local text = label(theme, {
			Text = item.Title or "",
			FontFace = Fonts.Medium,
			TextSize = 14,
			Color = item.Danger and "Danger" or "Text",
			TextTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -24, 1, 0),
			ZIndex = 62,
			Parent = btn,
		})
		table.insert(labels, text)
		btn.MouseEnter:Connect(function()
			tween(btn, Ease.Hover, { BackgroundTransparency = theme:Get("HoverT") - 0.02 })
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, Ease.Hover, { BackgroundTransparency = 1 })
		end)
		btn.MouseButton1Click:Connect(function()
			self:CloseMenu()
			fire(item.Callback)
		end)
	end

	tween(menuScale, Ease.Smooth, { Scale = self.UserScale })
	tween(frame, Ease.Hover, { BackgroundTransparency = 0 })
	tween(menuStroke, Ease.Hover, { Transparency = theme:Get("StrokeT") })
	if menuShadow then
		tween(menuShadow, Ease.Hover, { Transparency = theme:Get("ShadowT") })
	end
	for _, text in ipairs(labels) do
		tween(text, Ease.Hover, { TextTransparency = 0 })
	end
	self._menu = { Frame = frame, Scale = menuScale, Stroke = menuStroke, Shadow = menuShadow, Labels = labels }
end

function Window:Page(opts)
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	opts = opts or {}
	local theme = self.Theme
	local page = setmetatable({ Window = self, Title = opts.Title or "Page", _order = 0, _alpha = 0, _dirty = true }, Page)

	local item = create("TextButton", {
		Name = page.Title,
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = #self.Pages + 1,
		Visible = opts.Hidden ~= true,
		Parent = self.NavItems,
		pad(0, 16, 0, 16),
	})
	local itemLabel = label(theme, {
		Text = page.Title,
		FontFace = Fonts.Medium,
		TextSize = 14,
		Color = "Muted",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Parent = item,
	})
	page.NavItem = item
	page.NavLabel = itemLabel

	local canvas = create("CanvasGroup", {
		Name = page.Title,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = self.PagesHolder,
		corner(RADIUS),
	})
	local scroll = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageTransparency = 0.85,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = canvas,
	})
	theme:Bind(scroll, { ScrollBarImageColor3 = "Text" })
	local content = create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = scroll,
		pad(2, 22, 22, 22),
		list({ Padding = UDim.new(0, 12) }),
	})
	page.Canvas = canvas
	page.Scroll = scroll
	page.Content = content

	item.MouseEnter:Connect(function()
		if self.ActivePage ~= page then
			theme:Set(itemLabel, "TextColor3", "SubText", Ease.Hover)
		end
	end)
	item.MouseLeave:Connect(function()
		if self.ActivePage ~= page then
			theme:Set(itemLabel, "TextColor3", "Muted", Ease.Hover)
		end
	end)
	item.MouseButton1Click:Connect(function()
		self:SelectPage(page)
	end)

	table.insert(self.Pages, page)
	if not self.ActivePage then
		self:SelectPage(page, true)
	end
	return page
end

function Window:SelectPage(page, instant, fromBack)
	if self.ActivePage == page then
		return
	end
	local theme = self.Theme
	local old = self.ActivePage
	if old and not fromBack then
		table.insert(self._history, old)
		if #self._history > 40 then
			table.remove(self._history, 1)
		end
	end
	self.ActivePage = page
	if self._updateBack then
		self:_updateBack()
	end
	if old then
		theme:Set(old.NavLabel, "TextColor3", "Muted", Ease.Hover)
	end
	theme:Set(page.NavLabel, "TextColor3", "Text", if instant then nil else Ease.Hover)
	page.Scroll.CanvasPosition = Vector2.zero
	page.Canvas.Visible = true
	if instant then
		page._alpha = 1
		self._snapIndicator = true
	end
	page._dirty = true
	if self._onPage then
		fire(self._onPage, page.Title)
	end
end

function Window:Back()
	while #self._history > 0 do
		local page = table.remove(self._history)
		if page ~= self.ActivePage then
			self:SelectPage(page, false, true)
			return true
		end
	end
	self:_updateBack()
	return false
end

function Window:ClearHistory()
	table.clear(self._history)
	self:_updateBack()
end

function Page:_next()
	self._order += 1
	return self._order
end

function Page:Select()
	self.Window:SelectPage(self)
end

local function finish(obj, row)
	obj.Row = row
	function obj:SetVisible(visible)
		row.Visible = visible
	end
	function obj:Destroy()
		row:Destroy()
	end
	return obj
end

