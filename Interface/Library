	local height = (hasSub or opts.Image or opts.Icon) and 56 or 46
	local row = self:_shell(height)
	local clickable = opts.Callback ~= nil
	if not clickable and not opts.Menu then
		row:SetAttribute("IsleStatic", true)
	end
	if opts.Menu then
		row.MouseButton2Click:Connect(function()
			local items = type(opts.Menu) == "function" and opts.Menu() or opts.Menu
			self.Window:OpenMenu(items)
		end)
	end
	local left = 14
	local icon
	if opts.Image then
		local image = create("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.fromOffset(32, 32),
			Image = opts.Image,
			Parent = row,
			round(),
		})
		theme:Bind(image, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
		left = 56
	elseif opts.Icon then
		local _, tileIcon = iconTile(theme, row, opts.Icon, 32, 16, "SubText", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
		}, opts.IconFallback)
		icon = tileIcon
		if opts.IconColor then
			icon:SetColor(opts.IconColor)
		end
		left = 56
	end
	local rightText = tostring(opts.Right or "")
	local rightMax = opts.RightMax or 150
	local rightW = rightText ~= "" and math.clamp(estimate(rightText, 13) + 6, 20, rightMax) or 0
	local rightPad = clickable and 34 or 14
	local delay = self:_delay()
	local titleLabel = label(theme, {
		Text = opts.Title or "",
		FontFace = Fonts.Medium,
		TextSize = 14,
		Position = UDim2.fromOffset(left, hasSub and 10 or 0),
		Size = UDim2.new(1, -(left + rightPad + rightW + 10), 0, hasSub and 20 or height),
		Parent = row,
	})
	reveal(titleLabel, delay, Ease.Smooth)
	if hasSub then
		local sub = label(theme, {
			Text = opts.Subtitle,
			TextSize = 13,
			Color = "SubText",
			Position = UDim2.fromOffset(left, 30),
			Size = UDim2.new(1, -(left + rightPad + rightW + 10), 0, 16),
			Parent = row,
		})
		reveal(sub, delay, Ease.Smooth)
	end
	local rightLabel = label(theme, {
		Text = rightText,
		TextSize = 13,
		Color = opts.RightColor or "Muted",
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -rightPad, 0.5, 0),
		Size = UDim2.fromOffset(math.max(rightW, 20), 20),
		Parent = row,
	})
	reveal(rightLabel, delay, Ease.Smooth)
	if clickable then
		local arrow = newIcon(theme, row, "chevron-right", "Muted", 14, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
		})
		hoverFill(theme, row, "Clear", "HoverT", "PressT")
		row.MouseEnter:Connect(function()
			tween(arrow.Frame, Ease.Smooth, { Position = UDim2.new(1, -9, 0.5, 0) })
			arrow:SetColor("Text", Ease.Hover)
		end)
		row.MouseLeave:Connect(function()
			tween(arrow.Frame, Ease.Smooth, { Position = UDim2.new(1, -12, 0.5, 0) })
			arrow:SetColor("Muted", Ease.Hover)
		end)
		row.MouseButton1Click:Connect(function()
			fire(opts.Callback)
		end)
	elseif opts.Menu then
		hoverFill(theme, row, "Clear", "HoverT")
	end
	return finish({
		SetRight = function(_, value)
			value = tostring(value or "")
			rightLabel.Text = value
			local w = value ~= "" and math.clamp(estimate(value, 13) + 6, 20, rightMax) or 0
			rightLabel.Size = UDim2.fromOffset(math.max(w, 20), 20)
			titleLabel.Size = UDim2.new(1, -(left + rightPad + w + 10), 0, hasSub and 20 or height)
		end,
	}, row)
end

