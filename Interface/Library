	theme:Bind(handle, { BackgroundColor3 = "HandleColor" })
	local handleHit = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(220, 26),
		BackgroundTransparency = 1,
		Parent = root,
	})

	local island = create("Frame", {
		Name = "IslandBack",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 18),
		Size = UDim2.fromOffset(40, 40),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = gui,
		round(),
	})
	theme:Bind(island, { BackgroundColor3 = "Elevated" })
	local islandStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = island })
	theme:Bind(islandStroke, { Color = "StrokeColor" })
	local islandShadow = newShadow(island, {
		BlurRadius = UDim.new(0, 28),
		Offset = UDim2.fromOffset(0, 10),
		Transparency = 1,
		ShowBehindParent = false,
	})
	if islandShadow then
		theme:Bind(islandShadow, { Color = "Shadow" })
	end
	local islandCanvas = create("CanvasGroup", {
		Name = "Island",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = island.Position,
		Size = island.Size,
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		ZIndex = 51,
		Parent = gui,
		round(),
	})
	local islandScale = create("UIScale", { Parent = island })
	local islandCanvasScale = create("UIScale", { Parent = islandCanvas })
	window._island = {
		Back = island,
		Shadow = islandShadow,
		Canvas = islandCanvas,
		Stroke = islandStroke,
		Scale = islandScale,
		CanvasScale = islandCanvasScale,
	}

	local handleHover = false
	local function chrome()
		local v = window._vis
		fill.BackgroundTransparency = 1 - (1 - theme:Get("CardT")) * v
		setRim(v)
		if cardShadow then
			cardShadow.Transparency = 1 - (1 - theme:Get("ShadowT")) * v
		end
		header.GroupTransparency = 1 - v
		if dots then
			dots.Canvas.GroupTransparency = 1 - v
		end
		nav.GroupTransparency = 1 - v
		navBack.BackgroundTransparency = 1 - v
		navStroke.Transparency = 1 - (1 - theme:Get("StrokeT")) * v
		if navShadow then
			navShadow.Transparency = 1 - (1 - theme:Get("ShadowT")) * v
		end
		local handleT = theme:Get("HandleT") - (handleHover and 0.25 or 0)
		handle.BackgroundTransparency = 1 - (1 - handleT) * v
		if grain then
			grain.ImageTransparency = 1 - GRAIN_STRENGTH * v
		end
		local e = smooth(v)
		scale.Scale = (0.97 + 0.03 * e) * window.UserScale
		islandScale.Scale = window.UserScale
		islandCanvasScale.Scale = window.UserScale
		root.Visible = v > 0.002
	end
	window._chrome = chrome

	local shadeFrom, shadeTo, shadeT = shade, shade, 1
	local chromeT = 1
	theme:OnChanged(function(animated)
		if animated then
			shadeFrom, shadeTo, shadeT = shade, theme:Get("Shade"), 0
			chromeT = 0
		else
			setShade(theme:Get("Shade"))
		end
		chrome()
	end)

	local dragging = false
	local dragStartMouse, dragStartOffset, dragStartAbs
	local dragTarget
	local dragMode = "card"

	local LAG = {
		card = { card = false, nav = { 170, 0.72 }, handle = { 170, 0.72 } },
		nav = { nav = false, card = { 210, 0.8 }, handle = { 130, 0.72 } },
		handle = { handle = false, card = { 190, 0.78 }, nav = { 105, 0.7 } },
	}
	local springs = {
		card = { off = Vector2.zero, vel = Vector2.zero },
		nav = { off = Vector2.zero, vel = Vector2.zero },
		handle = { off = Vector2.zero, vel = Vector2.zero },
	}
	local MAX_LAG = 70

	local function contains(inst, p)
		local pos, size = inst.AbsolutePosition, inst.AbsoluteSize
		return p.X >= pos.X and p.Y >= pos.Y and p.X <= pos.X + size.X and p.Y <= pos.Y + size.Y
	end
	window._contains = contains

	local function reachable(inst, stop, p)
		local node = inst
		while node and node ~= stop do
			if node:IsA("GuiObject") then
				if not node.Visible then
					return false
				end
				if node ~= inst and node.ClipsDescendants and not contains(node, p) then
					return false
				end
			end
			node = node.Parent
		end
		return true
	end

	local function overControl(container, p)
		for _, inst in ipairs(container:GetDescendants()) do
			if (inst:IsA("GuiButton") or inst:IsA("TextBox")) and not inst:GetAttribute("IsleStatic") then
				if contains(inst, p) and reachable(inst, container, p) then
					return true
				end
			end
		end
		return false
	end

	local function beginDrag(mode)
		dragging = true
		dragMode = mode
		dragStartMouse = UserInputService:GetMouseLocation()
		dragStartOffset = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
		dragStartAbs = root.AbsolutePosition
		dragTarget = dragStartOffset
	end

	window:_connect(UserInputService.InputBegan, function(input)
		local t = input.UserInputType
		if window._menu and (isPress(input) or t == Enum.UserInputType.MouseButton2) then
			if contains(window._menu.Frame, pointer()) then
				return
			end
			window:CloseMenu()
		end
		if not isPress(input) or not window.Visible or window._vis < 0.5 then
			return
		end
		local p = pointer()
		if contains(handleHit, p) then
			beginDrag("handle")
		elseif contains(card, p) then
			if not overControl(card, p) then
				beginDrag("card")
			end
		elseif contains(navBack, p) then
			if not overControl(nav, p) then
				beginDrag("nav")
			end
		end
	end)
	handleHit.MouseEnter:Connect(function()
		handleHover = true
		tween(handle, Ease.Pop, { Size = UDim2.fromOffset(132, HANDLE_H + 1) })
		chrome()
	end)
	handleHit.MouseLeave:Connect(function()
		handleHover = false
		if not dragging then
			tween(handle, Ease.Smooth, { Size = UDim2.fromOffset(96, HANDLE_H) })
		end
		chrome()
	end)

	window:_connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			local camera = workspace.CurrentCamera
			local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
			local delta = UserInputService:GetMouseLocation() - dragStartMouse
			local size = root.AbsoluteSize
			local predicted = dragStartAbs + delta
			local clamped = Vector2.new(
				math.clamp(predicted.X, -size.X * 0.5, viewport.X - size.X * 0.5),
				math.clamp(predicted.Y, 0, viewport.Y - 120)
			)
			dragTarget = dragStartOffset + (clamped - dragStartAbs)
		end
	end)
	window:_connect(UserInputService.InputEnded, function(input)
		if dragging and isPress(input) then
			dragging = false
			if not handleHover then
				tween(handle, Ease.Smooth, { Size = UDim2.fromOffset(96, HANDLE_H) })
			end
		end
	end)

	window:_connect(UserInputService.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if window._capture then
			local capture = window._capture
			window._capture = nil
			capture(key)
			return
		end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		if ctrl and (key == Enum.KeyCode.F or key == Enum.KeyCode.K) then
			window:FocusSearch()
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if key == window.ToggleKey then
			window:Toggle()
			return
		end
		if window._modals > 0 then
			return
		end
		if window.Visible and key == Enum.KeyCode.Backspace then
			window:Back()
			return
		end
		if window.Visible and not ctrl then
			local index = DIGITS[key]
			if index then
				local shown = {}
				for _, page in ipairs(window.Pages) do
					if page.NavItem.Visible then
						table.insert(shown, page)
					end
				end
				if shown[index] then
					window:SelectPage(shown[index])
				end
			end
		end
	end)

	local indicatorPos, indicatorSize
	local brandAlpha = 1
	local indicatorVel, indicatorSizeVel = Vector2.zero, Vector2.zero

	window:_connect(RunService.RenderStepped, function(dt)
		local loopStart = os.clock()
		dt = math.min(dt, 0.1)
		local target = window.Visible and 1 or 0
		if math.abs(window._vis - target) > 0.001 then
			window._vis += (target - window._vis) * damp(window.Visible and 9 or 13, dt)
			if math.abs(window._vis - target) < 0.002 then
				window._vis = target
			end
			chrome()
		end

		if shadeT < 1 then
			shadeT = math.min(1, shadeT + dt / 0.55)
			setShade(shadeFrom + (shadeTo - shadeFrom) * smooth(shadeT))
		end
		if chromeT < 1 then
			chromeT = math.min(1, chromeT + dt / 0.55)
			chrome()
		end

		local s = unscale()
		local camera = workspace.CurrentCamera
		local viewportY = camera and camera.ViewportSize.Y or 1080
		local room = (viewportY - card.AbsolutePosition.Y) / s - (HANDLE_GAP + HANDLE_H + 24)
		local limit = math.max(math.min(window.MaxHeight, room), window.MinHeight)

		local active = window.ActivePage
		local wanted = window.MinHeight
		if active and active.FullHeight then
			wanted = limit
		elseif active then
			wanted = (active._hero and HERO_TOP or HEADER) + active.Content.AbsoluteSize.Y / s
		end
		if window._modals > 0 then
			wanted = math.max(wanted, window._modalHeight or 320)
		end
		wanted = math.clamp(wanted, window.MinHeight, limit)
		if math.abs(window._height - wanted) > 0.1 then
			window._height += (wanted - window._height) * damp(13, dt)
			if math.abs(window._height - wanted) < 0.1 then
				window._height = wanted
			end
		end
		local wantedW = (active and active.Width) or W
		if math.abs(window._width - wantedW) > 0.2 then
			window._width += (wantedW - window._width) * damp(11, dt)
			if math.abs(window._width - wantedW) < 0.2 then
				window._width = wantedW
			end
		end
		local h = math.floor(window._height + 0.5)
		local w = math.floor(window._width + 0.5)
		if card.Size.Y.Offset ~= h or card.Size.X.Offset ~= w then
			card.Size = UDim2.fromOffset(w, h)
			root.Size = UDim2.fromOffset(w, totalHeight(h))
			if dots then
				dots.SetSize(w, h)
			end
		end
		local handleY = NAV_H + NAV_GAP + h + HANDLE_GAP + HANDLE_H / 2
		handle.Position = UDim2.new(0.5, springs.handle.off.X, 0, handleY + springs.handle.off.Y)
		handleHit.Position = handle.Position

		local mouse = (pointer() - card.AbsolutePosition) / s
		local overCard = window.Visible and mouse.X >= 0 and mouse.Y >= 0 and mouse.X <= w and mouse.Y <= h
		if dots then
			dots.Step(dt, mouse, window.Visible)
		end
		local edgeGoal = overCard and theme:Get("EdgeHover") or theme:Get("EdgeLight")
		window._edge += (edgeGoal - window._edge) * damp(5, dt)
		setEdge(1 - (1 - window._edge) * window._vis)

		for _, page in ipairs(window.Pages) do
			local goal = page == active and 1 or 0
			if math.abs(page._alpha - goal) > 0.001 or page._dirty then
				page._dirty = false
				page._alpha += (goal - page._alpha) * damp(goal == 1 and 9 or 20, dt)
				if math.abs(page._alpha - goal) < 0.003 then
					page._alpha = goal
				end
				local a = page._alpha
				page.Canvas.Visible = a > 0.003
				local slide = 36 * (1 - smooth(a))
				local dir = page._dir or 1
				page._off = goal == 1 and slide * dir or -slide * dir
			end
			-- hero pages start under the header buttons and collapse into the header while scrolling
			local top = HEADER
			if page._hero then
				top = HERO_TOP + math.clamp(page.Scroll.CanvasPosition.Y, 0, HEADER - HERO_TOP)
			end
			local off = page._off or 0
			if page._top ~= top or page._placed ~= off then
				page._top, page._placed = top, off
				page.Canvas.Position = UDim2.fromOffset(off, top)
				page.Canvas.Size = UDim2.new(1, 0, 1, -top)
			end
			local groupT = 1 - smooth(page._alpha) * window._vis
			if math.abs(page.Canvas.GroupTransparency - groupT) > 0.0005 then
				page.Canvas.GroupTransparency = groupT
			end
		end

		local hero = active and active._hero
		local heroShown = false
		if hero and hero.Parent then
			heroShown = hero.AbsolutePosition.Y + hero.AbsoluteSize.Y * 0.55 > active.Scroll.AbsolutePosition.Y
		end
		local brandGoal = heroShown and 0 or 1
		if brandAlpha ~= brandGoal then
			brandAlpha += (brandGoal - brandAlpha) * damp(12, dt)
			if math.abs(brandAlpha - brandGoal) < 0.01 then
				brandAlpha = brandGoal
			end
			brand.GroupTransparency = 1 - brandAlpha
		end

		navIndicator.Visible = active ~= nil and active.NavItem.Visible
		if active and active.NavItem.Visible then
			local item = active.NavItem
			local targetPos = (item.AbsolutePosition - nav.AbsolutePosition) / s
			local targetSize = item.AbsoluteSize / s
			if not indicatorPos or window._snapIndicator then
				window._snapIndicator = false
				indicatorPos, indicatorSize = targetPos, targetSize
				indicatorVel, indicatorSizeVel = Vector2.zero, Vector2.zero
			else
				local k, c = 420, 2 * 0.78 * math.sqrt(420)
				local steps = math.max(1, math.ceil(dt * 120))
				local hstep = dt / steps
				for _ = 1, steps do
					indicatorVel += ((targetPos - indicatorPos) * k - indicatorVel * c) * hstep
					indicatorPos += indicatorVel * hstep
					indicatorSizeVel += ((targetSize - indicatorSize) * k - indicatorSizeVel * c) * hstep
					indicatorSize += indicatorSizeVel * hstep
				end
			end
			navIndicator.Position = UDim2.fromOffset(indicatorPos.X, indicatorPos.Y)
			navIndicator.Size = UDim2.fromOffset(math.max(indicatorSize.X, 0), math.max(indicatorSize.Y, 0))
		end
		local navSize = nav.AbsoluteSize / s
		navBack.Size = UDim2.fromOffset(navSize.X, navSize.Y)

		local moved = Vector2.zero
		if dragTarget then
			local current = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
			moved = dragTarget - current
			root.Position = UDim2.new(root.Position.X.Scale, dragTarget.X, root.Position.Y.Scale, dragTarget.Y)
			if not dragging then
				dragTarget = nil
			end
		end

		local lag = LAG[dragMode]
		local substeps = math.max(1, math.ceil(dt * 120))
		local hs = dt / substeps
		for name, spring in pairs(springs) do
			local params = lag[name]
			if params == false then
				params = { 900, 1 }
			else
				spring.off -= moved / s
			end
			local k, zeta = params[1], params[2]
			local c = 2 * zeta * math.sqrt(k)
			for _ = 1, substeps do
				spring.vel += (-k * spring.off - c * spring.vel) * hs
				spring.off += spring.vel * hs
			end
			if spring.off.Magnitude > MAX_LAG then
				spring.off = spring.off.Unit * MAX_LAG
			end
			if spring.off.Magnitude < 0.01 and spring.vel.Magnitude < 0.01 then
				spring.off, spring.vel = Vector2.zero, Vector2.zero
			end
		end

		local navOff, cardOff = springs.nav.off, springs.card.off
		nav.Position = UDim2.new(0.5, navOff.X, 0, navOff.Y)
		navBack.Position = nav.Position
		card.Position = UDim2.fromOffset(cardOff.X, NAV_H + NAV_GAP + cardOff.Y)

		for _, step in ipairs(window._steppers) do
			step(dt, s)
		end
		if os.clock() - loopStart > 0.05 then
			print(string.format("[Isle] frame loop took %.2fs", os.clock() - loopStart))
		end
	end)

	themeBtn.MouseButton1Click:Connect(function()
		window:ToggleTheme()
	end)
	closeBtn.MouseButton1Click:Connect(function()
		window:SetVisible(false)
		window:Notify({ Title = "Hidden", Content = "Press " .. keyName(window.ToggleKey) .. " to open", Duration = 2.5 })
	end)

	mount(gui)
	window:_themeIcon(false)
	chrome()
	return window
end

function Window:_connect(signal, fn)
	local connection = signal:Connect(fn)
	table.insert(self._connections, connection)
	return connection
end

function Window:SetVisible(visible)
	if not self._destroyed then
		self.Visible = visible
		if not visible then
			self:CloseMenu()
		end
	end
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

function Window:SetTheme(name, instant)
	if not Themes[name] or name == self.Theme.Name then
		return
	end
	self.Theme.Name = name
	self.Theme:Apply(not instant)
	self:_themeIcon(not instant)
	if self._onTheme then
		fire(self._onTheme, name)
	end
end

function Window:ToggleTheme()
	self:SetTheme(self.Theme.Name == "Dark" and "Light" or "Dark")
end

function Window:OnThemeChanged(fn)
	self._onTheme = fn
end

function Window:OnPageChanged(fn)
	self._onPage = fn
end

function Window:SetGlow(enabled)
	if self.Dots then
		self.Dots.SetEnabled(enabled)
	end
end

function Window:SetScale(value)
	self.UserScale = math.clamp(value, self.MinScale, self.MaxScale)
	self._chrome()
	if self._onScale then
		fire(self._onScale, self.UserScale)
	end
end

function Window:OnScaleChanged(fn)
	self._onScale = fn
end

function Window:SetToggleKey(key)
	self.ToggleKey = key
end

function Window:SetTitle(title, subtitle)
	if title then
		self.TitleLabel.Text = title
	end
	if subtitle then
		self.SubtitleLabel.Text = subtitle
		self.SubtitleLabel.Visible = subtitle ~= ""
		self._subDot.Visible = subtitle ~= ""
		if subtitle ~= "" then
			reveal(self.SubtitleLabel, 0, Ease.Smooth)
		end
	end
end

function Window:SetLogo(logo)
	self.LogoImage.Image = self._toImage(logo) or ""
	self.LogoImage.Visible = logo ~= nil
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self.Visible = false
	self._destroyed = true
	task.delay(0.5, function()
		for _, connection in ipairs(self._connections) do
			connection:Disconnect()
		end
		self.Gui:Destroy()
	end)
end

local TOAST_MORPH = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_RESIZE = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TOAST_TONES = { Danger = "Danger", Safe = "Safe", Warning = "Warning", Success = "Safe", Error = "Danger" }

-- one island at a time: a new message replaces the current one in place instead of queueing behind it
function Window:Notify(opts)
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	opts = opts or {}
	if self._destroyed then
		return
	end
	local theme = self.Theme
	local island = self._island
	local back, canvas = island.Back, island.Canvas
	local state = self._toast
	if not state then
		state = { Token = 0, Shown = false, Count = 0, Over = false }
		self._toast = state
		back.MouseEnter:Connect(function()
			state.Over = true
		end)
		back.MouseLeave:Connect(function()
			state.Over = false
			if state.Shown and state.Expired then
				state.Hide(state.Token)
			end
		end)
		back.InputBegan:Connect(function(input)
			if isPress(input) and state.Shown then
				state.Hide(state.Token)
			end
		end)
	end

	local title = tostring(opts.Title or "")
	local content = opts.Content and tostring(opts.Content) or ""
	local toneKey = TOAST_TONES[opts.Type] or "Accent"
	local key = title .. "\0" .. content .. "\0" .. toneKey
	state.Count = (state.Shown and state.Key == key) and state.Count + 1 or 1
	state.Key = key
	state.Token += 1
	state.Expired = false
	local mine = state.Token

	local old = state.Row
	if old then
		tween(old, Ease.Quick, { GroupTransparency = 1 })
		task.delay(0.12, function()
			old:Destroy()
		end)
	end

	local row = create("CanvasGroup", {
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = canvas,
		list({
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 9),
		}),
	})
	state.Row = row
	local toneDot = create("Frame", { Size = UDim2.fromOffset(7, 7), LayoutOrder = 1, Parent = row, round() })
	theme:Bind(toneDot, { BackgroundColor3 = toneKey })
	local width = 16 + 7 + 18
	local function text(value, order, font, colorKey, size)
		label(theme, {
			Text = value,
			FontFace = font,
			TextSize = size or 14,
			Color = colorKey,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = order,
			Parent = row,
		})
		width += 9 + math.ceil(measure(value, size or 14) * 1.04) + 1
	end
	if title ~= "" then
		text(title, 2, Fonts.Medium, "Text")
	end
	if content ~= "" then
		text(content, 3, Fonts.Regular, "SubText")
	end
	if state.Count > 1 then
		text("×" .. state.Count, 4, Fonts.Medium, "Muted", 13)
	end
	width = math.clamp(width, 44, 520)
	local goal = { Size = UDim2.fromOffset(width, 40), Position = UDim2.new(0.5, 0, 0, 18) }

	if state.Shown then
		tween(back, TOAST_RESIZE, goal)
		tween(canvas, TOAST_RESIZE, goal)
		tween(row, Ease.Hover, { GroupTransparency = 0 })
	else
		state.Shown = true
		local dot = UDim2.fromOffset(12, 12)
		local low = UDim2.new(0.5, 0, 0, 32)
		back.Size, canvas.Size = dot, dot
		back.Position, canvas.Position = low, low
		tween(back, Ease.Hover, { BackgroundTransparency = 0 })
		tween(island.Stroke, Ease.Hover, { Transparency = theme:Get("StrokeT") })
		tween(canvas, Ease.Hover, { GroupTransparency = 0 })
		if island.Shadow then
			tween(island.Shadow, Ease.Smooth, { Transparency = theme:Get("ShadowT") })
		end
		tween(back, TOAST_MORPH, goal)
		tween(canvas, TOAST_MORPH, goal)
		task.delay(0.12, function()
			if row.Parent then
				tween(row, Ease.Smooth, { GroupTransparency = 0 })
			end
		end)
	end

	function state.Hide(token)
		if token ~= state.Token or not state.Shown then
			return
		end
		state.Shown = false
		state.Count = 0
		state.Token += 1
		local leaving = state.Row
		state.Row = nil
		if leaving then
			tween(leaving, Ease.Quick, { GroupTransparency = 1 })
		end
		local dot = { Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0.5, 0, 0, 32) }
		tween(back, TOAST_RESIZE, dot)
		tween(canvas, TOAST_RESIZE, dot)
		task.delay(0.14, function()
			if state.Shown then
				return
			end
			tween(back, Ease.Hover, { BackgroundTransparency = 1 })
			tween(island.Stroke, Ease.Hover, { Transparency = 1 })
			tween(canvas, Ease.Hover, { GroupTransparency = 1 })
			if island.Shadow then
				tween(island.Shadow, Ease.Hover, { Transparency = 1 })
			end
		end)
		task.delay(0.4, function()
			if leaving then
				leaving:Destroy()
			end
		end)
	end

	task.delay(math.clamp(opts.Duration or 2.4, 0.8, 8), function()
		if mine ~= state.Token then
			return
		end
		state.Expired = true
		if not state.Over then
			state.Hide(mine)
		end
	end)
end

function Window:FocusSearch()
	if self._destroyed then
		return
	end
	if not self.Visible then
		self:SetVisible(true)
	end
	local page = self.ActivePage
	if not (page and page.FocusTarget) then
		for _, candidate in ipairs(self.Pages) do
			if candidate.FocusTarget then
				page = candidate
				break
			end
		end
	end
	if page and page.FocusTarget then
		self:SelectPage(page)
		task.defer(function()
			page.FocusTarget:Focus()
		end)
	end
end

function Window:Copy(text, what)
	local fn = setclipboard or toclipboard or (Clipboard and Clipboard.set)
	if type(fn) == "function" and pcall(fn, tostring(text)) then
		self:Notify({ Title = "Copied", Content = what, Type = "Safe", Duration = 2 })
		return true
	end
	self:Notify({ Title = "Can't copy", Content = "Clipboard isn't available here", Type = "Warning", Duration = 2.5 })
	return false
end

function Window:CloseMenu()
	local menu = self._menu
	if not menu then
		return
	end
	self._menu = nil
	tween(menu.Scale, Ease.Hover, { Scale = self.UserScale * 0.95 })
	tween(menu.Frame, Ease.Hover, { BackgroundTransparency = 1 })
	tween(menu.Stroke, Ease.Hover, { Transparency = 1 })
	tween(menu.Content, Ease.Hover, { GroupTransparency = 1 })
	if menu.Shadow then
		tween(menu.Shadow, Ease.Hover, { Transparency = 1 })
	end
	task.delay(0.2, function()
		menu.Frame:Destroy()
	end)
end

function Window:OpenMenu(items)
	self:CloseMenu()
	if self._destroyed or not items or #items == 0 then
		return
	end
	local theme = self.Theme
	local WIDTH = 204
	local ROW = 34
	local pos = self._pointer()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local height = 10
	for _, item in ipairs(items) do
		height += item.Divider and 9 or ROW
	end
	local x = math.min(pos.X + 6, viewport.X - WIDTH * self.UserScale - 8)
	local y = math.min(pos.Y + 6, viewport.Y - height * self.UserScale - 60)

	local frame = create("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(WIDTH, height),
		BackgroundTransparency = 1,
		ZIndex = 60,
		Parent = self.Gui,
		corner(14),
	})
	local menuStroke, menuShadow = elevate(theme, frame, 28, 10)
	self.Theme:Unbind(menuStroke, "Transparency")
	menuStroke.Transparency = 1
	if menuShadow then
		self.Theme:Unbind(menuShadow, "Transparency")
		menuShadow.Transparency = 1
	end
	local menuScale = create("UIScale", { Scale = self.UserScale * 0.95, Parent = frame })
	local content = create("CanvasGroup", {
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 61,
		Parent = frame,
		pad(5),
		list({ Padding = UDim.new(0, 0) }),
	})

	for i, item in ipairs(items) do
		if item.Divider then
			local gap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 9), LayoutOrder = i, Parent = content })
			hairline(theme, gap, 8).Position = UDim2.fromOffset(8, 4)
		else
			local tone = item.Danger and "Danger" or "Text"
			local btn = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, ROW),
				LayoutOrder = i,
				Parent = content,
				corner(9),
			})
			theme:Bind(btn, { BackgroundColor3 = "HoverColor" })
			hoverFill(theme, btn, "Clear", "HoverT", "PressT")
			local left = 12
			if item.Icon then
				newIcon(theme, btn, item.Icon, item.Danger and "Danger" or "SubText", 15, {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 11, 0.5, 0),
				})
				left = 36
			end
			label(theme, {
				Text = item.Title or "",
				FontFace = Fonts.Medium,
				TextSize = 14,
				Color = tone,
				Position = UDim2.fromOffset(left, 0),
				Size = UDim2.new(1, -(left + 12), 1, 0),
				Parent = btn,
			})
			btn.MouseButton1Click:Connect(function()
				self:CloseMenu()
				fire(item.Callback)
			end)
		end
	end

	tween(menuScale, Ease.Pop, { Scale = self.UserScale })
	tween(frame, Ease.Hover, { BackgroundTransparency = 0 })
	tween(content, Ease.Hover, { GroupTransparency = 0 })
	tween(menuStroke, Ease.Hover, { Transparency = theme:Get("StrokeT") })
	if menuShadow then
		tween(menuShadow, Ease.Hover, { Transparency = theme:Get("ShadowT") })
	end
	self._menu = { Frame = frame, Scale = menuScale, Stroke = menuStroke, Shadow = menuShadow, Content = content }
end

local function modalButton(theme, parent, text, kind)
	local btn = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(0.5, -4, 1, 0),
		Parent = parent,
		corner(12),
	})
	local textKey = "Text"
	if kind == "ghost" then
		theme:Bind(btn, { BackgroundColor3 = "FieldColor" })
		hoverFill(theme, btn, "FieldT", "PressT")
	else
		theme:Bind(btn, { BackgroundColor3 = kind == "danger" and "Danger" or "Primary", BackgroundTransparency = "Opaque" })
		textKey = "PrimaryText"
		btn.MouseEnter:Connect(function()
			tween(btn, Ease.Hover, { BackgroundTransparency = 0.12 })
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, Ease.Hover, { BackgroundTransparency = 0 })
		end)
	end
	pressable(btn, 0.97)
	label(theme, {
		Text = text,
		FontFace = Fonts.Medium,
		TextSize = 14,
		Color = textKey,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = btn,
	})
	return btn
end

local function modalShell(self, opts, width)
	local theme = self.Theme
	local host = self.Card
	local tone = opts.Danger and "Danger" or "Accent"
	self._modals += 1
	self:CloseMenu()

	local dim = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 90,
		Parent = host,
		corner(RADIUS),
	})
	theme:Bind(dim, { BackgroundColor3 = "DimColor" })
	local panel = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 91,
		Parent = host,
		corner(22),
	})
	theme:Bind(panel, { BackgroundColor3 = "ModalColor" })
	local stroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = panel })
	theme:Bind(stroke, { Color = "StrokeColor" })
	local shadow = newShadow(panel, {
		BlurRadius = UDim.new(0, 60),
		Offset = UDim2.fromOffset(0, 22),
		Transparency = 1,
		ShowBehindParent = false,
	})
	if shadow then
		theme:Bind(shadow, { Color = "Shadow" })
	end
	local panelScale = create("UIScale", { Scale = 0.94, Parent = panel })
	local glowClip = create("CanvasGroup", {
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 91,
		Parent = panel,
		corner(22),
	})
	local glow = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(42, 42),
		Size = UDim2.fromOffset(8, 8),
		BackgroundTransparency = 1,
		Visible = opts.Icon ~= nil,
		Parent = glowClip,
		round(),
	})
	local glowShadow = newShadow(glow, { BlurRadius = UDim.new(0, 72), ShowBehindParent = true })
	if glowShadow then
		theme:Bind(glowShadow, { Color = tone, Transparency = "GlowT" })
	end
	local body = create("CanvasGroup", {
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 92,
		Parent = panel,
		pad(22),
		list({ Padding = UDim.new(0, 14) }),
	})

	local shell = { Theme = theme, Dim = dim, Panel = panel, Body = body, Tone = tone, Closed = false }

	function shell.Close()
		if shell.Closed then
			return
		end
		shell.Closed = true
		self._modals = math.max(0, self._modals - 1)
		if self._modals == 0 then
			self._modalHeight = nil
		end
		tween(panelScale, Ease.Hover, { Scale = 0.96 })
		tween(panel, Ease.Hover, { BackgroundTransparency = 1 })
		tween(body, Ease.Hover, { GroupTransparency = 1 })
		tween(glowClip, Ease.Hover, { GroupTransparency = 1 })
		tween(stroke, Ease.Hover, { Transparency = 1 })
		tween(dim, Ease.Hover, { BackgroundTransparency = 1 })
		if shadow then
			tween(shadow, Ease.Hover, { Transparency = 1 })
		end
		task.delay(0.2, function()
			dim:Destroy()
			panel:Destroy()
		end)
	end

	function shell.Tile(parent, props)
		local tile = create("Frame", { Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 0.86, corner(13) })
		for key, value in pairs(props or {}) do
			tile[key] = value
		end
		tile.Parent = parent
		theme:Bind(tile, { BackgroundColor3 = tone })
		newIcon(theme, tile, opts.Icon, opts.Danger and "Danger" or "Text", 19, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
		})
		return tile
	end

	function shell.Input(parent, order, placeholder, default)
		local box = create("Frame", { Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order, Parent = parent, corner(12) })
		theme:Bind(box, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
		local boxStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = box })
		theme:Bind(boxStroke, { Color = "Accent" })
		local input = label(theme, {
			Class = "TextBox",
			Text = default or "",
			PlaceholderText = placeholder or "",
			ClearTextOnFocus = false,
			TextSize = 15,
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -28, 1, 0),
			TextTruncate = Enum.TextTruncate.None,
			ClipsDescendants = true,
			Parent = box,
		})
		smoothBox(self, input)
		return input, boxStroke
	end

	dim.MouseButton1Click:Connect(function()
		shell.Close()
	end)

	tween(panelScale, Ease.Pop, { Scale = 1 })
	tween(panel, Ease.Hover, { BackgroundTransparency = 0 })
	tween(body, Ease.Smooth, { GroupTransparency = 0 })
	tween(glowClip, Ease.Slow, { GroupTransparency = 0 })
	tween(stroke, Ease.Smooth, { Transparency = theme:Get("StrokeT") })
	tween(dim, Ease.Smooth, { BackgroundTransparency = theme:Get("DimT") })
	if shadow then
		tween(shadow, Ease.Smooth, { Transparency = theme:Get("ShadowT") })
	end
	return shell
end

function Window:_modal(opts, withInput)
	opts = opts or {}
	local theme = self.Theme
	local shell = modalShell(self, opts, 332)
	local body = shell.Body

	local head = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = body,
		list({ Padding = UDim.new(0, 6) }),
	})
	if opts.Icon then
		shell.Tile(head, { LayoutOrder = 0 })
		create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 4), LayoutOrder = 1, Parent = head })
	end
	label(theme, {
		Text = opts.Title or "Enter",
		FontFace = Fonts.SemiBold,
		TextSize = 18,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 2,
		Parent = head,
	})
	if opts.Description and opts.Description ~= "" then
		label(theme, {
			Text = opts.Description,
			TextSize = 14,
			Color = "SubText",
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 3,
			Parent = head,
		})
	end

	local input, inputStroke
	if withInput then
		input, inputStroke = shell.Input(body, 2, opts.Placeholder, opts.Default)
		input.Focused:Connect(function()
			tween(inputStroke, Ease.Hover, { Transparency = theme:Get("FocusT") })
		end)
		input.FocusLost:Connect(function()
			tween(inputStroke, Ease.Hover, { Transparency = 1 })
		end)
	end

	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = 3, Parent = body })
	local cancel = modalButton(theme, row, opts.Cancel or "Cancel", "ghost")
	local ok = modalButton(theme, row, opts.Action or "OK", opts.Danger and "danger" or "primary")
	ok.Position = UDim2.new(0.5, 4, 0, 0)

	local function finish(value, confirmed)
		if shell.Closed then
			return
		end
		shell.Close()
		if confirmed and opts.Callback then
			fire(opts.Callback, value)
		end
	end
	cancel.MouseButton1Click:Connect(function()
		finish(nil, false)
	end)
	ok.MouseButton1Click:Connect(function()
		finish(input and input.Text or true, true)
	end)
	if input then
		input.FocusLost:Connect(function(enter)
			if enter then
				finish(input.Text, true)
			end
		end)
		task.defer(function()
			if not shell.Closed then
				input:CaptureFocus()
				input.CursorPosition = #input.Text + 1
			end
		end)
	end
	return function()
		finish(nil, false)
	end
end

function Window:Prompt(opts)
	return self:_modal(opts, true)
end

function Window:Confirm(opts)
	return self:_modal(opts, false)
end

function Window:Wizard(opts)
	opts = opts or {}
	local theme = self.Theme
	local steps = opts.Pages or {}
	local total = math.max(#steps, 1)
	local tone = opts.Danger and "Danger" or "Primary"
	local shell = modalShell(self, opts, 352)
	self._modalHeight = 500
	local body = shell.Body

	local top = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, Parent = body })
	if opts.Icon then
		shell.Tile(top)
	end
	local closeBtn = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 6, 0, -6),
		Size = UDim2.fromOffset(30, 30),
		Parent = top,
		round(),
	})
	theme:Bind(closeBtn, { BackgroundColor3 = "HoverColor" })
	hoverFill(theme, closeBtn, "Clear", "HoverT", "PressT")
	newIcon(theme, closeBtn, "x", "Muted", 14, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	})

	local stage = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 150),
		ClipsDescendants = true,
		LayoutOrder = 2,
		Parent = body,
	})

	local index = 1
	local opened = false
	local phraseOk = {}
	local views = {}
	local confirmBtn, confirmLabel

	local function ready()
		for i, step in ipairs(steps) do
			if step.Phrase and not phraseOk[i] then
				return false
			end
		end
		return index == total
	end

	local function refreshConfirm()
		if not confirmBtn then
			return
		end
		local ok = ready()
		theme:Set(confirmBtn, "BackgroundColor3", ok and tone or "FieldColor", Ease.Hover)
		theme:Set(confirmBtn, "BackgroundTransparency", ok and "Opaque" or "FieldT", Ease.Hover)
		theme:Set(confirmLabel, "TextColor3", ok and "PrimaryText" or "Muted", Ease.Hover)
	end

	local function finish(confirmed)
		if shell.Closed then
			return
		end
		shell.Close()
		if confirmed and opts.Callback then
			fire(opts.Callback)
		end
	end

	for i, step in ipairs(steps) do
		local view = create("CanvasGroup", {
			BackgroundTransparency = 1,
			GroupTransparency = i == 1 and 0 or 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = i == 1,
			Parent = stage,
			list({ Padding = UDim.new(0, 10) }),
		})
		views[i] = view
		label(theme, {
			Text = step.Title or opts.Title or "",
			FontFace = Fonts.SemiBold,
			TextSize = 18,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = 1,
			Parent = view,
		})
		label(theme, {
			Text = step.Body or "",
			TextSize = 14,
			Color = "SubText",
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			Parent = view,
		})
		if step.Points and #step.Points > 0 then
			create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 3, Parent = view })
			local group = create("Frame", {
				Size = UDim2.new(1, 0, 0, #step.Points * 38),
				LayoutOrder = 4,
				Parent = view,
				corner(14),
			})
			theme:Bind(group, { BackgroundColor3 = "GroupColor", BackgroundTransparency = "GroupT" })
			for n, point in ipairs(step.Points) do
				local row = create("Frame", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(0, (n - 1) * 38),
					Size = UDim2.new(1, 0, 0, 38),
					Parent = group,
				})
				if n > 1 then
					hairline(theme, row, 14)
				end
				newIcon(theme, row, step.PointIcon or "x", opts.Danger and "Danger" or "SubText", 13, {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 14, 0.5, 0),
				})
				label(theme, {
					Text = point,
					TextSize = 14,
					Position = UDim2.fromOffset(38, 0),
					Size = UDim2.new(1, -52, 1, 0),
					Parent = row,
				})
			end
		end
		if step.Phrase then
			create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 5, Parent = view })
			local sample = create("Frame", { Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 6, Parent = view, corner(12) })
			theme:Bind(sample, { BackgroundColor3 = "GroupColor", BackgroundTransparency = "GroupT" })
			label(theme, {
				Text = "Type",
				TextSize = 12,
				Color = "Muted",
				Position = UDim2.fromOffset(14, 0),
				Size = UDim2.fromOffset(40, 42),
				Parent = sample,
			})
			label(theme, {
				Text = step.Phrase,
				FontFace = Fonts.SemiBold,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.fromOffset(54, 0),
				Size = UDim2.new(1, -68, 1, 0),
				Parent = sample,
			})
			local input, inputStroke = shell.Input(view, 7, step.Placeholder or "Type the phrase here")
			input.Focused:Connect(function()
				tween(inputStroke, Ease.Hover, { Transparency = theme:Get("FocusT") })
			end)
			input.FocusLost:Connect(function()
				tween(inputStroke, Ease.Hover, { Transparency = phraseOk[i] and theme:Get("FocusT") or 1 })
			end)
			input:GetPropertyChangedSignal("Text"):Connect(function()
				phraseOk[i] = input.Text == step.Phrase
				theme:Set(inputStroke, "Color", phraseOk[i] and "Safe" or "Accent", Ease.Hover)
				refreshConfirm()
			end)
			step._input = input
		end
		if i == total then
			confirmBtn = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 42),
				LayoutOrder = 9,
				Parent = view,
				corner(12),
			})
			theme:Bind(confirmBtn, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
			pressable(confirmBtn, 0.98)
			confirmLabel = label(theme, {
				Text = opts.Action or "Confirm",
				FontFace = Fonts.SemiBold,
				TextSize = 14,
				Color = "Muted",
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = confirmBtn,
			})
			confirmBtn.MouseButton1Click:Connect(function()
				if ready() then
					finish(true)
				end
			end)
		end
	end

	local footer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 3, Parent = body })
	local function navButton(iconName, offset)
		local btn = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, offset, 0.5, 0),
			Size = UDim2.fromOffset(32, 32),
			Parent = footer,
			round(),
		})
		theme:Bind(btn, { BackgroundColor3 = "FieldColor" })
		hoverFill(theme, btn, "FieldT", "PressT")
		pressable(btn, 0.92)
		local icon = newIcon(theme, btn, iconName, "Text", 14, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
		})
		return btn, icon
	end
	local prevBtn, prevIcon = navButton("chevron-left", -50)
	local nextBtn, nextIcon = navButton("chevron-right", 50)
	local counter = label(theme, {
		Text = "1 / " .. total,
		FontFace = Fonts.Medium,
		TextSize = 13,
		Color = "SubText",
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = footer,
	})

	local function fit()
		local view = views[index]
		if not view or shell.Closed then
			return
		end
		local s = self.Scale.Scale > 0 and self.Scale.Scale or 1
		local goal = UDim2.new(1, 0, 0, math.max(40, view.AbsoluteSize.Y / s))
		if opened then
			tween(stage, Ease.Smooth, { Size = goal })
		else
			stage.Size = goal
		end
	end
	for i, view in ipairs(views) do
		view:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if i == index then
				fit()
			end
		end)
	end

	local function show(target)
		target = math.clamp(target, 1, total)
		local dir = target >= index and 1 or -1
		local old = views[index]
		local fresh = views[target]
		if target ~= index and old and fresh then
			tween(old, Ease.Hover, { GroupTransparency = 1, Position = UDim2.fromOffset(-24 * dir, 0) })
			task.delay(0.18, function()
				if old.Parent and views[index] ~= old then
					old.Visible = false
				end
			end)
			fresh.Visible = true
			fresh.Position = UDim2.fromOffset(24 * dir, 0)
			fresh.GroupTransparency = 1
			tween(fresh, Ease.Smooth, { GroupTransparency = 0, Position = UDim2.new() })
		end
		index = target
		counter.Text = index .. " / " .. total
		prevIcon:SetColor(index > 1 and "Text" or "Muted", Ease.Hover)
		nextIcon:SetColor(index < total and "Text" or "Muted", Ease.Hover)
		refreshConfirm()
		task.defer(fit)
		local step = steps[index]
		if step and step._input then
			task.delay(0.2, function()
				if not shell.Closed and index == target then
					step._input:CaptureFocus()
				end
			end)
		end
	end

	prevBtn.MouseButton1Click:Connect(function()
		if index > 1 then
			show(index - 1)
		end
	end)
	nextBtn.MouseButton1Click:Connect(function()
		if index < total then
			show(index + 1)
		end
	end)
	closeBtn.MouseButton1Click:Connect(function()
		finish(false)
	end)

	show(1)
	task.delay(0.35, function()
		opened = true
	end)
	return function()
		finish(false)
	end
end

