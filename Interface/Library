function Section:Toggle(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local row, right = self:_row(opts, 40)
	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(40, 24),
		Parent = right,
		round(),
	})
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		Parent = track,
		round(),
	})

	local obj = { Value = false }
	local function render(animated)
		local on = obj.Value
		local info = animated and Ease.Smooth or nil
		theme:Set(track, "BackgroundColor3", on and "Primary" or "TrackColor", info)
		theme:Set(track, "BackgroundTransparency", on and "Opaque" or "TrackT", info)
		theme:Set(knob, "BackgroundColor3", on and "PrimaryText" or "Knob", info)
		local goal = { Position = on and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(18, 18) }
		if animated then
			tween(knob, Ease.Smooth, goal)
		else
			knob.Position, knob.Size = goal.Position, goal.Size
		end
	end
	function obj:Set(value, silent)
		value = value and true or false
		local changed = value ~= self.Value
		self.Value = value
		render(true)
		if changed and not silent then
			fire(opts.Callback, value)
		end
	end
	function obj:Get()
		return self.Value
	end

	row.MouseButton1Down:Connect(function()
		tween(knob, Ease.Quick, {
			Size = UDim2.fromOffset(22, 18),
			Position = obj.Value and UDim2.new(0, 15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		})
	end)
	row.MouseLeave:Connect(function()
		render(true)
	end)
	row.MouseButton1Click:Connect(function()
		obj:Set(not obj.Value)
	end)

	obj.Value = opts.Default == true
	render(false)
	return finish(obj, row)
end

local function field(theme, parent, opts, height, radius)
	local frame = create("Frame", { Size = UDim2.new(1, 0, 0, height), Parent = parent, corner(radius) })
	theme:Bind(frame, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
	local focus = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = frame })
	theme:Bind(focus, { Color = "StrokeColor" })
	return frame, focus
end

local function focusStyle(theme, stroke, active)
	if active then
		theme:Set(stroke, "Transparency", "FocusT", Ease.Hover)
	else
		theme:Unbind(stroke, "Transparency")
		tween(stroke, Ease.Hover, { Transparency = 1 })
	end
end

function Section:Input(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local row, right = self:_row(opts, opts.Width or 200)
	local frame, focus = field(theme, right, opts, 32, 10)
	frame.Size = UDim2.fromScale(1, 1)
	local box = label(theme, {
		Class = "TextBox",
		Text = opts.Default or "",
		PlaceholderText = opts.Placeholder or "",
		ClearTextOnFocus = false,
		TextSize = 14,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, opts.Secret and -46 or -24, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = frame,
	})
	theme:Bind(box, { PlaceholderColor3 = "Muted" })
	local secret
	if opts.Secret then
		secret = secretControl(theme, box, frame, 2)
	end

	local obj = { Value = box.Text, Box = box }
	function obj:Set(value, silent)
		box.Text = tostring(value or "")
		self.Value = box.Text
		if not silent then
			fire(opts.Callback, self.Value)
		end
	end
	function obj:Get()
		return box.Text
	end
	function obj:Focus()
		box:CaptureFocus()
	end

	box.Focused:Connect(function()
		focusStyle(theme, focus, true)
	end)
	box.FocusLost:Connect(function(enter)
		focusStyle(theme, focus, false)
		if secret then
			secret:Hide()
		end
		obj.Value = box.Text
		if enter or not opts.EnterOnly then
			fire(opts.Callback, box.Text)
		end
	end)
	row.MouseButton1Click:Connect(function()
		box:CaptureFocus()
	end)
	return finish(obj, row)
end

function Section:Keybind(opts)
	opts = opts or {}
	local window = self.Window
	local theme = window.Theme
	local row, right = self:_row(opts, 130)
	local pill = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 0, 0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = right,
		corner(9),
		pad(0, 12, 0, 12),
		create("UISizeConstraint", { MinSize = Vector2.new(56, 30) }),
	})
	theme:Bind(pill, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
	local pillStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = pill })
	theme:Bind(pillStroke, { Color = "StrokeColor" })
	local text = label(theme, {
		Text = "",
		FontFace = Fonts.Medium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Parent = pill,
	})

	local obj = { Value = opts.Default }
	local listening = false
	local function display()
		text.Text = listening and "Press a key" or keyName(obj.Value)
		theme:Set(text, "TextColor3", listening and "SubText" or "Text")
	end
	function obj:Set(key, silent)
		self.Value = key
		display()
		if not silent then
			fire(opts.Callback, key)
		end
	end
	function obj:Get()
		return self.Value
	end

	local function start()
		if listening then
			return
		end
		listening = true
		display()
		focusStyle(theme, pillStroke, true)
		window._capture = function(key)
			listening = false
			focusStyle(theme, pillStroke, false)
			if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Unknown then
				display()
				return
			end
			obj:Set(key)
		end
	end
	pill.MouseButton1Click:Connect(start)
	row.MouseButton1Click:Connect(start)

	display()
	return finish(obj, row)
end

local function segmented(theme, parent, options, default, callback, height)
	local radius = height >= 36 and 12 or 10
	local frame = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		Parent = parent,
		corner(radius),
		pad(3),
	})
	theme:Bind(frame, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
	local count = math.max(#options, 1)
	local indicator = create("Frame", {
		Size = UDim2.fromScale(1 / count, 1),
		ZIndex = 1,
		Parent = frame,
		corner(radius - 3),
	})
	theme:Bind(indicator, { BackgroundColor3 = "IndicatorColor", BackgroundTransparency = "IndicatorT" })
	local indicatorShadow = newShadow(indicator, {
		BlurRadius = UDim.new(0, 6),
		Offset = UDim2.fromOffset(0, 1),
		Transparency = 0.9,
		ShowBehindParent = false,
	})
	if indicatorShadow then
		theme:Bind(indicatorShadow, { Color = "Shadow" })
	end

	local obj = { Value = nil, Frame = frame }
	local labels = {}
	for i, option in ipairs(options) do
		local btn = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Position = UDim2.fromScale((i - 1) / count, 0),
			Size = UDim2.fromScale(1 / count, 1),
			ZIndex = 2,
			Parent = frame,
		})
		labels[option] = label(theme, {
			Text = tostring(option),
			FontFace = Fonts.Medium,
			TextSize = height >= 36 and 14 or 13,
			Color = "Muted",
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = btn,
		})
		btn.MouseEnter:Connect(function()
			if obj.Value ~= option then
				theme:Set(labels[option], "TextColor3", "SubText", Ease.Hover)
			end
		end)
		btn.MouseLeave:Connect(function()
			if obj.Value ~= option then
				theme:Set(labels[option], "TextColor3", "Muted", Ease.Hover)
			end
		end)
		btn.MouseButton1Click:Connect(function()
			obj:Set(option)
		end)
	end
	function obj:Set(value, silent, instant)
		local index = table.find(options, value)
		if not index then
			return
		end
		local changed = value ~= self.Value
		if self.Value ~= nil and labels[self.Value] and self.Value ~= value then
			theme:Set(labels[self.Value], "TextColor3", "Muted", Ease.Hover)
		end
		self.Value = value
		theme:Set(labels[value], "TextColor3", "Text", if instant then nil else Ease.Hover)
		local goal = UDim2.fromScale((index - 1) / count, 0)
		if instant then
			indicator.Position = goal
		else
			tween(indicator, Ease.Smooth, { Position = goal })
		end
		if changed and not silent then
			fire(callback, value)
		end
	end
	function obj:Get()
		return self.Value
	end
	obj:Set(default or options[1], true, true)
	return obj
end

