local function maskBox(theme, box)
	box.TextTransparency = 1
	local mask = label(theme, {
		Text = "",
		TextSize = box.TextSize,
		FontFace = box.FontFace,
		TextXAlignment = box.TextXAlignment,
		TextTruncate = Enum.TextTruncate.None,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		Parent = box,
	})
	local function update()
		if box.Text == "" then
			mask.Text = box.PlaceholderText
			theme:Set(mask, "TextColor3", "Muted")
		else
			mask.Text = string.rep("•", utf8.len(box.Text) or #box.Text)
			theme:Set(mask, "TextColor3", "Text")
		end
	end
	box:GetPropertyChangedSignal("Text"):Connect(update)
	box:GetPropertyChangedSignal("PlaceholderText"):Connect(update)
	update()
	return mask
end

local function eyeButton(theme, parent, props)
	local btn = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(28, 28),
		ZIndex = 3,
		Parent = parent,
		round(),
	})
	for key, value in pairs(props or {}) do
		btn[key] = value
	end
	theme:Bind(btn, { BackgroundColor3 = "HoverColor" })
	local lid = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(15, 9),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = btn,
		round(),
	})
	local lidStroke = create("UIStroke", { Thickness = 1.5, Parent = lid })
	theme:Bind(lidStroke, { Color = "Muted" })
	local pupil = bar(theme, btn, "Muted", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(4, 4), 0)
	local slash = bar(theme, btn, "Muted", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(19, 1.5), -38)
	pupil.ZIndex = 3
	slash.ZIndex = 4
	local parts = { { lidStroke, "Color" }, { pupil, "BackgroundColor3" }, { slash, "BackgroundColor3" } }
	btn.MouseEnter:Connect(function()
		tween(btn, Ease.Hover, { BackgroundTransparency = theme:Get("HoverT") - 0.02 })
		for _, part in ipairs(parts) do
			theme:Set(part[1], part[2], "Text", Ease.Hover)
		end
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, Ease.Hover, { BackgroundTransparency = 1 })
		for _, part in ipairs(parts) do
			theme:Set(part[1], part[2], "Muted", Ease.Hover)
		end
	end)
	return btn, slash
end

local function secretControl(theme, box, holder, rightOffset)
	local control = { Hidden = true }
	local mask = maskBox(theme, box)
	local eye, slash = eyeButton(theme, holder, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -rightOffset, 0.5, 0),
	})
	local function apply()
		mask.Visible = control.Hidden
		box.TextTransparency = control.Hidden and 1 or 0
		slash.Visible = not control.Hidden
	end
	eye.MouseButton1Click:Connect(function()
		control.Hidden = not control.Hidden
		apply()
	end)
	function control:Hide()
		self.Hidden = true
		apply()
	end
	function control:Destroy()
		mask:Destroy()
		eye:Destroy()
		box.TextTransparency = 0
	end
	apply()
	return control
end

