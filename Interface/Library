local function newIcon(theme, parent, name, colorKey, size, props, fallback)
	size = size or 18
	local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size) })
	for key, value in pairs(props or {}) do
		holder[key] = value
	end
	holder.Parent = parent

	local obj = { Frame = holder, Key = colorKey or "Text", Name = nil }
	local parts = {}
	local custom
	local token = 0

	local function paint(info)
		for _, part in ipairs(parts) do
			local inst, prop = part[1], part[2]
			if custom then
				theme:Unbind(inst, prop)
				if info then
					tween(inst, info, { [prop] = custom })
				else
					inst[prop] = custom
				end
			else
				theme:Set(inst, prop, obj.Key, info)
			end
		end
	end

	local function reg(inst, prop)
		table.insert(parts, { inst, prop })
	end

	local function drawGlyph(glyphName)
		local u = size / 24
		local th = math.max(1.4, 1.6 * u)
		local kit = {}
		function kit.bar(x, y, w, rot, h)
			local f = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x * u, y * u),
				Size = UDim2.fromOffset(w * u, h and h * u or th),
				Rotation = rot or 0,
				BorderSizePixel = 0,
				Parent = holder,
				round(),
			})
			reg(f, "BackgroundColor3")
		end
		function kit.dot(x, y, d)
			local f = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x * u, y * u),
				Size = UDim2.fromOffset(d * u, d * u),
				BorderSizePixel = 0,
				Parent = holder,
				round(),
			})
			reg(f, "BackgroundColor3")
		end
		function kit.box(x, y, w, h, r)
			local f = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x * u, y * u),
				Size = UDim2.fromOffset(w * u - th, h * u - th),
				BackgroundTransparency = 1,
				Parent = holder,
				corner(math.max(1, r * u)),
			})
			reg(create("UIStroke", { Thickness = th, Parent = f }), "Color")
		end
		function kit.ring(x, y, d)
			local f = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x * u, y * u),
				Size = UDim2.fromOffset(d * u - th, d * u - th),
				BackgroundTransparency = 1,
				Parent = holder,
				round(),
			})
			reg(create("UIStroke", { Thickness = th, Parent = f }), "Color")
		end
		local draw = GLYPHS[glyphName]
		if draw then
			draw(kit)
		else
			kit.ring(12, 12, 13)
			kit.dot(12, 12, 3.5)
		end
	end

	function obj:Set(newName, fallback)
		token += 1
		local mine = token
		self.Name = newName
		for _, child in ipairs(holder:GetChildren()) do
			child:Destroy()
		end
		table.clear(parts)
		local content = type(newName) == "string" and iconContent(newName) or nil
		if content then
			local img = create("ImageLabel", {
				Image = content,
				BackgroundTransparency = 1,
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromScale(1, 1),
				Parent = holder,
			})
			reg(img, "ImageColor3")
		else
			local shown = newName
			if not GLYPHS[shown] and fallback then
				shown = fallback
				if iconContent(fallback) then
					local img = create("ImageLabel", {
						Image = iconContent(fallback),
						BackgroundTransparency = 1,
						ScaleType = Enum.ScaleType.Fit,
						Size = UDim2.fromScale(1, 1),
						Parent = holder,
					})
					reg(img, "ImageColor3")
					shown = nil
				else
					requestIcon(fallback, function()
						if mine == token and holder.Parent and not iconContent(newName) then
							obj:Set(newName, fallback)
						end
					end)
				end
			end
			if shown then
				drawGlyph(shown)
			end
			requestIcon(newName, function()
				if mine == token and holder.Parent then
					obj:Set(newName, fallback)
				end
			end)
		end
		paint(nil)
	end

	function obj:SetColor(value, info)
		if typeof(value) == "Color3" then
			custom = value
		else
			custom = nil
			self.Key = value
		end
		paint(info)
	end

	obj:Set(name, fallback)
	return obj
end

local CHAR_IN = TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local CHAR_TINT = TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local CHAR_OUT = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local CHAR_FLOW = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local CARET_BLINK = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 0.3)

local measureCache = {}
local measureCount = 0

local function measure(text, size)
	if text == "" then
		return 0
	end
	local key = size .. "|" .. text
	local cached = measureCache[key]
	if cached then
		return cached
	end
	local function width(value)
		local ok, bounds = pcall(function()
			return TextService:GetTextSize(value, size, Enum.Font.BuilderSans, Vector2.new(100000, 200))
		end)
		if ok and bounds then
			return bounds.X
		end
		return (utf8.len(value) or #value) * size * 0.52
	end
	local result = width(text .. "|") - width("|")
	measureCount += 1
	if measureCount > 6000 then
		table.clear(measureCache)
		measureCount = 0
	end
	measureCache[key] = result
	return result
end

local smoothOf = setmetatable({}, { __mode = "k" })

-- animated single-line text: the TextBox stays as the invisible input and every glyph is its own
-- cell in a list layout, so spacing comes from the engine instead of measured widths
local function smoothBox(window, box)
	local theme = window.Theme
	local size = box.TextSize
	local space = math.max(2, math.floor(size * 0.27 + 0.5))
	box.TextTransparency = 1
	box.ClipsDescendants = true

	local placeholder = label(theme, {
		Text = box.PlaceholderText,
		TextSize = size,
		FontFace = box.FontFace,
		Color = "Muted",
		Size = UDim2.fromScale(1, 1),
		Parent = box,
	})
	local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = box })
	local selection = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, size + 6),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.78,
		Visible = false,
		Parent = holder,
		corner(3),
	})
	theme:Bind(selection, { BackgroundColor3 = "Accent" })
	local row = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = holder,
		list({ FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center }),
	})
	local caret = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(2, size + 5),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = holder,
		round(),
	})
	theme:Bind(caret, { BackgroundColor3 = "Accent" })

	local chars = {}
	local masked = false
	local focused = false
	local offset = 0
	local api = {}

	local function isBlank(char)
		return not masked and char:match("^%s$") ~= nil
	end

	local function shape(entry)
		local blank = isBlank(entry.Char)
		entry.Cell.AutomaticSize = blank and Enum.AutomaticSize.None or Enum.AutomaticSize.X
		entry.Cell.Size = UDim2.new(0, blank and space or 0, 1, 0)
		entry.Glyph.Text = masked and "•" or entry.Char
	end

	local function makeEntry(char)
		local cell = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), Parent = row })
		local glyph = label(theme, {
			Text = "",
			TextSize = size,
			FontFace = box.FontFace,
			TextTruncate = Enum.TextTruncate.None,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			Parent = cell,
		})
		local entry = { Char = char, Cell = cell, Glyph = glyph }
		shape(entry)
		return entry
	end

	local function unscale()
		return window.Scale.Scale > 0 and window.Scale.Scale or 1
	end

	local function edgeX(index)
		local entry = chars[index]
		if not entry then
			return 0
		end
		local cell = entry.Cell
		return (cell.AbsolutePosition.X + cell.AbsoluteSize.X - row.AbsolutePosition.X) / unscale()
	end

	local function charsBefore(bytePos)
		if not bytePos or bytePos < 1 then
			return #chars
		end
		local ok, count = pcall(utf8.len, box.Text, 1, bytePos - 1)
		return math.clamp(ok and count or #chars, 0, #chars)
	end

	local caretX = 0
	local caretGoal = -1
	local clock = 0

	-- runs every frame while focused, so the caret always follows the laid-out glyphs
	local function step(dt)
		local x = edgeX(charsBefore(box.CursorPosition))
		local total = edgeX(#chars)
		local view = math.max(10, box.AbsoluteSize.X / unscale())
		if x + offset > view - 2 then
			offset = view - 2 - x
		elseif x + offset < 0 then
			offset = -x
		end
		offset = math.clamp(offset, math.min(0, view - total - 4), 0)
		holder.Position = UDim2.fromOffset(math.floor(offset + 0.5), 0)
		if math.abs(x - caretGoal) > 0.01 then
			caretGoal = x
			clock = 0
		end
		clock += dt
		-- the caret trails its target and stretches towards it while it travels
		caretX += (x - caretX) * damp(15, dt)
		local gap = x - caretX
		if math.abs(gap) < 0.15 then
			caretX = x
			gap = 0
		end
		local stretch = math.min(math.abs(gap) * 0.45, 14)
		caret.Size = UDim2.fromOffset(2 + stretch, size + 5 - math.min(stretch * 0.25, 3))
		caret.Position = UDim2.new(0, gap >= 0 and caretX or caretX - stretch, 0.5, 0)
		local goal = 0
		if clock > 0.55 then
			goal = 0.5 - 0.5 * math.cos((clock - 0.55) * 5.2)
		end
		if not focused then
			goal = 1
		end
		caret.BackgroundTransparency += (goal * 0.9 - caret.BackgroundTransparency) * damp(20, dt)

		local start = -1
		pcall(function()
			start = box.SelectionStart
		end)
		local cursor = box.CursorPosition
		if focused and start and start ~= -1 and cursor ~= -1 and start ~= cursor then
			local x1 = edgeX(charsBefore(math.min(start, cursor)))
			local x2 = edgeX(charsBefore(math.max(start, cursor)))
			selection.Visible = true
			selection.Position = UDim2.new(0, x1, 0.5, 0)
			selection.Size = UDim2.fromOffset(math.max(0, x2 - x1), size + 6)
		else
			selection.Visible = false
		end
	end

	local stepper
	local function watch(on)
		if stepper then
			stepper:Disconnect()
			stepper = nil
		end
		if on then
			stepper = RunService.RenderStepped:Connect(function(dt)
				step(math.min(dt, 0.1))
			end)
		else
			caret.BackgroundTransparency = 1
			selection.Visible = false
		end
	end

	local function update(instant)
		local fresh = {}
		for _, code in utf8.codes(box.Text) do
			table.insert(fresh, utf8.char(code))
		end
		local oldLen, newLen = #chars, #fresh
		local prefix = 0
		while prefix < oldLen and prefix < newLen and chars[prefix + 1].Char == fresh[prefix + 1] do
			prefix += 1
		end
		local suffix = 0
		while suffix < oldLen - prefix and suffix < newLen - prefix and chars[oldLen - suffix].Char == fresh[newLen - suffix] do
			suffix += 1
		end
		local removed = oldLen - prefix - suffix
		local added = newLen - prefix - suffix
		local animate = not instant and removed <= 24 and added <= 24
		local result = table.create(newLen)
		for i = 1, prefix do
			result[i] = chars[i]
		end
		for i = prefix + 1, oldLen - suffix do
			local entry = chars[i]
			if animate then
				local cell = entry.Cell
				local width = cell.AbsoluteSize.X / unscale()
				cell.LayoutOrder = i * 2 - 1
				cell.AutomaticSize = Enum.AutomaticSize.None
				cell.Size = UDim2.new(0, width, 1, 0)
				tween(cell, CHAR_OUT, { Size = UDim2.new(0, 0, 1, 0) })
				tween(entry.Glyph, CHAR_OUT, { TextTransparency = 1, Position = UDim2.fromOffset(0, 7) })
				task.delay(0.17, function()
					cell:Destroy()
				end)
			else
				entry.Cell:Destroy()
			end
		end
		for i = prefix + 1, newLen - suffix do
			local entry = makeEntry(fresh[i])
			if animate then
				local glyph = entry.Glyph
				glyph.Position = UDim2.fromOffset(0, 9)
				glyph.TextTransparency = 1
				theme:Unbind(glyph, "TextColor3")
				glyph.TextColor3 = theme:Get("Accent")
				local function play()
					if glyph.Parent then
						tween(glyph, CHAR_IN, { Position = UDim2.new(), TextTransparency = 0 })
						theme:Set(glyph, "TextColor3", "Text", CHAR_TINT)
					end
				end
				-- pasted text rolls in as a short wave
				local wait = math.min((i - prefix - 1) * 0.014, 0.3)
				if wait > 0 then
					task.delay(wait, play)
				else
					play()
				end
			end
			result[i] = entry
		end
		for i = 0, suffix - 1 do
			result[newLen - i] = chars[oldLen - i]
		end
		chars = result
		for i, entry in ipairs(chars) do
			entry.Cell.LayoutOrder = i * 2
		end
		placeholder.Visible = newLen == 0
	end

	function api.SetMasked(value)
		value = value and true or false
		if masked == value then
			return
		end
		masked = value
		for _, entry in ipairs(chars) do
			shape(entry)
		end
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if not pcall(update, false) then
			pcall(update, true)
		end
	end)
	-- the native placeholder would show through, so it is moved into the overlay label
	local function takePlaceholder()
		if box.PlaceholderText ~= "" then
			placeholder.Text = box.PlaceholderText
			box.PlaceholderText = ""
		end
	end
	box:GetPropertyChangedSignal("PlaceholderText"):Connect(takePlaceholder)
	takePlaceholder()
	box.Focused:Connect(function()
		focused = true
		caretX = edgeX(charsBefore(box.CursorPosition))
		watch(true)
	end)
	box.FocusLost:Connect(function()
		focused = false
		watch(false)
	end)
	box.Destroying:Connect(function()
		watch(false)
	end)

	update(true)
	smoothOf[box] = api
	return api
end

