	local function pillButton(parent, order, iconName, text, primary, tip)
		local btn = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.new(0, text and 0 or 34, 1, 0),
			AutomaticSize = text and Enum.AutomaticSize.X or Enum.AutomaticSize.None,
			LayoutOrder = order,
			ZIndex = 31,
			Parent = parent,
			round(),
		})
