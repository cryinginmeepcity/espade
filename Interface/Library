local function tween(obj, info, goal)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

local function create(class, props)
	local inst = Instance.new(class)
	local parent
	for key, value in pairs(props or {}) do
		if type(key) == "number" then
			value.Parent = inst
		elseif key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function round()
	return create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

local function pad(t, r, b, l)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t),
		PaddingLeft = UDim.new(0, l or r or t),
	})
end

local function list(props)
	props = props or {}
	props.SortOrder = Enum.SortOrder.LayoutOrder
	return create("UIListLayout", props)
end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function damp(rate, dt)
	return 1 - math.exp(-rate * dt)
end

local function commas(n)
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end
Isle.Format = commas

local function isPress(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

local function isMove(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch
end

local function fire(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(fn, table.unpack(args, 1, args.n))
		if not ok then
			warn("[Isle] " .. tostring(err))
		end
	end)
end

local function newShadow(parent, props)
	if Isle.Shadows == false then
		return nil
	end
	local ok, inst = pcall(Instance.new, "UIShadow")
	if not ok or not inst then
		return nil
	end
	for key, value in pairs(props) do
		pcall(function()
			inst[key] = value
		end)
	end
	inst.Parent = parent
	return inst
end

local function mount(gui)
	local ok = false
	if type(gethui) == "function" then
		ok = pcall(function()
			gui.Parent = gethui()
		end)
	end
	if not ok then
		ok = pcall(function()
			gui.Parent = game:GetService("CoreGui")
		end)
	end
	if not ok or not gui.Parent then
		gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
end

local function textWidth(value, font, size)
	local params = Instance.new("GetTextBoundsParams")
	params.Text = value
	params.Font = font
	params.Size = size
	params.Width = 10000
	local ok, bounds = pcall(TextService.GetTextBoundsAsync, TextService, params)
	if ok and bounds then
		return bounds.X
	end
	return #value * size * 0.5
end

local function estimate(value, size)
	local length = utf8.len(value) or #value
	return math.ceil(length * size * 0.56)
end

local Theme = {}
Theme.__index = Theme

function Theme.new(name)
	return setmetatable({ Name = name, Registry = {}, Listeners = {} }, Theme)
end

function Theme:Get(key)
	local value = Themes[self.Name][key]
	if value == nil then
		error("[Isle] unknown theme key " .. tostring(key), 2)
	end
	return value
end

function Theme:_track()
	self._count = (self._count or 0) + 1
	if self._count < 800 or self._sweeping then
		return
	end
	self._sweeping = true
	task.delay(1, function()
		self._sweeping = false
		self._count = 0
		for inst in pairs(self.Registry) do
			if inst.Parent == nil then
				self.Registry[inst] = nil
			end
		end
	end)
end

function Theme:Bind(inst, map)
	local entry = self.Registry[inst]
	if not entry then
		entry = {}
		self.Registry[inst] = entry
		self:_track()
	end
	for prop, key in pairs(map) do
		entry[prop] = key
		inst[prop] = self:Get(key)
	end
	return inst
end

function Theme:Set(inst, prop, key, info)
	local entry = self.Registry[inst]
	if not entry then
		entry = {}
		self.Registry[inst] = entry
		self:_track()
	end
	entry[prop] = key
	if info then
		tween(inst, info, { [prop] = self:Get(key) })
	else
		inst[prop] = self:Get(key)
	end
end

function Theme:Unbind(inst, prop)
	local entry = self.Registry[inst]
	if entry then
		entry[prop] = nil
	end
end

function Theme:Apply(animated)
	for inst, entry in pairs(self.Registry) do
		if inst.Parent == nil then
			self.Registry[inst] = nil
		else
			local goal = {}
			for prop, key in pairs(entry) do
				goal[prop] = self:Get(key)
			end
			if animated then
				tween(inst, Ease.Theme, goal)
			else
				for prop, value in pairs(goal) do
					inst[prop] = value
				end
			end
		end
	end
	for _, fn in ipairs(self.Listeners) do
		fn(animated)
	end
end

function Theme:OnChanged(fn)
	table.insert(self.Listeners, fn)
end

local function label(theme, props)
	local colorKey = props.Color or "Text"
	local class = props.Class or "TextLabel"
	props.Color = nil
	props.Class = nil
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Fonts.Regular,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	for key, value in pairs(defaults) do
		if props[key] == nil then
			props[key] = value
		end
	end
	local inst = create(class, props)
	theme:Bind(inst, { TextColor3 = colorKey })
	return inst
end

local function hairline(theme, parent, inset)
	local line = create("Frame", {
		Position = UDim2.fromOffset(inset, 0),
		Size = UDim2.new(1, -inset * 2, 0, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = parent,
	})
	theme:Bind(line, { BackgroundColor3 = "LineColor", BackgroundTransparency = "LineT" })
	return line
end

local function reveal(inst, delay, info)
	inst.TextTransparency = 1
	task.delay(delay or 0, function()
		if inst.Parent then
			tween(inst, info or Ease.Slow, { TextTransparency = 0 })
		end
	end)
end

local function pressable(btn, amount)
	local sc = create("UIScale", { Parent = btn })
	btn.MouseButton1Down:Connect(function()
		tween(sc, Ease.Quick, { Scale = amount or 0.96 })
	end)
	local function up()
		tween(sc, Ease.Pop, { Scale = 1 })
	end
	btn.MouseButton1Up:Connect(up)
	btn.MouseLeave:Connect(up)
	return sc
end

local function hoverFill(theme, btn, restKey, hoverKey, pressKey)
	theme:Bind(btn, { BackgroundTransparency = restKey })
	local over = false
	btn.MouseEnter:Connect(function()
		over = true
		theme:Set(btn, "BackgroundTransparency", hoverKey, Ease.Hover)
	end)
	btn.MouseLeave:Connect(function()
		over = false
		theme:Set(btn, "BackgroundTransparency", restKey, Ease.Hover)
	end)
	if pressKey then
		btn.MouseButton1Down:Connect(function()
			theme:Set(btn, "BackgroundTransparency", pressKey, Ease.Quick)
		end)
		btn.MouseButton1Up:Connect(function()
			theme:Set(btn, "BackgroundTransparency", over and hoverKey or restKey, Ease.Hover)
		end)
	end
end

local function elevate(theme, frame, blur, offset)
	theme:Bind(frame, { BackgroundColor3 = "Elevated" })
	local stroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame })
	theme:Bind(stroke, { Color = "StrokeColor", Transparency = "StrokeT" })
	local shadow = newShadow(frame, {
		BlurRadius = UDim.new(0, blur or 24),
		Offset = UDim2.fromOffset(0, offset or 8),
		ShowBehindParent = false,
	})
	if shadow then
		theme:Bind(shadow, { Color = "Shadow", Transparency = "ShadowT" })
	end
	return stroke, shadow
end

-- icons: files in Isle.IconFolder, fetched from Isle.IconUrl on demand

local iconState = {}
local iconWaiters = {}
local iconQueue = {}
local iconWorkers = 0

local function iconContent(name)
	local v = Isle.Icons[name]
	if type(v) == "number" and v ~= 0 then
		return "rbxassetid://" .. tostring(v)
	end
	if type(v) == "string" and v ~= "" and v ~= "0" and v ~= "rbxassetid://0" then
		if v:match("^%d+$") then
			return "rbxassetid://" .. v
		end
		return v
	end
	return nil
end

local function canIconFiles()
	local asset = getcustomasset or getsynasset
	return type(asset) == "function"
		and type(writefile) == "function"
		and type(isfile) == "function"
		and type(Isle.IconFolder) == "string"
		and Isle.IconFolder ~= ""
end

local function ensureFolder(path)
	if type(makefolder) ~= "function" then
		return
	end
	local built = ""
	for part in path:gmatch("[^/\\]+") do
		built = built == "" and part or (built .. "/" .. part)
		local exists = false
		if type(isfolder) == "function" then
			local ok, value = pcall(isfolder, built)
			exists = ok and value == true
		end
		if not exists then
			pcall(makefolder, built)
		end
	end
end

local function httpFetch(url)
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if type(req) == "function" then
		local ok, res = pcall(req, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and (res.StatusCode or 200) == 200 and type(res.Body) == "string" then
			return res.Body
		end
		return nil
	end
	local ok, body = pcall(function()
		return game:HttpGet(url)
	end)
	return ok and type(body) == "string" and body or nil
end

local function loadIconFile(name)
	local asset = getcustomasset or getsynasset
	local path = Isle.IconFolder .. "/" .. name .. ".png"
	local okFile, exists = pcall(isfile, path)
	if not (okFile and exists) then
		if type(Isle.IconUrl) ~= "string" or Isle.IconUrl == "" then
			return nil
		end
		local body = httpFetch(Isle.IconUrl .. name .. ".png")
		if not body or body:sub(2, 4) ~= "PNG" then
			return nil
		end
		ensureFolder(Isle.IconFolder)
		if not pcall(writefile, path, body) then
			return nil
		end
	end
	local ok, content = pcall(asset, path)
	if ok and type(content) == "string" and content ~= "" then
		return content
	end
	return nil
end

local function pumpIcons()
	while iconWorkers < 4 and #iconQueue > 0 do
		local name = table.remove(iconQueue, 1)
		iconWorkers += 1
		task.spawn(function()
			local ok, content = pcall(loadIconFile, name)
			iconWorkers -= 1
			if ok and content then
				Isle.Icons[name] = content
				iconState[name] = "ready"
			else
				iconState[name] = "failed"
			end
			local waiters = iconWaiters[name]
			iconWaiters[name] = nil
			if waiters and iconState[name] == "ready" then
				for _, fn in ipairs(waiters) do
					task.spawn(fn)
				end
			end
			pumpIcons()
		end)
	end
end

local function requestIcon(name, onReady)
	if type(name) ~= "string" or name == "" or not name:match("^[%w%-_]+$") then
		return
	end
	if iconContent(name) or iconState[name] == "failed" or not canIconFiles() then
		return
	end
	if onReady then
		iconWaiters[name] = iconWaiters[name] or {}
		table.insert(iconWaiters[name], onReady)
	end
	if iconState[name] ~= "loading" then
		iconState[name] = "loading"
		table.insert(iconQueue, name)
		pumpIcons()
	end
end

function Isle.SetIconSource(folder, url)
	Isle.IconFolder = folder or Isle.IconFolder
	if url then
		Isle.IconUrl = url:sub(-1) == "/" and url or (url .. "/")
	end
	table.clear(iconState)
end

function Isle.LoadIcons(names)
	for _, name in ipairs(names or {}) do
		requestIcon(name)
	end
end

