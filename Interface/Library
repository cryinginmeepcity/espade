	theme:OnChanged(function()
		repaintUntil = os.clock() + 0.9
		for _, node in pairs(nodes) do
			node.Icon:SetColor(nodeTint(typeOf(node.Type)), Ease.Theme)
		end
	end)

	local lastScale = scaleNow()
	local lastOrigin = viewport.AbsolutePosition
	table.insert(window._steppers, function(dt)
		settleEdges(dt)
		local nowScale = scaleNow()
		local origin = viewport.AbsolutePosition
		if nowScale ~= lastScale or origin ~= lastOrigin then
			lastScale, lastOrigin = nowScale, origin
			syncPaths()
		end
		if subjectDirty then
			refreshSubject()
		end
		if next(arranging) then
			local ease = damp(12, dt)
			for node in pairs(arranging) do
				if nodes[node.Id] ~= node or not node.TX then
					arranging[node] = nil
				else
					node.X += (node.TX - node.X) * ease
					node.Y += (node.TY - node.Y) * ease
					if math.abs(node.TX - node.X) < 0.4 and math.abs(node.TY - node.Y) < 0.4 then
						node.X, node.Y = node.TX, node.TY
						node.TX, node.TY = nil, nil
						arranging[node] = nil
					end
					node.Frame.Position = UDim2.fromOffset(node.X, node.Y)
					refreshEdges(node)
				end
			end
		end
		local settled = window.ActivePage == page and page._alpha > 0.5 and window._vis > 0.5
		local nextProgress = settled and math.min(1, wireProgress + dt / 0.3) or 0
		if nextProgress ~= wireProgress then
			wireProgress = nextProgress
			wireAlpha = smooth(wireProgress)
			for _, edge in pairs(edges) do
				fadeWire(edge)
				fadePath(edge.Head)
				fadeChip(edge)
			end
			fadeWire(tempWire)
			repaintUntil = os.clock() + 0.3
		end
		-- a Path2D keeps its old look until its points change, so colour and fade changes force a redraw
		if os.clock() < repaintUntil then
			syncPaths()
		end
		local goal = panelOpen and 0 or (PANEL_W + 30)
		if math.abs(panelOffset - goal) > 0.3 then
			panelOffset += (goal - panelOffset) * damp(panelOpen and 13 or 18, dt)
			if math.abs(panelOffset - goal) <= 0.3 then
				panelOffset = goal
				if not panelOpen then
					panel.Visible = false
				end
			end
			panel.Position = UDim2.new(1, -12 + panelOffset, 0, 12)
		end
		if zoom ~= targetZoom or pan ~= targetPan then
			local a = damp(18, dt)
			zoom += (targetZoom - zoom) * a
			pan = pan:Lerp(targetPan, a)
			if math.abs(zoom - targetZoom) < 0.001 and (pan - targetPan).Magnitude < 0.3 then
				zoom, pan = targetZoom, targetPan
			end
			applyView()
		end
	end)

	history.Last = snapshot()
	applyView()
	return canvas
