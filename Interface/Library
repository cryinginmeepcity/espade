function Page:Choice(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local options = opts.Options or {}
	local limit = opts.Width or 288
	local H, GAP = 30, 6
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, H),
		LayoutOrder = self:_next(),
		Parent = self.Content,
	})
	local obj = { Value = nil }
	local pills = {}

	local function paint(key, info)
		local pill = pills[key]
		if not pill then
			return
		end
		local on = obj.Value == key
		theme:Set(pill.Button, "BackgroundColor3", on and "Primary" or "FieldColor", info)
		theme:Set(pill.Button, "BackgroundTransparency", on and "Opaque" or (pill.Over and "PressT" or "FieldT"), info)
		theme:Set(pill.Label, "TextColor3", on and "PrimaryText" or "SubText", info)
		if pill.Icon then
			pill.Icon:SetColor(on and "PrimaryText" or "SubText", info)
		end
	end

	function obj:Set(key, silent)
		if key ~= nil and not pills[key] then
			key = nil
		end
		local old = self.Value
		if old == key then
			return
		end
		self.Value = key
		paint(old, Ease.Hover)
		paint(key, Ease.Hover)
		if not silent then
			fire(opts.Callback, key)
		end
	end
	function obj:Get()
		return self.Value
	end

	local x, y = 0, 0
	for _, option in ipairs(options) do
		local text = option.Label or tostring(option.Key)
		local width = math.ceil(measure(text, 13)) + (option.Icon and 40 or 24)
		if x > 0 and x + width > limit then
			x = 0
			y += H + GAP
		end
		local btn = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(width, H),
			Parent = holder,
			round(),
		})
		local icon
		if option.Icon then
			icon = newIcon(theme, btn, option.Icon, "SubText", 13, {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 11, 0.5, 0),
			})
		end
		local text_ = label(theme, {
			Text = text,
			FontFace = Fonts.Medium,
			TextSize = 13,
			Color = "SubText",
			TextTruncate = Enum.TextTruncate.None,
			Position = UDim2.fromOffset(option.Icon and 29 or 12, 0),
			Size = UDim2.new(1, -(option.Icon and 40 or 24), 1, 0),
			Parent = btn,
		})
		local pill = { Button = btn, Label = text_, Icon = icon, Over = false }
		pills[option.Key] = pill
		pressable(btn, 0.95)
		btn.MouseEnter:Connect(function()
			pill.Over = true
			paint(option.Key, Ease.Hover)
		end)
		btn.MouseLeave:Connect(function()
			pill.Over = false
			paint(option.Key, Ease.Hover)
		end)
		btn.MouseButton1Click:Connect(function()
			obj:Set(obj.Value ~= option.Key and option.Key or nil)
		end)
		x += width + GAP
	end
	holder.Size = UDim2.new(1, 0, 0, y + H)
	if opts.Default ~= nil and pills[opts.Default] then
		obj.Value = opts.Default
	end
	for key in pairs(pills) do
		paint(key, nil)
	end
	return finish(obj, holder)
end

function Section:Item(opts)
	opts = opts or {}
	local theme = self.Window.Theme
