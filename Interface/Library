		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 0, 0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = right,
		corner(9),
		pad(0, 12, 0, 12),
		create("UISizeConstraint", { MinSize = Vector2.new(56, 30) }),
	})
	theme:Bind(pill, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
	local pillStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = pill })
	theme:Bind(pillStroke, { Color = "Accent" })
	local text = label(theme, {
		Text = "",
		FontFace = Fonts.Medium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Parent = pill,
	})

	local obj = { Value = opts.Default }
	local listening = false
	local function display()
		text.Text = listening and "Press a key" or keyName(obj.Value)
		theme:Set(text, "TextColor3", listening and "SubText" or "Text")
	end
	function obj:Set(key, silent)
		self.Value = key
		display()
		if not silent then
			fire(opts.Callback, key)
		end
	end
	function obj:Get()
		return self.Value
	end

	local function start()
		if listening then
			return
		end
		listening = true
		display()
		focusStyle(theme, pillStroke, true)
		window._capture = function(key)
			listening = false
			focusStyle(theme, pillStroke, false)
			if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Unknown then
				display()
				return
			end
			obj:Set(key)
		end
	end
	pill.MouseButton1Click:Connect(start)
	row.MouseButton1Click:Connect(start)

	display()
	return finish(obj, row)
end

local function segmented(theme, parent, options, default, callback, height, icons)
	local radius = height >= 36 and 12 or 10
	local frame = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		Parent = parent,
		corner(radius),
		pad(3),
	})
	theme:Bind(frame, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
	local count = math.max(#options, 1)
	local indicator = create("Frame", {
		Size = UDim2.fromScale(1 / count, 1),
		ZIndex = 1,
		Parent = frame,
		corner(radius - 3),
	})
	theme:Bind(indicator, { BackgroundColor3 = "IndicatorColor", BackgroundTransparency = "IndicatorT" })
	local indicatorShadow = newShadow(indicator, {
		BlurRadius = UDim.new(0, 6),
		Offset = UDim2.fromOffset(0, 1),
		Transparency = 0.9,
		ShowBehindParent = false,
	})
	if indicatorShadow then
		theme:Bind(indicatorShadow, { Color = "Shadow" })
	end

	local obj = { Value = nil, Frame = frame }
	local labels = {}
	local glyphs = {}
	for i, option in ipairs(options) do
		local btn = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Position = UDim2.fromScale((i - 1) / count, 0),
			Size = UDim2.fromScale(1 / count, 1),
			ZIndex = 2,
			Parent = frame,
		})
		local iconName = icons and icons[option]
		if iconName then
			glyphs[option] = newIcon(theme, btn, iconName, "Muted", 17, {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 9),
				ZIndex = 2,
			})
		end
		labels[option] = label(theme, {
			Text = tostring(option),
			FontFace = Fonts.Medium,
			TextSize = iconName and 12 or (height >= 36 and 14 or 13),
			Color = "Muted",
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = iconName and UDim2.new(0, 0, 1, -24) or UDim2.new(),
			Size = iconName and UDim2.new(1, 0, 0, 16) or UDim2.fromScale(1, 1),
			ZIndex = 2,
			Parent = btn,
		})
		local function tone(key, info)
			theme:Set(labels[option], "TextColor3", key, info)
			if glyphs[option] then
				glyphs[option]:SetColor(key, info)
			end
		end
		btn.MouseEnter:Connect(function()
			if obj.Value ~= option then
				tone("SubText", Ease.Hover)
			end
		end)
		btn.MouseLeave:Connect(function()
			if obj.Value ~= option then
				tone("Muted", Ease.Hover)
			end
		end)
		btn.MouseButton1Click:Connect(function()
			obj:Set(option)
		end)
	end
	local function paint(option, key, info)
		if labels[option] then
			theme:Set(labels[option], "TextColor3", key, info)
		end
		if glyphs[option] then
			glyphs[option]:SetColor(key, info)
		end
	end
	function obj:Set(value, silent, instant)
		local index = table.find(options, value)
		if not index then
			return
		end
		local changed = value ~= self.Value
		if self.Value ~= nil and self.Value ~= value then
			paint(self.Value, "Muted", Ease.Hover)
		end
		self.Value = value
		paint(value, "Text", if instant then nil else Ease.Hover)
		local goal = UDim2.fromScale((index - 1) / count, 0)
		if instant then
			indicator.Position = goal
		else
			tween(indicator, Ease.Smooth, { Position = goal })
		end
		if changed and not silent then
			fire(callback, value)
		end
	end
	function obj:Get()
		return self.Value
	end
	obj:Set(default or options[1], true, true)
	return obj
end

