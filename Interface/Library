	local function searchStatus()
		local count = #search.Matches
		if searchBox.Text == "" then
			searchCount.Text = ""
		elseif count == 0 then
			searchCount.Text = "None"
		elseif search.Index > 0 then
			searchCount.Text = search.Index .. " / " .. count
		else
			searchCount.Text = tostring(count)
		end
	end

	local function runSearch()
		for _, node in ipairs(search.Matches) do
			node.Match = nil
			if nodes[node.Id] == node then
				styleNode(node)
			end
		end
		table.clear(search.Matches)
		search.Index = 0
		local query = searchBox.Text:lower()
		if search.Open and query ~= "" then
			for _, node in pairs(nodes) do
				local hay = node.TitleLabel.Text:lower()
				for _, value in pairs(node.Fields) do
					hay ..= "\n" .. tostring(value):lower()
				end
				if hay:find(query, 1, true) then
					table.insert(search.Matches, node)
				end
			end
			table.sort(search.Matches, function(a, b)
				if a.Y ~= b.Y then
					return a.Y < b.Y
				end
				return a.X < b.X
			end)
			for _, node in ipairs(search.Matches) do
				node.Match = true
				styleNode(node)
			end
		end
		searchStatus()
	end
	afterRestore = function()
		if search.Open then
			runSearch()
		end
	end

	local function nextMatch()
		local count = #search.Matches
		if count == 0 then
			return
		end
		search.Index = search.Index % count + 1
		local node = search.Matches[search.Index]
		canvas.Focus(node)
		select(node)
		searchStatus()
	end

