function Section:Toggle(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local row, right = self:_row(opts, 38)
	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(38, 22),
		Parent = right,
		round(),
	})
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Parent = track,
		round(),
	})

	local obj = { Value = false }
	local function render(animated)
		local on = obj.Value
		local info = animated and Ease.Smooth or nil
		theme:Set(track, "BackgroundColor3", on and "Primary" or "TrackColor", info)
		theme:Set(track, "BackgroundTransparency", on and "Opaque" or "TrackT", info)
		theme:Set(knob, "BackgroundColor3", on and "PrimaryText" or "Knob", info)
		local goal = { Position = on and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(16, 16) }
		if animated then
			tween(knob, Ease.Pop, goal)
		else
			knob.Position, knob.Size = goal.Position, goal.Size
		end
	end
	function obj:Set(value, silent)
		value = value and true or false
		local changed = value ~= self.Value
		self.Value = value
		render(true)
		if changed and not silent then
			fire(opts.Callback, value)
		end
	end
	function obj:Get()
		return self.Value
	end

	row.MouseButton1Down:Connect(function()
		tween(knob, Ease.Quick, {
			Size = UDim2.fromOffset(20, 16),
			Position = obj.Value and UDim2.new(0, 15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		})
	end)
	row.MouseLeave:Connect(function()
		render(true)
	end)
	row.MouseButton1Click:Connect(function()
		obj:Set(not obj.Value)
	end)

	obj.Value = opts.Default == true
	render(false)
	return finish(obj, row)
end

