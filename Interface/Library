				icon = newIcon(theme, inner, iconName, tone, 15, { LayoutOrder = 1, ZIndex = 32 })
			end
			textLabel = label(theme, {
				Text = text,
				FontFace = Fonts.Medium,
				TextSize = 13,
				Color = primary and "PrimaryText" or "Text",
				TextTruncate = Enum.TextTruncate.None,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 1, 0),
				LayoutOrder = 2,
				ZIndex = 32,
				Parent = inner,
			})
		elseif iconName then
			icon = newIcon(theme, btn, iconName, tone, 15, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				ZIndex = 32,
			})
