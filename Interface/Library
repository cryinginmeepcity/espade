		Parent = action,
	})
	local actionScale = create("UIScale", { Parent = action })

	local secret
	local function setSecret(value)
		if value and not secret then
			secret = secretControl(theme, box, frame, ACTION_W + 14)
			box.Size = UDim2.new(1, -(18 + ACTION_W + 48), 1, 0)
		elseif not value and secret then
			secret:Destroy()
			secret = nil
			box.Size = UDim2.new(1, -(18 + ACTION_W + 18), 1, 0)
		end
	end
	setSecret(opts.Secret)

	local obj = { Loading = false, Box = box }
	local pulse

	function obj:SetLoading(loading)
		self.Loading = loading
		box.TextEditable = not loading
		if pulse then
			pulse:Cancel()
			pulse = nil
		end
		if loading then
			actionLabel.Text = opts.LoadingText or "…"
			action.BackgroundTransparency = 0
			pulse = tween(action, Ease.Pulse, { BackgroundTransparency = 0.5 })
		else
			actionLabel.Text = opts.Action or "Go"
			tween(action, Ease.Hover, { BackgroundTransparency = 0 })
		end
	end
	function obj:SetText(value)
		box.Text = tostring(value or "")
	end
	function obj:GetText()
		return box.Text
	end
	function obj:SetPlaceholder(value)
		box.PlaceholderText = value
	end
	function obj:SetSecret(value)
		setSecret(value)
	end
	function obj:Focus()
		box:CaptureFocus()
	end
	function obj:Submit()
		if not self.Loading then
			if secret then
				secret:Hide()
			end
			fire(opts.Callback, box.Text)
		end
	end

	box.Focused:Connect(function()
		focusStyle(theme, focus, true)
	end)
	box.FocusLost:Connect(function(enter)
		focusStyle(theme, focus, false)
		if enter then
			obj:Submit()
		end
	end)
	action.MouseEnter:Connect(function()
		if not obj.Loading then
			tween(action, Ease.Hover, { BackgroundTransparency = 0.1 })
		end
	end)
	action.MouseLeave:Connect(function()
		if not obj.Loading then
			tween(action, Ease.Hover, { BackgroundTransparency = 0 })
		end
		tween(actionScale, Ease.Smooth, { Scale = 1 })
	end)
	action.MouseButton1Down:Connect(function()
		tween(actionScale, Ease.Quick, { Scale = 0.95 })
	end)
	action.MouseButton1Up:Connect(function()
		tween(actionScale, Ease.Smooth, { Scale = 1 })
	end)
	action.MouseButton1Click:Connect(function()
		obj:Submit()
	end)

	if not self.FocusTarget then
		self.FocusTarget = obj
	end
	return finish(obj, holder)
end

function Page:Search(opts)
