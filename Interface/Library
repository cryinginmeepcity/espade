		Text = opts.Default or "",
		PlaceholderText = opts.Placeholder or "",
		ClearTextOnFocus = false,
		TextSize = 14,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, opts.Secret and -46 or -24, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = frame,
	})
	theme:Bind(box, { PlaceholderColor3 = "Muted" })
	smoothBox(self.Window, box)
	local secret
	if opts.Secret then
		secret = secretControl(theme, box, frame, 2)
	end

	local obj = { Value = box.Text, Box = box }
	function obj:Set(value, silent)
		box.Text = tostring(value or "")
		self.Value = box.Text
		if not silent then
			fire(opts.Callback, self.Value)
		end
	end
	function obj:Get()
		return box.Text
	end
	function obj:Focus()
		box:CaptureFocus()
	end

	box.Focused:Connect(function()
		focusStyle(theme, focus, true)
	end)
	box.FocusLost:Connect(function(enter)
		focusStyle(theme, focus, false)
		if secret then
			secret:Hide()
		end
		obj.Value = box.Text
		if enter or not opts.EnterOnly then
			fire(opts.Callback, box.Text)
		end
		if enter and opts.OnEnter then
			fire(opts.OnEnter, box.Text)
		end
	end)
	row.MouseButton1Click:Connect(function()
		box:CaptureFocus()
	end)
	return finish(obj, row)
end

function Section:Keybind(opts)
	opts = opts or {}
