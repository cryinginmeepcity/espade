	}
	local MAX_LAG = 70

	local function contains(inst, p)
		local pos, size = inst.AbsolutePosition, inst.AbsoluteSize
		return p.X >= pos.X and p.Y >= pos.Y and p.X <= pos.X + size.X and p.Y <= pos.Y + size.Y
	end

	local function reachable(inst, stop, p)
		local node = inst
		while node and node ~= stop do
			if node:IsA("GuiObject") then
				if not node.Visible then
					return false
				end
				if node ~= inst and node.ClipsDescendants and not contains(node, p) then
					return false
				end
			end
			node = node.Parent
		end
		return true
	end

	local function overControl(container, p)
		for _, inst in ipairs(container:GetDescendants()) do
			if (inst:IsA("GuiButton") or inst:IsA("TextBox")) and not inst:GetAttribute("IsleStatic") then
				if contains(inst, p) and reachable(inst, container, p) then
					return true
				end
			end
		end
		return false
	end

	local function beginDrag(mode)
		dragging = true
		dragMode = mode
		dragStartMouse = UserInputService:GetMouseLocation()
		dragStartOffset = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
		dragStartAbs = root.AbsolutePosition
		dragTarget = dragStartOffset
