		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = card,
		corner(RADIUS),
	})
	theme:Bind(fill, { BackgroundColor3 = "Background" })
	local fillGradient = create("UIGradient", { Rotation = 90, Parent = fill })
	local shade = theme:Get("Shade")
	local function setShade(value)
		shade = value
		fillGradient.Color = ColorSequence.new(WHITE, Color3.new(value, value, value))
	end
	setShade(shade)
	local cardShadow = newShadow(fill, {
		BlurRadius = UDim.new(0, 80),
		Spread = UDim2.fromOffset(4, 10),
		Offset = UDim2.fromOffset(0, 28),
		Transparency = 1,
		ShowBehindParent = false,
	})
	if cardShadow then
		theme:Bind(cardShadow, { Color = "Shadow" })
	end

	local grain
	if Isle.GrainId and Isle.GrainId ~= "" and Isle.GrainId ~= "rbxassetid://0" then
		grain = create("ImageLabel", {
			Name = "Grain",
			Image = Isle.GrainId,
			ScaleType = Enum.ScaleType.Tile,
			TileSize = UDim2.fromOffset(192, 192),
			BackgroundTransparency = 1,
			ImageTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
			Parent = card,
			corner(RADIUS),
		})
		theme:Bind(grain, { ImageColor3 = "Dot" })
	end

	local dots
	if options.Grid ~= false then
		dots = newDots(theme, card, maxW, window.MaxHeight)
		dots.SetSize(W, minHeight)
		window.Dots = dots
	end

	local rim = create("Frame", {
		Name = "Rim",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = card,
		corner(RADIUS),
	})
	local rimStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0, Parent = rim })
	theme:Bind(rimStroke, { Color = "StrokeColor" })
	local rimGradient = create("UIGradient", { Rotation = 90, Parent = rimStroke })
	local function setRim(alpha)
		local t = theme:Get("StrokeT")
		local top = 1 - (1 - math.max(t - 0.14, 0)) * alpha
		local mid = 1 - (1 - t) * alpha
		local low = 1 - (1 - math.min(t + 0.05, 1)) * alpha
		rimGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, top),
			NumberSequenceKeypoint.new(0.22, mid),
			NumberSequenceKeypoint.new(1, low),
		})
	end

	local setEdge = newEdgeLights(theme, card)

	local header = create("CanvasGroup", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		ZIndex = 5,
		Parent = card,
	})
	local brand = create("CanvasGroup", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(PAGE_PAD, 0),
		Size = UDim2.new(1, -130, 1, 0),
		Parent = header,
		list({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
		}),
	})
	local function toImage(logo)
		if type(logo) == "number" or (type(logo) == "string" and logo:match("^%d+$")) then
			return "rbxassetid://" .. tostring(logo)
		end
		return logo
	end
	window.LogoImage = create("ImageLabel", {
		Image = toImage(options.Logo) or "",
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(options.LogoSize or 20, options.LogoSize or 20),
		Visible = options.Logo ~= nil,
		LayoutOrder = 0,
		Parent = brand,
	})
	window._toImage = toImage
	window.TitleLabel = label(theme, {
		Text = options.Title or "Isle",
		FontFace = Fonts.SemiBold,
		TextSize = 15,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 1,
		Parent = brand,
	})
	local subDot = create("Frame", {
		Size = UDim2.fromOffset(3, 3),
		LayoutOrder = 2,
		Visible = options.Subtitle ~= nil and options.Subtitle ~= "",
		Parent = brand,
		round(),
	})
	theme:Bind(subDot, { BackgroundColor3 = "Muted" })
	window.SubtitleLabel = label(theme, {
		Text = options.Subtitle or "",
		Visible = options.Subtitle ~= nil and options.Subtitle ~= "",
		TextSize = 14,
		Color = "SubText",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 3,
		Parent = brand,
	})
	window._subDot = subDot

	local function unscale()
		return scale.Scale > 0 and scale.Scale or 1
	end

	local function makeTooltip(anchor, text)
		local tip = create("Frame", {
			Name = "Tooltip",
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			Size = UDim2.new(0, 0, 0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			Visible = false,
			ZIndex = 80,
			Parent = card,
			corner(8),
			pad(0, 10, 0, 10),
		})
		theme:Bind(tip, { BackgroundColor3 = "Elevated" })
		local tipStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = tip })
		theme:Bind(tipStroke, { Color = "StrokeColor" })
		local tipLabel = label(theme, {
			Text = type(text) == "string" and text or "",
			FontFace = Fonts.Medium,
			TextSize = 12,
			Color = "SubText",
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.None,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			TextTransparency = 1,
			ZIndex = 81,
			Parent = tip,
		})
		local token = 0
		anchor.MouseEnter:Connect(function()
			token += 1
			local mine = token
			task.delay(0.4, function()
				if mine ~= token or not anchor.Parent then
					return
				end
				local value = text
				if type(text) == "function" then
					value = text()
				end
				if type(value) ~= "string" or value == "" then
					return
				end
				tipLabel.Text = value
				local s = unscale()
				local rel = (anchor.AbsolutePosition - card.AbsolutePosition) / s
				local size = anchor.AbsoluteSize / s
				local x = math.clamp(rel.X + size.X / 2, 40, card.AbsoluteSize.X / s - 40)
				local y = rel.Y + size.Y + 6
				local nudge = -4
				if y + 30 > card.AbsoluteSize.Y / s then
					y = rel.Y - 32
					nudge = 4
				end
				tip.Position = UDim2.fromOffset(x, y + nudge)
				tip.Visible = true
				tip.BackgroundTransparency = 1
				tipLabel.TextTransparency = 1
				tipStroke.Transparency = 1
				tween(tip, Ease.Hover, { BackgroundTransparency = 0, Position = UDim2.fromOffset(x, y) })
				tween(tipLabel, Ease.Hover, { TextTransparency = 0 })
				tween(tipStroke, Ease.Hover, { Transparency = theme:Get("StrokeT") })
			end)
		end)
		local function hide()
			token += 1
			tip.Visible = false
		end
		anchor.MouseLeave:Connect(hide)
		anchor.MouseButton1Down:Connect(hide)
		anchor.Destroying:Connect(function()
			token += 1
			tip:Destroy()
		end)
	end
	window._tooltip = makeTooltip

	local function headerButton(parent, iconName, tip)
		local btn = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromOffset(30, 30),
			Parent = parent,
			round(),
		})
		theme:Bind(btn, { BackgroundColor3 = "HoverColor" })
		hoverFill(theme, btn, "Clear", "HoverT", "PressT")
		local icon
		if iconName then
			icon = newIcon(theme, btn, iconName, "Muted", 16, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
			})
			btn.MouseEnter:Connect(function()
				icon:SetColor("Text", Ease.Hover)
			end)
			btn.MouseLeave:Connect(function()
				icon:SetColor("Muted", Ease.Hover)
			end)
		end
		if tip then
			makeTooltip(btn, tip)
		end
		return btn, icon
	end

	local backBtn = headerButton(header, "chevron-left", "Back")
	backBtn.AnchorPoint = Vector2.new(0, 0.5)
	backBtn.Position = UDim2.new(0, 10, 0.5, 0)
	backBtn.Visible = false
	local backScale = create("UIScale", { Scale = 0.6, Parent = backBtn })
	backBtn.MouseButton1Click:Connect(function()
		window:Back()
	end)

	function window:_updateBack()
		local page = self.ActivePage
		local show = #self._history > 0 and page ~= nil and not page.NavItem.Visible
		if show == self._backShown then
			return
		end
		self._backShown = show
		if show then
			backBtn.Visible = true
		end
		tween(backScale, show and Ease.Pop or Ease.Hover, { Scale = show and 1 or 0.6 })
		tween(brand, Ease.Smooth, { Position = UDim2.fromOffset(show and 50 or PAGE_PAD, 0) })
		if not show then
			task.delay(0.16, function()
				if not self._backShown then
					backBtn.Visible = false
				end
			end)
		end
	end

