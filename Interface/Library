	local navStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = navBack })
	theme:Bind(navStroke, { Color = "StrokeColor" })
	local navShadow = newShadow(navBack, {
		BlurRadius = UDim.new(0, 26),
