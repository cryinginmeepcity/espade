function Page:Field(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local actionText = opts.Action or "Go"
	local ACTION_W = math.clamp(estimate(opts.LoadingText or actionText, 14) + 30, 62, 110)
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 52),
		LayoutOrder = self:_next(),
		Parent = self.Content,
	})
	local frame, focus = field(theme, holder, 52, 16)
	local box = label(theme, {
		Class = "TextBox",
		Text = "",
		PlaceholderText = opts.Placeholder or "",
		ClearTextOnFocus = false,
		TextSize = self.Compact and 14 or 15,
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -(18 + ACTION_W + 18), 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = frame,
	})
	theme:Bind(box, { PlaceholderColor3 = "Muted" })
	smoothBox(self.Window, box)

	local action = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -7, 0.5, 0),
		Size = UDim2.fromOffset(ACTION_W, 38),
		Parent = frame,
		corner(11),
	})
	theme:Bind(action, { BackgroundColor3 = "Primary" })
	local actionLabel = label(theme, {
		Text = actionText,
		FontFace = Fonts.SemiBold,
		TextSize = 14,
		Color = "PrimaryText",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		Size = UDim2.fromScale(1, 1),
		Parent = action,
	})
	pressable(action, 0.95)

	local secret
	local function setSecret(value)
		if value and not secret then
			secret = secretControl(theme, box, frame, ACTION_W + 13)
			box.Size = UDim2.new(1, -(18 + ACTION_W + 48), 1, 0)
		elseif not value and secret then
			secret:Destroy()
			secret = nil
			box.Size = UDim2.new(1, -(18 + ACTION_W + 18), 1, 0)
		end
	end
	setSecret(opts.Secret)

	local obj = { Loading = false, Box = box }
	local pulse

	function obj:SetLoading(loading)
		self.Loading = loading
		box.TextEditable = not loading
		if pulse then
			pulse:Cancel()
			pulse = nil
		end
		if loading then
			actionLabel.Text = opts.LoadingText or "…"
			action.BackgroundTransparency = 0
			pulse = tween(action, Ease.Pulse, { BackgroundTransparency = 0.55 })
		else
			actionLabel.Text = actionText
			tween(action, Ease.Hover, { BackgroundTransparency = 0 })
		end
	end
	function obj:SetText(value)
		box.Text = tostring(value or "")
	end
	function obj:GetText()
		return box.Text
	end
	function obj:SetPlaceholder(value)
		box.PlaceholderText = value
	end
	function obj:SetSecret(value)
		setSecret(value)
	end
	function obj:Focus()
		box:CaptureFocus()
	end
	function obj:Submit()
		if not self.Loading then
			if secret then
				secret:Hide()
			end
			fire(opts.Callback, box.Text)
		end
	end

	box.Focused:Connect(function()
		focusStyle(theme, focus, true)
	end)
	box.FocusLost:Connect(function(enter)
		focusStyle(theme, focus, false)
		if enter then
			obj:Submit()
		end
	end)
	action.MouseEnter:Connect(function()
		if not obj.Loading then
			tween(action, Ease.Hover, { BackgroundTransparency = 0.12 })
		end
	end)
	action.MouseLeave:Connect(function()
		if not obj.Loading then
			tween(action, Ease.Hover, { BackgroundTransparency = 0 })
		end
	end)
	action.MouseButton1Click:Connect(function()
		obj:Submit()
	end)

	if not self.FocusTarget then
		self.FocusTarget = obj
	end
	return finish(obj, holder)
end

function Page:TextArea(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local maxLength = opts.MaxLength or 1000
	local height = opts.Height or 132
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = self:_next(),
		Parent = self.Content,
	})
	local frame, focus = field(theme, holder, height, 16)
	local box = label(theme, {
		Class = "TextBox",
		Text = "",
		PlaceholderText = opts.Placeholder or "",
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextSize = 14,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.None,
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.new(1, -32, 1, -40),
		ClipsDescendants = true,
		Parent = frame,
	})
	theme:Bind(box, { PlaceholderColor3 = "Muted" })
	local counter = label(theme, {
		Text = "0 / " .. maxLength,
		TextSize = 12,
		Color = "Muted",
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -8),
		Size = UDim2.fromOffset(120, 16),
		Parent = frame,
	})
	local trimming = false
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if trimming then
			return
		end
		local length = utf8.len(box.Text) or #box.Text
		if length > maxLength then
			trimming = true
			local cut = utf8.offset(box.Text, maxLength + 1)
			box.Text = cut and box.Text:sub(1, cut - 1) or box.Text:sub(1, maxLength)
			trimming = false
			length = maxLength
		end
		counter.Text = length .. " / " .. maxLength
		theme:Set(counter, "TextColor3", length >= maxLength and "Warning" or "Muted")
	end)
	box.Focused:Connect(function()
		focusStyle(theme, focus, true)
	end)
	box.FocusLost:Connect(function()
		focusStyle(theme, focus, false)
	end)

	local obj = { Box = box }
	function obj:GetText()
		return box.Text
	end
	function obj:SetText(value)
		box.Text = tostring(value or "")
	end
	function obj:Focus()
		box:CaptureFocus()
	end
	function obj:SetEditable(value)
		box.TextEditable = value
	end
	return finish(obj, holder)
end

function Page:Search(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 42),
		LayoutOrder = self:_next(),
		Parent = self.Content,
	})
	local frame, focus = field(theme, holder, 42, 13)
	local lens = newIcon(theme, frame, "search", "Muted", 16, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
	})
	local box = label(theme, {
		Class = "TextBox",
		Text = "",
		PlaceholderText = opts.Placeholder or "Search",
		ClearTextOnFocus = false,
		TextSize = 14,
		Position = UDim2.fromOffset(40, 0),
		Size = UDim2.new(1, -110, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = frame,
	})
	theme:Bind(box, { PlaceholderColor3 = "Muted" })
	smoothBox(self.Window, box)
	local hint = kbd(theme, frame, opts.Hint or "Ctrl F", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
	})

	local obj = { Box = box }
	function obj:Focus()
		box:CaptureFocus()
	end
	function obj:SetText(value)
		box.Text = tostring(value or "")
	end
	function obj:GetText()
		return box.Text
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		fire(opts.Callback, box.Text)
	end)
	box.Focused:Connect(function()
		focusStyle(theme, focus, true)
		lens:SetColor("Text", Ease.Hover)
		hint.Visible = false
	end)
	box.FocusLost:Connect(function()
		focusStyle(theme, focus, false)
		lens:SetColor("Muted", Ease.Hover)
		hint.Visible = box.Text == ""
	end)

	if not self.FocusTarget then
		self.FocusTarget = obj
	end
	return finish(obj, holder)
end

function Page:Profile(opts)
	opts = opts or {}
	local theme = self.Window.Theme
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = self:_next(),
		Parent = self.Content,
		corner(20),
		pad(18),
		list({ Padding = UDim.new(0, 16) }),
	})
	theme:Bind(card, { BackgroundColor3 = "GroupColor", BackgroundTransparency = "GroupT" })

	local function copyable(inst, getText, idleKey, hoverKey)
		inst.MouseEnter:Connect(function()
			theme:Set(inst, "TextColor3", hoverKey, Ease.Hover)
		end)
		inst.MouseLeave:Connect(function()
			theme:Set(inst, "TextColor3", idleKey, Ease.Hover)
		end)
		inst.MouseButton1Click:Connect(function()
			local text = getText()
			if text and text ~= "" and opts.OnCopy then
				fire(opts.OnCopy, text)
			end
		end)
	end

	local top = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 1, Parent = card })
	local avatar = create("ImageLabel", {
		Size = UDim2.fromOffset(60, 60),
		Image = "",
		Parent = top,
		round(),
	})
	theme:Bind(avatar, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
	local avatarStroke = create("UIStroke", { Parent = avatar })
	theme:Bind(avatarStroke, { Color = "StrokeColor", Transparency = "StrokeT" })
	local displayName = label(theme, {
		Class = "TextButton",
		AutoButtonColor = false,
		Text = "",
		FontFace = Fonts.SemiBold,
		TextSize = 21,
		Position = UDim2.fromOffset(76, 7),
		Size = UDim2.new(0, 0, 0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		TextTruncate = Enum.TextTruncate.None,
		Parent = top,
	})
	local userName = label(theme, {
		Class = "TextButton",
		AutoButtonColor = false,
		Text = "",
		TextSize = 14,
		Color = "SubText",
		Position = UDim2.fromOffset(76, 34),
		Size = UDim2.new(0, 0, 0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		TextTruncate = Enum.TextTruncate.None,
		Parent = top,
	})
	local current = {}
	copyable(displayName, function()
		return current.DisplayName
	end, "Text", "SubText")
	copyable(userName, function()
		return current.Name
	end, "SubText", "Text")

	local stats = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 2, Parent = card })

	local function divider(order)
		local d = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 1), LayoutOrder = order, Parent = card })
		hairline(theme, d, 0)
	end
	divider(3)

	local function block(order, title)
		local frame = create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Parent = card,
			list({ Padding = UDim.new(0, 8) }),
		})
		label(theme, {
			Text = title,
			FontFace = Fonts.Medium,
			TextSize = 12,
			Color = "Muted",
			Size = UDim2.new(1, 0, 0, 16),
			LayoutOrder = 1,
			Parent = frame,
		})
		return frame
	end

	local aboutBlock = block(4, "About")
	local bio = label(theme, {
		Text = "",
		TextSize = 14,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = aboutBlock,
	})
	local namesBlock = block(5, "Previous names")
	local names = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = namesBlock,
		list({ FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 6) }),
	})
	local note = label(theme, {
		Text = "",
		TextSize = 12,
		Color = "Muted",
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		LayoutOrder = 6,
		Parent = card,
	})

	local function setStats(list_)
		for _, child in ipairs(stats:GetChildren()) do
			child:Destroy()
		end
		local n = math.max(#list_, 1)
		for i, stat in ipairs(list_) do
			local cell = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Position = UDim2.new((i - 1) / n, i == 1 and 0 or 2, 0, 0),
				Size = UDim2.new(1 / n, i == 1 and -2 or -4, 1, 0),
				Parent = stats,
				corner(10),
			})
			if not stat.Callback then
				cell:SetAttribute("IsleStatic", true)
			end
			theme:Bind(cell, { BackgroundColor3 = "HoverColor" })
			local pad_ = stat.Callback and 8 or 0
			local value = label(theme, {
				Text = tostring(stat.Value or "—"),
				FontFace = Fonts.SemiBold,
				TextSize = 15,
				Position = UDim2.fromOffset(pad_, 4),
				Size = UDim2.new(1, -pad_ * 2, 0, 20),
				Parent = cell,
			})
			local caption = label(theme, {
				Text = stat.Label or "",
				TextSize = 12,
				Color = "Muted",
				Position = UDim2.fromOffset(pad_, 25),
				Size = UDim2.new(1, -pad_ * 2, 0, 16),
				Parent = cell,
			})
			if stat.Callback then
				hoverFill(theme, cell, "Clear", "HoverT", "PressT")
				cell.MouseButton1Click:Connect(function()
					fire(stat.Callback)
				end)
			end
			reveal(value, 0.04 * i)
			reveal(caption, 0.04 * i)
		end
	end

	local function setNames(list_)
		for _, child in ipairs(names:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if not list_ or #list_ == 0 then
			local none = label(theme, {
				Text = "None",
				TextSize = 14,
				Color = "SubText",
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 0, 20),
				TextTruncate = Enum.TextTruncate.None,
				Parent = names,
			})
			reveal(none, 0.1)
			return
		end
		for i, name in ipairs(list_) do
			local chip = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(0, 0, 0, 28),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = i,
				Parent = names,
				round(),
				pad(0, 12, 0, 12),
			})
			theme:Bind(chip, { BackgroundColor3 = "FieldColor" })
			hoverFill(theme, chip, "FieldT", "PressT")
			local text = label(theme, {
				Text = name,
				FontFace = Fonts.Medium,
				TextSize = 13,
				Color = "SubText",
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 1, 0),
				TextTruncate = Enum.TextTruncate.None,
				Parent = chip,
			})
			chip.MouseEnter:Connect(function()
				theme:Set(text, "TextColor3", "Text", Ease.Hover)
			end)
			chip.MouseLeave:Connect(function()
				theme:Set(text, "TextColor3", "SubText", Ease.Hover)
			end)
			chip.MouseButton1Click:Connect(function()
				if opts.OnCopy then
					fire(opts.OnCopy, name)
				end
			end)
			reveal(text, 0.1 + math.min(i, 10) * 0.02)
		end
	end

	local obj = {}
	function obj:SetLoading(name)
		current = {}
		avatar.Image = ""
		displayName.Text = name or "Loading"
		theme:Set(displayName, "TextColor3", "Muted")
		userName.Text = ""
		bio.Text = "…"
		setStats({
			{ Label = "Joined", Value = "…" },
			{ Label = "Age", Value = "…" },
			{ Label = "Friends", Value = "…" },
			{ Label = "Followers", Value = "…" },
			{ Label = "Following", Value = "…" },
		})
		setNames({})
		note.Visible = false
	end
	function obj:Set(data)
		data = data or {}
		current = { DisplayName = data.DisplayName, Name = data.Name }
		avatar.Image = data.Image or ""
		displayName.Text = data.DisplayName or ""
		theme:Set(displayName, "TextColor3", "Text")
		userName.Text = data.Name and ("@" .. data.Name) or ""
		reveal(displayName)
		reveal(userName, 0.03)
		bio.Text = (data.Bio and data.Bio ~= "") and data.Bio or "No description"
		theme:Set(bio, "TextColor3", (data.Bio and data.Bio ~= "") and "Text" or "SubText")
		reveal(bio, 0.08)
		setStats(data.Stats or {})
		setNames(data.PreviousNames)
		note.Text = data.Note or ""
		note.Visible = data.Note ~= nil and data.Note ~= ""
	end
	obj:SetLoading()
	return finish(obj, card)
end

function Page:Report(opts)
	opts = opts or {}
	local window = self.Window
	local theme = window.Theme
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = self:_next(),
		Parent = self.Content,
		list({ Padding = UDim.new(0, 12) }),
	})

	local hero = create("Frame", {
		Size = UDim2.new(1, 0, 0, 158),
		ClipsDescendants = true,
		LayoutOrder = 1,
		Parent = holder,
		corner(20),
	})
	theme:Bind(hero, { BackgroundColor3 = "GroupColor", BackgroundTransparency = "GroupT" })

	local bloom = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 46),
		Size = UDim2.fromOffset(180, 180),
		BackgroundTransparency = 1,
		Parent = hero,
		create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
	})
	local bloomShadow = newShadow(bloom, {
		BlurRadius = UDim.new(0, 96),
		Spread = UDim2.fromOffset(0, 0),
		ShowBehindParent = true,
		Transparency = 1,
	})
	local bloomCore = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 1),
		Size = UDim2.new(0.42, 0, 0, 3),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = hero,
		round(),
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	local coreShadow = newShadow(bloomCore, { BlurRadius = UDim.new(0, 14), ShowBehindParent = true, Transparency = 1 })

	local tag = label(theme, {
		Text = "",
		FontFace = Fonts.Medium,
		TextSize = 13,
		Position = UDim2.fromOffset(22, 20),
		Size = UDim2.new(1, -90, 0, 16),
		Parent = hero,
	})
	local value = label(theme, {
		Text = "",
		FontFace = Fonts.SemiBold,
		TextSize = 48,
		Position = UDim2.fromOffset(20, 38),
		Size = UDim2.new(1, -40, 0, 52),
		TextTruncate = Enum.TextTruncate.None,
		Parent = hero,
	})
	local caption = label(theme, {
		Text = "",
		TextSize = 14,
		Color = "SubText",
		Position = UDim2.fromOffset(22, 94),
		Size = UDim2.new(1, -44, 0, 18),
		Parent = hero,
	})
	local hint = label(theme, {
		Text = "",
		TextSize = 13,
		Color = "Muted",
		Position = UDim2.fromOffset(22, 114),
		Size = UDim2.new(1, -44, 0, 16),
		Parent = hero,
	})
	local details = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		LayoutOrder = 2,
		Parent = holder,
		corner(20),
		pad(18, 18, 18, 18),
		list({ Padding = UDim.new(0, 12) }),
	})
	theme:Bind(details, { BackgroundColor3 = "GroupColor", BackgroundTransparency = "GroupT" })

	local footer = label(theme, {
		Text = "",
		TextSize = 12,
		Color = "Muted",
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		LayoutOrder = 3,
		Parent = holder,
		pad(0, 6, 0, 6),
	})

	local motion = {}
	local counter
	local obj = {}

	local function stopMotion()
		for _, t in ipairs(motion) do
			t:Cancel()
		end
		table.clear(motion)
		if counter then
			counter:Disconnect()
			counter = nil
		end
	end

	local function setBloom(colorKey, strength)
		if bloomShadow then
			theme:Set(bloomShadow, "Color", colorKey, Ease.Smooth)
			tween(bloomShadow, Ease.Slow, { Transparency = 1 - strength })
		end
		theme:Set(bloomCore, "BackgroundColor3", colorKey, Ease.Smooth)
		tween(bloomCore, Ease.Slow, { BackgroundTransparency = math.max(0, 1 - strength * 1.3) })
		if coreShadow then
			theme:Set(coreShadow, "Color", colorKey, Ease.Smooth)
			tween(coreShadow, Ease.Slow, { Transparency = 1 - strength })
		end
		bloom.Size = UDim2.fromOffset(100, 100)
		tween(bloom, Ease.Slow, { Size = UDim2.fromOffset(190, 190) })
	end

	local statusDot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(22, 28),
		Size = UDim2.fromOffset(6, 6),
		BackgroundTransparency = 1,
		Parent = hero,
		round(),
	})
	local statusGlow = newShadow(statusDot, { BlurRadius = UDim.new(0, 10), ShowBehindParent = true, Transparency = 1 })
	local statusPulse

	local function setBadge(kind, colorKey)
		if statusPulse then
			statusPulse:Cancel()
			statusPulse = nil
		end
		if not kind or kind == "idle" then
			statusDot.BackgroundTransparency = 1
			if statusGlow then
				statusGlow.Transparency = 1
			end
			tag.Position = UDim2.fromOffset(22, 20)
			return
		end
		tag.Position = UDim2.fromOffset(35, 20)
		theme:Set(statusDot, "BackgroundColor3", colorKey)
		statusDot.BackgroundTransparency = 0
		if statusGlow then
			theme:Set(statusGlow, "Color", colorKey)
			statusGlow.Transparency = 0.3
			statusPulse = tween(statusGlow, Ease.Pulse, { Transparency = 0.75 })
		end
	end

	local function clearDetails()
		for _, child in ipairs(details:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		details.Visible = false
	end

	local function setFooter(text)
		footer.Text = text or ""
		footer.Visible = text ~= nil and text ~= ""
		if footer.Visible then
			reveal(footer, 0.2)
		end
	end

	local function bigValue(big)
		value.TextSize = big and 48 or 22
		value.FontFace = big and Fonts.SemiBold or Fonts.Medium
	end

	function obj:SetEmpty(message, sub)
		stopMotion()
		clearDetails()
		setFooter(nil)
		setBadge("idle")
		tag.Text = ""
		bigValue(false)
		theme:Set(value, "TextColor3", "Text")
		value.Text = message or opts.EmptyText or "Nothing yet"
		caption.Text = sub or opts.EmptyHint or ""
		hint.Text = ""
		reveal(value)
		reveal(caption, 0.05)
		setBloom("Accent", 0.28)
	end

	function obj:SetStatus(text)
		caption.Text = text or ""
	end

	function obj:SetLoading(text)
		stopMotion()
		clearDetails()
		setFooter(nil)
		setBadge(nil)
		tag.Text = ""
		bigValue(true)
		theme:Set(value, "TextColor3", "Muted")
		value.Text = "···"
		value.TextTransparency = 0
		caption.Text = text or opts.LoadingText or "Checking"
		caption.TextTransparency = 0
		hint.Text = ""
		table.insert(motion, tween(value, Ease.Pulse, { TextTransparency = 0.6 }))
		setBloom("Accent", 0.5)
		if bloomShadow then
			table.insert(motion, tween(bloomShadow, Ease.Pulse, { Transparency = 0.85 }))
		end
	end

	function obj:Set(data)
		stopMotion()
		clearDetails()
		data = data or {}
		local tone = data.Tone or "Accent"
		-- with Isle.Trace the report is built in slow steps, so a frozen frame points at one of them
		local function stage(name)
			if Isle.Trace then
				print("[Isle] report stage done: " .. name)
				task.wait(1.5)
			end
		end
		stage("cleared")
		details.Visible = Isle.Trace == true

		tag.Text = data.Tag or ""
		theme:Set(tag, "TextColor3", tone)
		reveal(tag)

		bigValue(true)
		theme:Set(value, "TextColor3", "Text")
		value.TextTransparency = 0
		if type(data.Value) == "number" then
			local target = data.Value
			local start = os.clock()
			value.Text = "0"
			counter = RunService.RenderStepped:Connect(function()
				local t = math.min((os.clock() - start) / 0.8, 1)
				local e = 1 - (1 - t) ^ 4
				value.Text = commas(math.floor(target * e + 0.5))
				if t >= 1 and counter then
					counter:Disconnect()
					counter = nil
				end
			end)
		else
			value.Text = tostring(data.Value or "")
			reveal(value)
		end

		caption.Text = data.Caption or ""
		hint.Text = data.Hint or ""
		reveal(caption, 0.05)
		reveal(hint, 0.08)

		setBadge(({ Safe = "check", Danger = "alert", Warning = "alert" })[tone], tone)
		setBloom(tone, 0.75)
		stage("header")

		local order = 0
		local function nextOrder()
			order += 1
			return order
		end
		local function heading(text, right)
			local row = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 16),
