				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	local coreShadow = newShadow(bloomCore, { BlurRadius = UDim.new(0, 14), ShowBehindParent = true, Transparency = 1 })

	local tag = label(theme, {
		Text = "",
		FontFace = Fonts.Medium,
		TextSize = 13,
		Position = UDim2.fromOffset(22, 20),
		Size = UDim2.new(1, -90, 0, 16),
		Parent = hero,
	})
	local value = label(theme, {
		Text = "",
		FontFace = Fonts.SemiBold,
		TextSize = 46,
		Position = UDim2.fromOffset(20, 38),
		Size = UDim2.new(1, -90, 0, 50),
		TextTruncate = Enum.TextTruncate.None,
		Parent = hero,
	})
	local caption = label(theme, {
		Text = "",
		TextSize = 14,
		Color = "SubText",
		Position = UDim2.fromOffset(22, 92),
		Size = UDim2.new(1, -44, 0, 18),
		Parent = hero,
	})
	local hint = label(theme, {
		Text = "",
		TextSize = 13,
		Color = "Muted",
		Position = UDim2.fromOffset(22, 112),
		Size = UDim2.new(1, -44, 0, 16),
		Parent = hero,
	})
	local details = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		LayoutOrder = 2,
		Parent = holder,
		corner(20),
		pad(18, 18, 18, 18),
		list({ Padding = UDim.new(0, 12) }),
	})
	theme:Bind(details, { BackgroundColor3 = "GroupColor", BackgroundTransparency = "GroupT" })

	local footer = label(theme, {
		Text = "",
		TextSize = 12,
		Color = "Muted",
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		LayoutOrder = 3,
		Parent = holder,
		pad(0, 6, 0, 6),
	})

	local motion = {}
	local counter
	local obj = {}

	local function stopMotion()
		for _, t in ipairs(motion) do
			t:Cancel()
		end
		table.clear(motion)
		if counter then
			counter:Disconnect()
			counter = nil
		end
	end

	local function setBloom(colorKey, strength)
		if bloomShadow then
			theme:Set(bloomShadow, "Color", colorKey)
			tween(bloomShadow, Ease.Slow, { Transparency = 1 - strength })
		end
		theme:Set(bloomCore, "BackgroundColor3", colorKey)
		tween(bloomCore, Ease.Slow, { BackgroundTransparency = math.max(0, 1 - strength * 1.3) })
		if coreShadow then
			theme:Set(coreShadow, "Color", colorKey)
			tween(coreShadow, Ease.Slow, { Transparency = 1 - strength })
		end
		bloom.Size = UDim2.fromOffset(110, 110)
		tween(bloom, Ease.Slow, { Size = UDim2.fromOffset(180, 180) })
	end

	local statusDot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(22, 28),
		Size = UDim2.fromOffset(6, 6),
		BackgroundTransparency = 1,
		Parent = hero,
		round(),
	})
	local statusGlow = newShadow(statusDot, { BlurRadius = UDim.new(0, 10), ShowBehindParent = true, Transparency = 1 })
	local statusPulse

	local function setBadge(kind, colorKey)
		if statusPulse then
			statusPulse:Cancel()
			statusPulse = nil
		end
		if not kind or kind == "idle" then
			statusDot.BackgroundTransparency = 1
			if statusGlow then
				statusGlow.Transparency = 1
			end
			tag.Position = UDim2.fromOffset(22, 20)
			return
		end
		tag.Position = UDim2.fromOffset(35, 20)
		theme:Set(statusDot, "BackgroundColor3", colorKey)
		statusDot.BackgroundTransparency = 0
		if statusGlow then
			theme:Set(statusGlow, "Color", colorKey)
			statusGlow.Transparency = 0.3
			statusPulse = tween(statusGlow, Ease.Pulse, { Transparency = 0.75 })
		end
	end

	local function reveal(inst, delay)
		inst.TextTransparency = 1
		task.delay(delay or 0, function()
			if inst.Parent then
				tween(inst, Ease.Slow, { TextTransparency = 0 })
			end
		end)
	end

	local function clearDetails()
		for _, child in ipairs(details:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		details.Visible = false
	end

	local function setFooter(text)
		footer.Text = text or ""
		footer.Visible = text ~= nil and text ~= ""
		if footer.Visible then
			reveal(footer, 0.2)
		end
	end

	local function bigValue(big)
		value.TextSize = big and 46 or 22
		value.FontFace = big and Fonts.SemiBold or Fonts.Medium
	end

	function obj:SetEmpty(message, sub)
		stopMotion()
		clearDetails()
		setFooter(nil)
		setBadge("idle")
		tag.Text = ""
		bigValue(false)
		theme:Set(value, "TextColor3", "Text")
		value.Text = message or opts.EmptyText or "Nothing yet"
		caption.Text = sub or opts.EmptyHint or ""
		hint.Text = ""
		reveal(value)
		reveal(caption, 0.05)
		setBloom("Accent", 0.3)
	end

	function obj:SetStatus(text)
		caption.Text = text or ""
	end

	function obj:SetLoading(text)
		stopMotion()
		clearDetails()
		setFooter(nil)
		setBadge(nil)
		tag.Text = ""
		bigValue(true)
		theme:Set(value, "TextColor3", "Muted")
		value.Text = "···"
		value.TextTransparency = 0
		caption.Text = text or opts.LoadingText or "Checking"
		caption.TextTransparency = 0
		hint.Text = ""
		table.insert(motion, tween(value, Ease.Pulse, { TextTransparency = 0.6 }))
		setBloom("Accent", 0.5)
		if bloomShadow then
			table.insert(motion, tween(bloomShadow, Ease.Pulse, { Transparency = 0.85 }))
		end
	end

	function obj:Set(data)
		stopMotion()
		clearDetails()
		data = data or {}
		local tone = data.Tone or "Accent"

		tag.Text = data.Tag or ""
		theme:Set(tag, "TextColor3", tone)
		reveal(tag)

		bigValue(true)
		theme:Set(value, "TextColor3", "Text")
		value.TextTransparency = 0
		if type(data.Value) == "number" then
			local target = data.Value
			local start = os.clock()
			value.Text = "0"
			counter = RunService.RenderStepped:Connect(function()
				local t = math.min((os.clock() - start) / 0.8, 1)
				local e = 1 - (1 - t) ^ 4
				value.Text = commas(math.floor(target * e + 0.5))
				if t >= 1 and counter then
					counter:Disconnect()
					counter = nil
				end
			end)
		else
			value.Text = tostring(data.Value or "")
			reveal(value)
		end

		caption.Text = data.Caption or ""
		hint.Text = data.Hint or ""
		reveal(caption, 0.05)
		reveal(hint, 0.08)

		setBadge(({ Safe = "check", Danger = "alert", Warning = "alert" })[tone], tone)
		setBloom(tone, 0.75)

		local order = 0
		local function nextOrder()
			order += 1
			return order
		end
		local function heading(text, right)
			local row = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 16),
				LayoutOrder = nextOrder(),
				Parent = details,
			})
			local h = label(theme, {
				Text = text,
				FontFace = Fonts.Medium,
				TextSize = 13,
				Color = "Muted",
				Size = UDim2.new(1, -80, 1, 0),
				Parent = row,
			})
			reveal(h, 0.1)
			if right then
				local r = label(theme, {
					Text = right,
					FontFace = Fonts.Medium,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Right,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.fromScale(1, 0),
					Size = UDim2.new(0, 80, 1, 0),
					Parent = row,
				})
				reveal(r, 0.1)
			end
		end
		local function divider()
			local d = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 1),
				LayoutOrder = nextOrder(),
				Parent = details,
			})
			hairline(theme, d, 0)
		end

		local sections = 0
		local function begin()
			if sections > 0 then
				divider()
			end
			sections += 1
		end

		if data.Meter then
			begin()
			local meter = data.Meter
			local pct = math.clamp((meter.Value or 0) / (meter.Max or 100), 0, 1)
			local meterTone = meter.Tone or tone
			heading(meter.Label or "Score", tostring(meter.Value or 0) .. " / " .. tostring(meter.Max or 100))
			local track = create("Frame", {
				Size = UDim2.new(1, 0, 0, 8),
				LayoutOrder = nextOrder(),
				Parent = details,
				round(),
			})
			theme:Bind(track, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
			local fillBar = create("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track, round() })
			theme:Bind(fillBar, { BackgroundColor3 = meterTone })
			local glow = newShadow(fillBar, { BlurRadius = UDim.new(0, 12), Transparency = 0.55, ShowBehindParent = true })
			if glow then
				theme:Bind(glow, { Color = meterTone })
			end
			task.delay(0.15, function()
				if fillBar.Parent then
					tween(fillBar, Ease.Slow, { Size = UDim2.fromScale(math.max(pct, 0.02), 1) })
				end
			end)
			if meter.Caption then
				local c = label(theme, {
					Text = meter.Caption,
					TextSize = 13,
					Color = "SubText",
					Size = UDim2.new(1, 0, 0, 16),
					LayoutOrder = nextOrder(),
					Parent = details,
				})
				reveal(c, 0.15)
			end
		end

		if data.Chips and #data.Chips > 0 then
			begin()
			heading(data.ChipsTitle or "Exposed data")
			local chips = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = nextOrder(),
				Parent = details,
				list({
					FillDirection = Enum.FillDirection.Horizontal,
					Wraps = true,
					Padding = UDim.new(0, 6),
				}),
			})
			for i, chipText in ipairs(data.Chips) do
				local chip = create("Frame", {
					Size = UDim2.new(0, 0, 0, 28),
					AutomaticSize = Enum.AutomaticSize.X,
					LayoutOrder = i,
					Parent = chips,
					round(),
					pad(0, 12, 0, 12),
				})
				theme:Bind(chip, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
				local chipLabel = label(theme, {
					Text = chipText,
					FontFace = Fonts.Medium,
					TextSize = 13,
					Color = "SubText",
					AutomaticSize = Enum.AutomaticSize.X,
					Size = UDim2.new(0, 0, 1, 0),
					TextTruncate = Enum.TextTruncate.None,
					Parent = chip,
				})
				reveal(chipLabel, 0.1 + math.min(i, 10) * 0.02)
			end
		end

		local groups = {}
		if data.Rows and #data.Rows > 0 then
			table.insert(groups, { Title = data.RowsTitle or "Sources", Count = data.RowsCount, Rows = data.Rows })
		end
		for _, group in ipairs(data.Sections or {}) do
			if group.Rows and #group.Rows > 0 then
				table.insert(groups, group)
			end
		end
		for _, group in ipairs(groups) do
			begin()
			heading(group.Title or "", group.Count)
			local rows = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = nextOrder(),
				Parent = details,
				list({ Padding = UDim.new(0, 0) }),
			})
			for i, rowData in ipairs(group.Rows) do
				local hasSub = rowData.Subtitle and rowData.Subtitle ~= ""
				local row = create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, hasSub and 54 or 40),
					LayoutOrder = i,
					Parent = rows,
				})
				if i > 1 then
					hairline(theme, row, 0)
				end
				local delay = 0.12 + math.min(i, 12) * 0.03
				local title = label(theme, {
					Text = rowData.Title or "",
					FontFace = Fonts.Medium,
					TextSize = 14,
					Position = UDim2.fromOffset(0, hasSub and 10 or 0),
					Size = UDim2.new(1, -116, 0, hasSub and 18 or 40),
					Parent = row,
				})
				local right = label(theme, {
					Text = rowData.Right or "",
					TextSize = 13,
					Color = rowData.RightColor or "Muted",
					TextXAlignment = Enum.TextXAlignment.Right,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, hasSub and 10 or 0),
					Size = UDim2.fromOffset(110, hasSub and 18 or 40),
					Parent = row,
				})
				reveal(title, delay)
				reveal(right, delay)
				if hasSub then
					local sub = label(theme, {
						Text = rowData.Subtitle,
						TextSize = 13,
						Color = "SubText",
						Position = UDim2.fromOffset(0, 29),
						Size = UDim2.new(1, 0, 0, 16),
						Parent = row,
					})
					reveal(sub, delay)
				end
			end
		end

		if data.Tips and #data.Tips > 0 then
			begin()
			heading(data.TipsTitle or "What to do")
			local tips = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = nextOrder(),
				Parent = details,
				list({ Padding = UDim.new(0, 8) }),
			})
			for i, tipText in ipairs(data.Tips) do
				local tip = create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = i,
					Parent = tips,
				})
				local mark = create("Frame", { Position = UDim2.fromOffset(1, 7), Size = UDim2.fromOffset(5, 5), Parent = tip, round() })
				theme:Bind(mark, { BackgroundColor3 = tone })
				local tipLabel = label(theme, {
					Text = tipText,
					TextSize = 14,
					TextWrapped = true,
					TextTruncate = Enum.TextTruncate.None,
					TextYAlignment = Enum.TextYAlignment.Top,
					Position = UDim2.fromOffset(16, 0),
					Size = UDim2.new(1, -16, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Parent = tip,
				})
				reveal(tipLabel, 0.15 + i * 0.04)
			end
		end

		if data.Actions and #data.Actions > 0 then
			begin()
			local actions = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 34),
				LayoutOrder = nextOrder(),
				Parent = details,
				list({
					FillDirection = Enum.FillDirection.Horizontal,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					Padding = UDim.new(0, 8),
				}),
			})
			for i, action in ipairs(data.Actions) do
				local btn = create("TextButton", {
					Text = "",
					AutoButtonColor = false,
					Size = UDim2.new(0, 0, 0, 34),
					AutomaticSize = Enum.AutomaticSize.X,
					LayoutOrder = i,
					Parent = actions,
					corner(10),
					pad(0, 14, 0, 14),
				})
				theme:Bind(btn, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
				label(theme, {
					Text = action.Title or "",
					FontFace = Fonts.Medium,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextTruncate = Enum.TextTruncate.None,
					AutomaticSize = Enum.AutomaticSize.X,
					Size = UDim2.new(0, 0, 1, 0),
					Parent = btn,
				})
				btn.MouseEnter:Connect(function()
					tween(btn, Ease.Hover, { BackgroundTransparency = theme:Get("FieldT") - 0.03 })
				end)
				btn.MouseLeave:Connect(function()
					tween(btn, Ease.Hover, { BackgroundTransparency = theme:Get("FieldT") })
				end)
				btn.MouseButton1Click:Connect(function()
					fire(action.Callback)
				end)
			end
		end

		details.Visible = order > 0
		setFooter(data.Footer)
	end

	obj:SetEmpty()
	return finish(obj, holder)
end

return Isle
