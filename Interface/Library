local function tween(obj, info, goal)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

local function create(class, props)
	local inst = Instance.new(class)
	local parent
	for key, value in pairs(props or {}) do
		if type(key) == "number" then
			value.Parent = inst
		elseif key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function round()
	return create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

local function pad(t, r, b, l)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t),
		PaddingLeft = UDim.new(0, l or r or t),
	})
end

local function list(props)
	props = props or {}
	props.SortOrder = Enum.SortOrder.LayoutOrder
	return create("UIListLayout", props)
end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function damp(rate, dt)
	return 1 - math.exp(-rate * dt)
end

local function commas(n)
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end
Isle.Format = commas

local function isPress(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

local function isMove(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch
end

local function fire(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(fn, table.unpack(args, 1, args.n))
		if not ok then
			warn("[Isle] " .. tostring(err))
		end
	end)
end

local function newShadow(parent, props)
	local ok, inst = pcall(Instance.new, "UIShadow")
	if not ok then
		return nil
	end
	for key, value in pairs(props) do
		pcall(function()
			inst[key] = value
		end)
	end
	inst.Parent = parent
	return inst
end

local function mount(gui)
	local ok = false
	if type(gethui) == "function" then
		ok = pcall(function()
			gui.Parent = gethui()
		end)
	end
	if not ok then
		ok = pcall(function()
			gui.Parent = game:GetService("CoreGui")
		end)
	end
	if not ok or not gui.Parent then
		gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
end

local function textWidth(value, font, size)
	local params = Instance.new("GetTextBoundsParams")
	params.Text = value
	params.Font = font
	params.Size = size
	params.Width = 10000
	local ok, bounds = pcall(TextService.GetTextBoundsAsync, TextService, params)
	if ok and bounds then
		return bounds.X
	end
	return #value * size * 0.5
end

local Theme = {}
Theme.__index = Theme

function Theme.new(name)
	return setmetatable({ Name = name, Registry = {}, Listeners = {} }, Theme)
end

function Theme:Get(key)
	return Themes[self.Name][key]
end

function Theme:Bind(inst, map)
	local entry = self.Registry[inst]
	if not entry then
		entry = {}
		self.Registry[inst] = entry
	end
	for prop, key in pairs(map) do
		entry[prop] = key
		inst[prop] = self:Get(key)
	end
	return inst
end

function Theme:Set(inst, prop, key, info)
	local entry = self.Registry[inst]
	if not entry then
		entry = {}
		self.Registry[inst] = entry
	end
	entry[prop] = key
	if info then
		tween(inst, info, { [prop] = self:Get(key) })
	else
		inst[prop] = self:Get(key)
	end
end

function Theme:Unbind(inst, prop)
	local entry = self.Registry[inst]
	if entry then
		entry[prop] = nil
	end
end

function Theme:Apply(animated)
	for inst, entry in pairs(self.Registry) do
		if inst.Parent == nil then
			self.Registry[inst] = nil
		else
			local goal = {}
			for prop, key in pairs(entry) do
				goal[prop] = self:Get(key)
			end
			if animated then
				tween(inst, Ease.Theme, goal)
			else
				for prop, value in pairs(goal) do
					inst[prop] = value
				end
			end
		end
	end
	for _, fn in ipairs(self.Listeners) do
		fn(animated)
	end
end

function Theme:OnChanged(fn)
	table.insert(self.Listeners, fn)
end

local function label(theme, props)
	local colorKey = props.Color or "Text"
	local class = props.Class or "TextLabel"
	props.Color = nil
	props.Class = nil
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Fonts.Regular,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	for key, value in pairs(defaults) do
		if props[key] == nil then
			props[key] = value
		end
	end
	local inst = create(class, props)
	theme:Bind(inst, { TextColor3 = colorKey })
	return inst
end

