local function newDots(theme, parent, width, maxHeight)
	local GAP = 22
	local SIZE = 2
	local REACH = 150
	local WARP = 5
	local EDGE = 0.18

	local canvas = create("CanvasGroup", {
		Name = "Dots",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = parent,
		corner(RADIUS),
	})
	local spot = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = canvas,
		round(),
	})
	local spotShadow = newShadow(spot, { BlurRadius = UDim.new(0, 260), ShowBehindParent = true, Transparency = 1 })
	local layer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = canvas })

	local function snapshot()
		return {
			Dot = theme:Get("Dot"),
			Accent = theme:Get("DotAccent"),
			Base = theme:Get("DotBase"),
			Lit = theme:Get("DotLit"),
			Spot = theme:Get("Spot"),
		}
	end

	local colors = snapshot()
	local height = 100
	local cols = math.max(2, math.floor(width / GAP))
	local startX = (width - (cols - 1) * GAP) / 2
	local rows = 0
	local grid = {}
	local all = {}

	for c = 1, cols do
		grid[c] = {}
		local x = startX + (c - 1) * GAP
		local r = 1
		local y = startX
		while y < maxHeight do
			local frame = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(SIZE, SIZE),
				BorderSizePixel = 0,
				BackgroundColor3 = colors.Dot,
				BackgroundTransparency = 1,
				Parent = layer,
			})
			local dot = { Frame = frame, X = x, Y = y, Base = 1 }
			grid[c][r] = dot
			table.insert(all, dot)
			rows = math.max(rows, r)
			r += 1
			y += GAP
		end
	end

	local function edgeFactor(pos, length)
		local fade = EDGE * length
		if fade <= 0 then
			return 1
		end
		return smooth(math.min(pos, length - pos) / fade)
	end

	local dirty = true
	local lit = {}
	local from, to, progress = nil, nil, 1
	theme:OnChanged(function(animated)
		if animated then
			from, to, progress = table.clone(colors), snapshot(), 0
		else
			colors = snapshot()
			dirty = true
		end
	end)

	local enabled = true
	local intensity = 0
	local smoothPos = Vector2.zero
	local api = { Canvas = canvas }

	function api.SetHeight(h)
		if math.abs(h - height) > 0.25 then
			height = h
			dirty = true
		end
	end

	function api.SetEnabled(value)
		enabled = value
	end

	function api.Step(dt, mouse, hovering)
		if progress < 1 then
			progress = math.min(1, progress + dt / 0.6)
			local a = smooth(progress)
			colors.Dot = from.Dot:Lerp(to.Dot, a)
			colors.Accent = from.Accent:Lerp(to.Accent, a)
			colors.Base = from.Base + (to.Base - from.Base) * a
			colors.Lit = from.Lit + (to.Lit - from.Lit) * a
			colors.Spot = from.Spot + (to.Spot - from.Spot) * a
			dirty = true
		end

		local inside = enabled and hovering and mouse.X >= 0 and mouse.Y >= 0 and mouse.X <= width and mouse.Y <= height
		intensity += ((inside and 1 or 0) - intensity) * damp(inside and 6 or 4, dt)
		if intensity < 0.01 then
			smoothPos = mouse
		else
			smoothPos = smoothPos:Lerp(mouse, damp(12, dt))
		end

		if dirty then
			dirty = false
			for _, dot in ipairs(all) do
				dot.Base = 1 - (1 - colors.Base) * edgeFactor(dot.X, width) * edgeFactor(dot.Y, height)
				if not lit[dot] then
					dot.Frame.BackgroundTransparency = dot.Base
					dot.Frame.BackgroundColor3 = colors.Dot
				end
			end
		end

		local active = intensity > 0.005
		spot.Visible = active and spotShadow ~= nil
		if active and spotShadow then
			spot.Position = UDim2.fromOffset(smoothPos.X, smoothPos.Y)
			spotShadow.Color = colors.Accent
			spotShadow.Transparency = 1 - (1 - colors.Spot) * intensity
		end

		local nowLit = {}
		if active then
			local c0 = math.max(1, math.floor((smoothPos.X - REACH - startX) / GAP) + 1)
			local c1 = math.min(cols, math.ceil((smoothPos.X + REACH - startX) / GAP) + 1)
			local r0 = math.max(1, math.floor((smoothPos.Y - REACH - startX) / GAP) + 1)
			local r1 = math.min(rows, math.ceil((smoothPos.Y + REACH - startX) / GAP) + 1)
			for c = c0, c1 do
				local column = grid[c]
				for r = r0, r1 do
					local dot = column and column[r]
					if dot then
						local dx, dy = dot.X - smoothPos.X, dot.Y - smoothPos.Y
						local dist = math.sqrt(dx * dx + dy * dy)
						if dist < REACH then
							local shape = smooth(1 - dist / REACH)
							local power = shape * intensity
							local push = dist > 0.5 and WARP * shape * shape * intensity / dist or 0
							local frame = dot.Frame
							frame.BackgroundTransparency = dot.Base + (colors.Lit - dot.Base) * power
							frame.BackgroundColor3 = colors.Dot:Lerp(colors.Accent, shape)
							frame.Position = UDim2.fromOffset(dot.X + dx * push, dot.Y + dy * push)
							local s = SIZE + power * 0.6
							frame.Size = UDim2.fromOffset(s, s)
							nowLit[dot] = true
						end
					end
				end
			end
		end

		for dot in pairs(lit) do
			if not nowLit[dot] then
				local frame = dot.Frame
				frame.BackgroundTransparency = dot.Base
				frame.BackgroundColor3 = colors.Dot
				frame.Position = UDim2.fromOffset(dot.X, dot.Y)
				frame.Size = UDim2.fromOffset(SIZE, SIZE)
			end
		end
		lit = nowLit
	end

	return api
end

local function newEdgeLights(theme, card)
	local parts = {}
	for _, side in ipairs({ 0, 1 }) do
		local light = create("Frame", {
			Name = "EdgeLight",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(side, 0.5),
			Size = UDim2.new(0, 1.5, 0.46, 0),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = card,
			create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})
		local glow = newShadow(light, {
			Color = WHITE,
			BlurRadius = UDim.new(0, 16),
			Spread = UDim2.fromOffset(1, 0),
			ShowBehindParent = true,
			Transparency = 1,
		})
		table.insert(parts, { Light = light, Glow = glow })
	end
	return function(level)
		for _, part in ipairs(parts) do
			part.Light.BackgroundTransparency = level
			if part.Glow then
				part.Glow.Transparency = 0.35 + 0.65 * level
			end
		end
	end
end

