		LayoutOrder = 6,
		Parent = card,
	})

	local function reveal(inst, delay)
		inst.TextTransparency = 1
		task.delay(delay or 0, function()
			if inst.Parent then
				tween(inst, Ease.Slow, { TextTransparency = 0 })
			end
		end)
	end

	local function setStats(list_)
		for _, child in ipairs(stats:GetChildren()) do
			child:Destroy()
		end
		local n = math.max(#list_, 1)
		for i, stat in ipairs(list_) do
			local cell = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Position = UDim2.new((i - 1) / n, i == 1 and 0 or 2, 0, 0),
				Size = UDim2.new(1 / n, i == 1 and -2 or -4, 1, 0),
				Parent = stats,
				corner(10),
			})
			if not stat.Callback then
				cell:SetAttribute("IsleStatic", true)
			end
			theme:Bind(cell, { BackgroundColor3 = "HoverColor" })
			local pad_ = stat.Callback and 8 or 0
			local value = label(theme, {
				Text = tostring(stat.Value or "—"),
				FontFace = Fonts.SemiBold,
				TextSize = 16,
				Position = UDim2.fromOffset(pad_, 4),
				Size = UDim2.new(1, -pad_ * 2, 0, 20),
				Parent = cell,
			})
			local caption = label(theme, {
				Text = stat.Label or "",
				TextSize = 12,
				Color = "Muted",
				Position = UDim2.fromOffset(pad_, 25),
				Size = UDim2.new(1, -pad_ * 2, 0, 16),
				Parent = cell,
			})
			if stat.Callback then
				local arrow = chevron(theme, cell, "Muted", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -6, 0, 33),
					Size = UDim2.fromOffset(10, 10),
				})
				arrow.Visible = false
				cell.MouseEnter:Connect(function()
					tween(cell, Ease.Hover, { BackgroundTransparency = theme:Get("HoverT") - 0.01 })
					arrow.Visible = true
				end)
				cell.MouseLeave:Connect(function()
					tween(cell, Ease.Hover, { BackgroundTransparency = 1 })
					arrow.Visible = false
				end)
				cell.MouseButton1Click:Connect(function()
					fire(stat.Callback)
				end)
			end
			reveal(value, 0.04 * i)
			reveal(caption, 0.04 * i)
		end
	end

	local function setNames(list_)
		for _, child in ipairs(names:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if not list_ or #list_ == 0 then
			local none = label(theme, {
				Text = "None",
				TextSize = 14,
				Color = "SubText",
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 0, 20),
				TextTruncate = Enum.TextTruncate.None,
				Parent = names,
			})
			reveal(none, 0.1)
			return
		end
		for i, name in ipairs(list_) do
			local chip = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(0, 0, 0, 28),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = i,
				Parent = names,
				round(),
				pad(0, 12, 0, 12),
			})
			theme:Bind(chip, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
			local text = label(theme, {
				Text = name,
				FontFace = Fonts.Medium,
				TextSize = 13,
				Color = "SubText",
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 1, 0),
				TextTruncate = Enum.TextTruncate.None,
				Parent = chip,
			})
			chip.MouseEnter:Connect(function()
				theme:Set(text, "TextColor3", "Text", Ease.Hover)
			end)
			chip.MouseLeave:Connect(function()
				theme:Set(text, "TextColor3", "SubText", Ease.Hover)
			end)
			chip.MouseButton1Click:Connect(function()
				if opts.OnCopy then
					fire(opts.OnCopy, name)
				end
			end)
			reveal(text, 0.1 + math.min(i, 10) * 0.02)
		end
	end

	local obj = {}
	function obj:SetLoading(name)
		current = {}
		avatar.Image = ""
		displayName.Text = name or "Loading"
		theme:Set(displayName, "TextColor3", "Muted")
		userName.Text = ""
		bio.Text = "…"
		setStats({
			{ Label = "Joined", Value = "…" },
			{ Label = "Age", Value = "…" },
			{ Label = "Friends", Value = "…" },
			{ Label = "Followers", Value = "…" },
			{ Label = "Following", Value = "…" },
		})
		setNames({})
		note.Visible = false
	end
	function obj:Set(data)
		data = data or {}
		current = { DisplayName = data.DisplayName, Name = data.Name }
		avatar.Image = data.Image or ""
		displayName.Text = data.DisplayName or ""
		theme:Set(displayName, "TextColor3", "Text")
		userName.Text = data.Name and ("@" .. data.Name) or ""
		reveal(displayName)
		reveal(userName, 0.03)
		bio.Text = (data.Bio and data.Bio ~= "") and data.Bio or "No description"
		theme:Set(bio, "TextColor3", (data.Bio and data.Bio ~= "") and "Text" or "SubText")
		reveal(bio, 0.08)
		setStats(data.Stats or {})
		setNames(data.PreviousNames)
		note.Text = data.Note or ""
		note.Visible = data.Note ~= nil and data.Note ~= ""
	end
	obj:SetLoading()
	return finish(obj, card)
end

