function Isle.new(options)
	options = options or {}
	local theme = Theme.new(Themes[options.Theme] and options.Theme or "Dark")
	local W = options.Width or 520
	local maxW = math.max(W, options.WideWidth or W)
	local minHeight = options.MinHeight or 220

	local window = setmetatable({
		Theme = theme,
		Width = W,
		MinHeight = minHeight,
		MaxHeight = options.MaxHeight or 620,
		ToggleKey = options.ToggleKey or Enum.KeyCode.RightControl,
		Pages = {},
		Visible = true,
		_vis = 0,
		_height = minHeight,
		_width = W,
		_edge = 1,
		UserScale = math.clamp(options.Scale or 1.2, 0.8, 1.6),
		MinScale = 0.8,
		MaxScale = 1.6,
		_connections = {},
		_steppers = {},
		_toasts = {},
		_history = {},
		_backShown = false,
		_modals = 0,
	}, Window)

	local gui = create("ScreenGui", {
		Name = "Isle",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
