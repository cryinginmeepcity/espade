		if primary then
			theme:Bind(btn, { BackgroundColor3 = "Primary", BackgroundTransparency = "Opaque" })
		else
			theme:Bind(btn, { BackgroundColor3 = "HoverColor" })
			hoverFill(theme, btn, "Clear", "HoverT", "PressT")
		end
		pressable(btn, 0.95)
		local icon, textLabel
		if text then
			local inner = create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				ZIndex = 31,
				Parent = btn,
				pad(0, 14, 0, iconName and 11 or 14),
				list({
					FillDirection = Enum.FillDirection.Horizontal,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					Padding = UDim.new(0, 7),
				}),
			})
