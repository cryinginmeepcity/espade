	local reserve = rightWidth > 0 and rightWidth + 34 or 28
	local title = label(theme, {
		Text = opts.Title or "",
		FontFace = Fonts.Medium,
		TextSize = 15,
		Position = UDim2.fromOffset(14, hasDesc and 11 or 0),
		Size = UDim2.new(1, -reserve, 0, hasDesc and 20 or height),
