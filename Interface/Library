	obj:SetEmpty()
	return finish(obj, holder)
end

function Page:Board(opts)
	opts = opts or {}
	self.FullHeight = true
	local page = self
	local window = self.Window
	local theme = window.Theme
	local types = opts.Types or {}
	local NODE_W, NODE_H = 208, 60
	local WIRE = 2
	local PANEL_W = 320
	local ZOOM_MIN, ZOOM_MAX = 0.4, 2
	local SNAP = 20
	local sources = opts.Sources or {}

	local function typeOf(key)
		return types[key] or { Label = "Node", Color = theme:Get("Accent") }
	end
	local function scaleNow()
		return window.Scale.Scale > 0 and window.Scale.Scale or 1
	end
	local function snap(value)
		return math.floor(value / SNAP + 0.5) * SNAP
	end
	local function deepCopy(value)
		if type(value) ~= "table" then
			return value
		end
		local out = {}
		for k, v in pairs(value) do
			out[k] = deepCopy(v)
		end
		return out
	end

	local history = { Undo = {}, Redo = {}, Busy = false }
	local snapshot
	local function changed(viewOnly)
		if history.Busy then
			return
		end
		if not viewOnly and snapshot then
			if history.Last then
				table.insert(history.Undo, history.Last)
				if #history.Undo > 60 then
					table.remove(history.Undo, 1)
				end
			end
			history.Last = snapshot()
			table.clear(history.Redo)
		end
		if opts.OnChange then
			fire(opts.OnChange)
		end
	end

	local viewport = create("Frame", {
		Name = "Board",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		Parent = self.Canvas,
	})
	local bg = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = viewport,
	})
	local pathLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), ZIndex = 2, Parent = viewport })
	local panFrame = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), ZIndex = 3, Parent = viewport })
	local world = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), Parent = panFrame })
	local worldScale = create("UIScale", { Parent = world })
	local edgesLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), ZIndex = 1, Parent = world })
	local linkLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), ZIndex = 2, Parent = world })
	local nodesLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), ZIndex = 3, Parent = world })

	local nodes = {}
	local edges = {}
	local pan, zoom = Vector2.zero, 1
	local targetPan, targetZoom = Vector2.zero, 1
	local selected, selectedEdge
	local nodeSeq, edgeSeq = 0, 0
	local grabbed
	local linkTarget
	local panelOpen = false
	local panelOffset = PANEL_W + 30
	local zoomLabel
	local chipZoom = 1
	local subjectId
	local subjectDirty = false
	local arranging = {}

	local canvas = { Frame = viewport, Nodes = nodes, Edges = edges }

	local syncView
	local function applyView()
		panFrame.Position = UDim2.fromOffset(pan.X, pan.Y)
		worldScale.Scale = zoom
		if syncView then
			syncView()
		end
		if zoom ~= chipZoom then
			chipZoom = zoom
			local k = math.max(1, 0.8 / zoom)
			for _, edge in pairs(edges) do
				edge.ChipScale.Scale = k
			end
		end
		if zoomLabel then
			zoomLabel.Text = tostring(math.floor(targetZoom * 100 + 0.5)) .. "%"
		end
	end

	local function localPointer()
		return (window._pointer() - viewport.AbsolutePosition) / scaleNow()
	end

	local function viewSize()
		return viewport.AbsoluteSize / scaleNow()
	end

	local function worldPoint()
		return (localPointer() - pan) / zoom
	end

	local function fineZoom()
		return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
	end

	local function zoomTo(value, focus)
		value = math.clamp(value, ZOOM_MIN, ZOOM_MAX)
		focus = focus or viewSize() / 2
		local anchor = (focus - targetPan) / targetZoom
		targetZoom = value
		targetPan = focus - anchor * value
		applyView()
	end

	local wireAlpha = 0

	local function newSegment(parent, colorKey)
		local seg = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(WIRE, WIRE),
			Visible = false,
			Parent = parent,
			round(),
		})
		theme:Bind(seg, { BackgroundColor3 = colorKey })
		seg.BackgroundTransparency = 1 - wireAlpha
		return seg
	end

	local function placeSegment(seg, a, b)
		local d = b - a
		local mid = (a + b) / 2
		seg.Size = UDim2.fromOffset(d.Magnitude + WIRE, WIRE)
		seg.Position = UDim2.fromOffset(mid.X, mid.Y)
		seg.Rotation = math.deg(math.atan2(d.Y, d.X))
		seg.Visible = true
	end

	local pathsBroken = false
	local pathWires = {}
	local repaintUntil = 0
	local wireProgress = 0
	local jitter = 0

	-- fades with transparency and with a colour blend from the card, whichever the engine honours
	local function fadePath(wire)
		local path = wire.Path
		if not path then
			return
		end
		pcall(function()
			path.Transparency = 1 - wireAlpha
		end)
		if wireAlpha < 1 then
			wire.Blended = true
			theme:Unbind(path, "Color3")
			path.Color3 = theme:Get("Background"):Lerp(theme:Get(wire.Key), wireAlpha)
		elseif wire.Blended then
			wire.Blended = false
			theme:Set(path, "Color3", wire.Key)
		end
		path.Visible = wireAlpha > 0.01 and not wire.Hidden
	end

	local function fadeWire(wire)
		fadePath(wire)
		local t = 1 - wireAlpha
		for _, seg in ipairs(wire.Segments) do
			seg.BackgroundTransparency = t
		end
		if wire.ArrowA then
			wire.ArrowA.BackgroundTransparency = t
			wire.ArrowB.BackgroundTransparency = t
		end
	end

	-- Path2D ignores UIScale, so its points are converted to screen pixels by hand
	local function setPath(wire)
		local bez = wire.Bez
		local path = wire.Path
		if not path or not (bez or wire.Poly) then
			return
		end
		local k = scaleNow()
		local nudge = Vector2.new(jitter, 0)
		local function px(p)
			return (p * zoom + pan) * k + nudge
		end
		if wire.Poly then
			local points = {}
			for i, p in ipairs(wire.Poly) do
				local q = px(p)
				points[i] = Path2DControlPoint.new(UDim2.fromOffset(q.X, q.Y))
			end
			path.Thickness = WIRE * zoom * k
			path:SetControlPoints(points)
			return
		end
		local p0, p1, p2, p3 = px(bez[1]), px(bez[2]), px(bez[3]), px(bez[4])
		local a, b = p1 - p0, p2 - p3
		path.Thickness = WIRE * zoom * k
		path:SetControlPoints({
			Path2DControlPoint.new(UDim2.fromOffset(p0.X, p0.Y), UDim2.new(), UDim2.fromOffset(a.X, a.Y)),
			Path2DControlPoint.new(UDim2.fromOffset(p3.X, p3.Y), UDim2.fromOffset(b.X, b.Y), UDim2.new()),
		})
	end

	local function drawPath(wire, p0, p1, p2, p3)
		if not Isle.SmoothPaths or pathsBroken then
			return false
		end
		local ok = pcall(function()
			if not wire.Path then
				local path = Instance.new("Path2D")
				path.Parent = pathLayer
				theme:Bind(path, { Color3 = wire.Key })
				wire.Path = path
				pathWires[wire] = true
			end
			if p2 then
				wire.Bez = { p0, p1, p2, p3 }
			else
				wire.Poly = p0
			end
			wire.Hidden = false
			setPath(wire)
			fadePath(wire)
		end)
		if not ok then
			pathsBroken = true
			for other in pairs(pathWires) do
				pcall(function()
					other.Path:Destroy()
				end)
				other.Path = nil
			end
			table.clear(pathWires)
		end
		return ok
	end

	local function syncPaths()
		if pathsBroken then
			return
		end
		-- Path2D only redraws when its points change, so alternate a tiny offset
		jitter = jitter == 0 and 0.01 or 0
		for wire in pairs(pathWires) do
			pcall(setPath, wire)
		end
	end

	syncView = syncPaths

	local SAMPLES = 48
	local FLATNESS = 0.35
	local samples = table.create(SAMPLES + 1)
	local lengths = table.create(SAMPLES + 1)
	local DASH, DASH_GAP = 6, 5

	local function drawCurve(wire, p0, n0, p3, n3, bow)
		local dist = (p3 - p0).Magnitude
		local reach = math.clamp(dist * 0.4, 10, 150)
		local p1 = p0 + n0 * reach
		local p2 = p3 + n3 * reach
		if bow then
			p1 += bow * 1.2
			p2 += bow * 1.2
		end
		for i = 0, SAMPLES do
			local t = i / SAMPLES
			local mt = 1 - t
			samples[i + 1] = p0 * (mt * mt * mt) + p1 * (3 * mt * mt * t) + p2 * (3 * mt * t * t) + p3 * (t * t * t)
		end
		local middle = samples[math.clamp(math.floor(SAMPLES * (wire.ChipAt or 0.5) + 0.5), 0, SAMPLES) + 1]
		local segs = wire.Segments
		if wire.Dashed then
			if wire.Path then
				wire.Hidden = true
				wire.Path.Visible = false
			end
			lengths[1] = 0
			for i = 1, SAMPLES do
				lengths[i + 1] = lengths[i] + (samples[i + 1] - samples[i]).Magnitude
			end
			local total = lengths[SAMPLES + 1]
			local index = 1
			local function at(d)
				while index < SAMPLES and lengths[index + 1] < d do
					index += 1
				end
				local span = lengths[index + 1] - lengths[index]
				local t = span > 0 and (d - lengths[index]) / span or 0
				return samples[index]:Lerp(samples[index + 1], math.clamp(t, 0, 1))
			end
			local used = 0
			local d = 0
			while d < total do
				local from = at(d)
				local to = at(math.min(d + DASH, total))
				used += 1
				if not segs[used] then
					segs[used] = newSegment(wire.Parent, wire.Key)
				end
				placeSegment(segs[used], from, to)
				d += DASH + DASH_GAP
			end
			for i = used + 1, #segs do
				segs[i].Visible = false
			end
			return middle
		end
		if drawPath(wire, p0, p1, p2, p3) then
			for _, seg in ipairs(segs) do
				seg.Visible = false
			end
			return middle
		end
		-- merge samples into the longest runs that stay within FLATNESS of the curve
		local used = 0
		local from = 1
		while from <= SAMPLES do
			local a = samples[from]
			local to = from + 1
			while to <= SAMPLES do
				local b = samples[to + 1]
				local chord = b - a
				local length = chord.Magnitude
				local flat = true
				if length > 0.001 then
					for k = from + 1, to do
						local v = samples[k] - a
						if math.abs(v.X * chord.Y - v.Y * chord.X) / length > FLATNESS then
							flat = false
							break
						end
					end
				end
				if not flat then
					break
				end
				to += 1
			end
			used += 1
			if not segs[used] then
				segs[used] = newSegment(wire.Parent, wire.Key)
			end
			placeSegment(segs[used], a, samples[to])
			from = to
		end
		for i = used + 1, #segs do
			segs[i].Visible = false
		end
		return middle
	end

	local function nodeCenter(node)
		return Vector2.new(node.X + NODE_W / 2, node.Y + NODE_H / 2)
	end

	-- border point facing the target and a normal that turns smoothly around the corners
	local function anchor(node, target)
		local center = nodeCenter(node)
		local d = target - center
		if d.Magnitude < 1 then
			d = Vector2.new(1, 0)
		end
		local hw, hh = NODE_W / 2, NODE_H / 2
		local qx, qy = d.X / hw, d.Y / hh
		local m = math.max(math.abs(qx), math.abs(qy))
		qx, qy = qx / m, qy / m
		local point = center + Vector2.new(qx * hw, qy * hh)
		local normal = Vector2.new(qx * qx * qx, qy * qy * qy)
		return point, normal.Unit
	end

	local function rotated(v, degrees)
		local r = math.rad(degrees)
		local c, s = math.cos(r), math.sin(r)
		return Vector2.new(v.X * c - v.Y * s, v.X * s + v.Y * c)
	end

	local placeEdge

	local settling = {}
	local SIDES = {
		right = Vector2.new(1, 0),
		left = Vector2.new(-1, 0),
		bottom = Vector2.new(0, 1),
		top = Vector2.new(0, -1),
	}

	-- lane index among links that join the same two nodes, in either direction
	local function laneOf(edge, a, b)
		local ids = {}
		for id, other in pairs(edges) do
			if (other.From == edge.From and other.To == edge.To) or (other.From == edge.To and other.To == edge.From) then
				table.insert(ids, id)
			end
		end
		edge.ChipAt = 0.5
		if #ids < 2 then
			return 0
		end
		table.sort(ids)
		local lane = (table.find(ids, edge.Id) or 1) - (#ids + 1) / 2
		local forward = tostring(a.Id) <= tostring(b.Id)
		edge.ChipAt = 0.5 + (forward and lane or -lane) * 0.2
		return lane
	end

	local function sidePoint(side, along)
		local hw, hh = NODE_W / 2, NODE_H / 2
		local normal = SIDES[side]
		if normal.X ~= 0 then
			return Vector2.new(normal.X * hw, math.clamp(along, -(hh - 13), hh - 13)), normal
		end
		return Vector2.new(math.clamp(along, -(hw - 24), hw - 24), normal.Y * hh), normal
	end

	-- picks the sides that face each other: straight across when the nodes line up,
	-- out of the side and into the top or bottom when they sit diagonally
	local function route(edge, a, b)
		local hw, hh = NODE_W / 2, NODE_H / 2
		local d = nodeCenter(b) - nodeCenter(a)
		local slide = laneOf(edge, a, b) * 22
		if math.abs(d.X) <= hw + 12 then
			local sideA = d.Y >= 0 and "bottom" or "top"
			local sideB = d.Y >= 0 and "top" or "bottom"
			local offA, normalA = sidePoint(sideA, d.X * 0.25 + slide)
			local offB, normalB = sidePoint(sideB, -d.X * 0.25 + slide)
			return offA, normalA, offB, normalB
		elseif math.abs(d.Y) <= hh + 12 then
			local sideA = d.X >= 0 and "right" or "left"
			local sideB = d.X >= 0 and "left" or "right"
			local offA, normalA = sidePoint(sideA, d.Y * 0.25 + slide)
			local offB, normalB = sidePoint(sideB, -d.Y * 0.25 + slide)
			return offA, normalA, offB, normalB
		end
		local offA, normalA = sidePoint(d.X >= 0 and "right" or "left", d.Y * 0.08 + slide)
		local offB, normalB = sidePoint(d.Y >= 0 and "top" or "bottom", -d.X * 0.22 + slide)
		return offA, normalA, offB, normalB
	end

	local function drawEdge(edge)
		local a, b = nodes[edge.From], nodes[edge.To]
		local cur = edge.Route
		if not a or not b or not cur then
			return
		end
		local na, nb = cur[2], cur[4]
		if na.Magnitude < 0.01 or nb.Magnitude < 0.01 then
			return
		end
		na, nb = na.Unit, nb.Unit
		local pa = nodeCenter(a) + cur[1]
		local pb = nodeCenter(b) + cur[3]
		local tip = pb + nb * 4
		local wingA, wingB = tip + rotated(nb, 27) * 9, tip + rotated(nb, -27) * 9
		local middle = drawCurve(edge, pa, na, tip + nb * (WIRE * 0.75), nb)
		edge.Chip.Position = UDim2.fromOffset(middle.X, middle.Y)
		if edge.Path and drawPath(edge.Head, { wingA, tip, wingB }) then
			edge.ArrowA.Visible = false
			edge.ArrowB.Visible = false
		else
			placeSegment(edge.ArrowA, tip, wingA)
			placeSegment(edge.ArrowB, tip, wingB)
		end
	end

	local function placePair(fromId, toId)
		for _, other in pairs(edges) do
			if (other.From == fromId and other.To == toId) or (other.From == toId and other.To == fromId) then
				placeEdge(other)
			end
		end
	end

	placeEdge = function(edge)
		local a, b = nodes[edge.From], nodes[edge.To]
		if not a or not b then
			return
		end
		local offA, normalA, offB, normalB = route(edge, a, b)
		edge.Goal = { offA, normalA, offB, normalB }
		if not edge.Route then
			edge.Route = { offA, normalA, offB, normalB }
		else
			settling[edge] = true
		end
		drawEdge(edge)
	end

	-- eases a link to its new sides so it never jumps when the route changes
	local function settleEdges(dt)
		local alpha = damp(14, dt)
		for edge in pairs(settling) do
			local cur, goal = edge.Route, edge.Goal
			if not edges[edge.Id] or not cur or not goal then
				settling[edge] = nil
			else
				local gap = 0
				for i = 1, 4 do
					cur[i] = cur[i]:Lerp(goal[i], alpha)
					gap = math.max(gap, (cur[i] - goal[i]).Magnitude * (i % 2 == 0 and 40 or 1))
				end
				if gap < 0.4 then
					for i = 1, 4 do
						cur[i] = goal[i]
					end
					settling[edge] = nil
				end
				drawEdge(edge)
			end
		end
	end

	local function refreshEdges(node)
		for _, edge in pairs(edges) do
			if not node or edge.From == node.Id or edge.To == node.Id then
				placeEdge(edge)
			end
		end
	end

	local function styleEdge(edge)
		repaintUntil = os.clock() + 0.5
		local on = edge == selectedEdge
		edge.Key = on and "Accent" or "Wire"
		edge.Head.Key = edge.Key
		if edge.Path then
			theme:Set(edge.Path, "Color3", edge.Key, Ease.Hover)
		end
		if edge.Head.Path then
			theme:Set(edge.Head.Path, "Color3", edge.Key, Ease.Hover)
		end
		for _, seg in ipairs(edge.Segments) do
			theme:Set(seg, "BackgroundColor3", edge.Key, Ease.Hover)
		end
		theme:Set(edge.ArrowA, "BackgroundColor3", edge.Key, Ease.Hover)
		theme:Set(edge.ArrowB, "BackgroundColor3", edge.Key, Ease.Hover)
		theme:Set(edge.ChipStroke, "Color", on and "Accent" or "StrokeColor", Ease.Hover)
		theme:Set(edge.ChipStroke, "Transparency", on and "FocusT" or "StrokeT", Ease.Hover)
		theme:Set(edge.ChipLabel, "TextColor3", on and "Text" or "SubText", Ease.Hover)
	end

	local function renderChip(edge)
		local text = edge.Label or ""
		local has = text ~= ""
		local source = edge.Source and sources[edge.Source] or nil
		local iconName = source and source.Icon or nil
		edge.Dashed = source ~= nil and source.Dashed == true
		edge.HasIcon = iconName ~= nil
		edge.ChipLabel.Text = text
		edge.ChipLabel.Visible = has
		edge.ChipDot.Visible = not has and not iconName
		if iconName then
			if edge.ChipIcon then
				edge.ChipIcon:Set(iconName)
			else
				edge.ChipIcon = newIcon(theme, edge.Chip, iconName, "SubText", 11, {
					AnchorPoint = Vector2.new(0, 0.5),
					ZIndex = 2,
				})
			end
			edge.ChipIcon.Frame.Position = has and UDim2.new(0, 8, 0.5, 0) or UDim2.new(0.5, -5.5, 0.5, 0)
		end
		if edge.ChipIcon then
			edge.ChipIcon.Frame.Visible = edge.HasIcon and wireAlpha > 0.5
		end
		local inset = (has and iconName) and 16 or 0
		edge.ChipLabel.Position = UDim2.fromOffset(inset, 0)
		edge.ChipLabel.Size = UDim2.new(1, -inset - (inset > 0 and 5 or 0), 1, 0)
		if has then
			edge.Chip.Size = UDim2.fromOffset(math.clamp(estimate(text, 11) + 18 + inset, 30, 200), 20)
		elseif iconName then
			edge.Chip.Size = UDim2.fromOffset(20, 20)
		else
			edge.Chip.Size = UDim2.fromOffset(14, 14)
		end
	end

	local function fadeChip(edge)
		local a = wireAlpha
		local key = edge == selectedEdge and "FocusT" or "StrokeT"
		edge.Chip.Visible = a > 0.01
		edge.Chip.BackgroundTransparency = 1 - a
		edge.ChipLabel.TextTransparency = 1 - a
		edge.ChipDot.BackgroundTransparency = 1 - a
		if a >= 1 then
			theme:Set(edge.ChipStroke, "Transparency", key)
		else
			theme:Unbind(edge.ChipStroke, "Transparency")
			edge.ChipStroke.Transparency = 1 - (1 - theme:Get(key)) * a
		end
		if edge.ChipIcon then
			edge.ChipIcon.Frame.Visible = edge.HasIcon and a > 0.5
		end
	end

	local function nodeTint(def)
		return theme:Get("SubText"):Lerp(def.Color or theme:Get("Accent"), theme:Get("Tint"))
	end

	local function showPorts(node)
		local on = node.Hover > 0 or node == selected or (grabbed ~= nil and grabbed.kind == "link")
		for _, port in ipairs(node.Ports) do
			tween(port.Scale, on and Ease.Pop or Ease.Hover, { Scale = on and 1 or 0 })
		end
	end

	local function styleNode(node)
		local sel = node == selected or node == linkTarget
		local lit = sel or node.Match == true
		theme:Set(node.Stroke, "Color", lit and "Accent" or "StrokeColor", Ease.Hover)
		theme:Set(node.Stroke, "Transparency", lit and "FocusT" or "StrokeT", Ease.Hover)
		if node.Glow then
			tween(node.Glow, Ease.Smooth, { Transparency = sel and 0.72 or 1 })
		end
		showPorts(node)
	end

	local function renderNode(node)
		local def = typeOf(node.Type)
		local primary = node.Fields[def.Primary] or ""
		local secondary = def.Secondary and node.Fields[def.Secondary] or ""
		node.TitleLabel.Text = primary ~= "" and primary or ("New " .. def.Label)
		node.SubLabel.Text = secondary ~= "" and (def.Label .. "  ·  " .. secondary) or def.Label
		local iconName = def.Icon
		if type(def.IconFor) == "function" then
			local ok, custom = pcall(def.IconFor, node.Fields)
			if ok and type(custom) == "string" and custom ~= "" then
				iconName = custom
			end
		end
		if node.IconName ~= iconName then
			node.IconName = iconName
			node.Icon:Set(iconName, def.Icon)
		end
		node.Icon:SetColor(nodeTint(def))
		local count = #node.Comments
		node.Badge.Visible = count > 0
		node.BadgeLabel.Text = tostring(count)
	end

	function canvas.Deselect(silent)
		local oldNode, oldEdge = selected, selectedEdge
		selected, selectedEdge = nil, nil
		if oldNode then
			styleNode(oldNode)
		end
		if oldEdge and edges[oldEdge.Id] then
			styleEdge(oldEdge)
		end
		if not silent and opts.OnSelect then
			fire(opts.OnSelect, nil)
		end
	end

	local function select(node)
		local oldNode, oldEdge = selected, selectedEdge
		selected, selectedEdge = node, nil
		if oldNode and oldNode ~= node then
			styleNode(oldNode)
		end
		if oldEdge and edges[oldEdge.Id] then
			styleEdge(oldEdge)
		end
		styleNode(node)
		if opts.OnSelect then
			fire(opts.OnSelect, node)
		end
	end
	canvas.Select = select

	function canvas.SelectEdge(edge)
		local oldNode, oldEdge = selected, selectedEdge
		selected, selectedEdge = nil, edge
		if oldNode then
			styleNode(oldNode)
		end
		if oldEdge and oldEdge ~= edge and edges[oldEdge.Id] then
			styleEdge(oldEdge)
		end
		styleEdge(edge)
		if opts.OnEdge then
			fire(opts.OnEdge, edge)
		end
	end

	local function nodeAt(point, skip)
		for _, node in pairs(nodes) do
			if node ~= skip then
				if point.X >= node.X and point.Y >= node.Y and point.X <= node.X + NODE_W and point.Y <= node.Y + NODE_H then
					return node
				end
			end
		end
		return nil
	end

	local tempWire = { Segments = {}, Parent = linkLayer, Key = "Accent" }
	local function showTemp(show)
		if not show then
			for _, seg in ipairs(tempWire.Segments) do
				seg.Visible = false
			end
			tempWire.Hidden = true
			if tempWire.Path then
				tempWire.Path.Visible = false
			end
		end
	end

	local function setLinking(node, side)
		grabbed = node and { kind = "link", node = node, side = side } or nil
		showTemp(node ~= nil)
		for _, other in pairs(nodes) do
			showPorts(other)
		end
	end

	local function makeNode(data)
		local def = typeOf(data.Type)
		local node = {
			Id = data.Id,
			Type = data.Type,
			Fields = data.Fields or {},
			Comments = data.Comments or {},
			Created = data.Created,
			X = data.X or 0,
			Y = data.Y or 0,
			Hover = 0,
			Ports = {},
		}
		local frame = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Position = UDim2.fromOffset(node.X, node.Y),
			Size = UDim2.fromOffset(NODE_W, NODE_H),
			Parent = nodesLayer,
			corner(16),
		})
		theme:Bind(frame, { BackgroundColor3 = "Elevated" })
		local scale = create("UIScale", { Scale = (history.Busy and not history.Pop) and 1 or 0.9, Parent = frame })
		local stroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame })
		theme:Bind(stroke, { Color = "StrokeColor", Transparency = "StrokeT" })
		local shadow = newShadow(frame, {
			BlurRadius = UDim.new(0, 22),
			Offset = UDim2.fromOffset(0, 6),
			ShowBehindParent = true,
		})
		if shadow then
			theme:Bind(shadow, { Color = "Shadow", Transparency = "ShadowT" })
		end
		local glowHost = create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 0,
			Parent = frame,
			corner(16),
		})
		local glow = newShadow(glowHost, { BlurRadius = UDim.new(0, 26), ShowBehindParent = true, Transparency = 1 })
		if glow then
			theme:Bind(glow, { Color = "Accent" })
		end
		local _, icon = iconTile(theme, frame, def.Icon, 34, 17, "SubText", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 13, 0.5, 0),
		})
		local titleLabel = label(theme, {
			Text = "",
			FontFace = Fonts.Medium,
			TextSize = 14,
			Position = UDim2.fromOffset(58, 12),
			Size = UDim2.new(1, -74, 0, 18),
			Parent = frame,
		})
		local subLabel = label(theme, {
			Text = "",
			TextSize = 12,
			Color = "Muted",
			Position = UDim2.fromOffset(58, 32),
			Size = UDim2.new(1, -74, 0, 14),
			Parent = frame,
		})
		local badge = create("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -9, 0, 9),
			Size = UDim2.fromOffset(18, 16),
			Visible = false,
			Parent = frame,
			round(),
		})
		theme:Bind(badge, { BackgroundColor3 = "FieldColor", BackgroundTransparency = "FieldT" })
		local badgeLabel = label(theme, {
			Text = "0",
			FontFace = Fonts.Medium,
			TextSize = 10,
			Color = "SubText",
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = badge,
		})

		local veil = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = frame,
			corner(16),
		})
		theme:Bind(veil, { BackgroundColor3 = "Background" })
		local mark = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.fromOffset(50, 16),
			Visible = false,
			ZIndex = 5,
			Parent = frame,
			round(),
		})
		theme:Bind(mark, { BackgroundColor3 = "Accent" })
		label(theme, {
			Text = opts.SubjectLabel or "Subject",
			FontFace = Fonts.SemiBold,
			TextSize = 10,
			Color = "PrimaryText",
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 5,
			Parent = mark,
		})
		node.Veil = veil
		node.Mark = mark
		window._tooltip(frame, function()
			if grabbed or titleLabel.TextFits then
				return nil
			end
			return titleLabel.Text
		end)

		node.Frame = frame
		node.Scale = scale
		node.Stroke = stroke
		node.Glow = glow
		node.Icon = icon
		node.IconName = def.Icon
		node.TitleLabel = titleLabel
		node.SubLabel = subLabel
		node.Badge = badge
		node.BadgeLabel = badgeLabel

		local function hover(delta)
			node.Hover = math.max(0, node.Hover + delta)
			if delta > 0 then
				showPorts(node)
			else
				task.delay(0.08, function()
					if frame.Parent then
						showPorts(node)
					end
				end)
			end
		end

		for _, side in ipairs({ -1, 1 }) do
			local port = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(side == 1 and 1 or 0, 0, 0.5, 0),
				Size = UDim2.fromOffset(20, 20),
				BackgroundTransparency = 1,
				ZIndex = 3,
				Parent = frame,
			})
			local knob = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(11, 11),
				ZIndex = 3,
				Parent = port,
				round(),
			})
			theme:Bind(knob, { BackgroundColor3 = "Elevated" })
			local knobStroke = create("UIStroke", { Thickness = 1.5, Parent = knob })
			theme:Bind(knobStroke, { Color = "Accent" })
			local knobScale = create("UIScale", { Scale = 0, Parent = knob })
			local core = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(3, 3),
				ZIndex = 3,
				Parent = knob,
				round(),
			})
			theme:Bind(core, { BackgroundColor3 = "Accent" })
			table.insert(node.Ports, { Button = port, Scale = knobScale, Side = side })
			port.MouseEnter:Connect(function()
				hover(1)
				tween(knob, Ease.Pop, { Size = UDim2.fromOffset(14, 14) })
			end)
			port.MouseLeave:Connect(function()
				hover(-1)
				tween(knob, Ease.Hover, { Size = UDim2.fromOffset(11, 11) })
			end)
			port.InputBegan:Connect(function(input)
				if isPress(input) then
					setLinking(node, side)
				end
			end)
		end

		frame.InputBegan:Connect(function(input)
			if isPress(input) and not (grabbed and grabbed.kind == "link") then
				grabbed = { kind = "node", node = node, moved = 0, last = window._pointer() }
				node.TX, node.TY = nil, nil
				arranging[node] = nil
				frame.ZIndex = 5
				tween(scale, Ease.Hover, { Scale = 1.03 })
			end
		end)
		frame.MouseButton2Click:Connect(function()
			if opts.NodeMenu then
				local items = opts.NodeMenu(node)
				if items then
					window:OpenMenu(items)
				end
			end
		end)
		frame.MouseEnter:Connect(function()
			hover(1)
			if node ~= selected and node ~= linkTarget and not node.Match then
				theme:Set(stroke, "Transparency", "FocusT", Ease.Hover)
			end
		end)
		frame.MouseLeave:Connect(function()
			hover(-1)
			if node ~= selected and node ~= linkTarget and not node.Match then
				theme:Set(stroke, "Transparency", "StrokeT", Ease.Hover)
			end
		end)

		nodes[node.Id] = node
		subjectDirty = true
		renderNode(node)
		tween(scale, Ease.Pop, { Scale = 1 })
		return node
	end

	function canvas.AddNode(data)
		data = data or {}
		if not data.Id then
			nodeSeq += 1
			data.Id = "n" .. nodeSeq .. "_" .. math.floor(os.clock() * 1000) % 100000
		end
		if data.X == nil then
			local vp = viewSize()
			local width = panelOpen and (vp.X - PANEL_W) or vp.X
			local center = (Vector2.new(width / 2, vp.Y / 2) - targetPan) / targetZoom
			data.X = center.X - NODE_W / 2 + math.random(-40, 40)
			data.Y = center.Y - NODE_H / 2 + math.random(-30, 30)
		end
		data.X, data.Y = snap(data.X), snap(data.Y)
		data.Created = data.Created or os.time()
		local node = makeNode(data)
		changed()
		return node
	end

	function canvas.UpdateNode(node, data)
		if data.Type then
			node.Type = data.Type
		end
		if data.Fields then
			node.Fields = data.Fields
		end
		renderNode(node)
		changed()
	end

	function canvas.RefreshNode(node)
		renderNode(node)
	end

	local function destroyEdge(edge)
		for _, seg in ipairs(edge.Segments) do
			seg:Destroy()
		end
		edge.Chip:Destroy()
		subjectDirty = true
		if edge.Path then
			edge.Path:Destroy()
			edge.Path = nil
		end
		pathWires[edge] = nil
		if edge.Head.Path then
			edge.Head.Path:Destroy()
			edge.Head.Path = nil
		end
		pathWires[edge.Head] = nil
		edge.ArrowA:Destroy()
		edge.ArrowB:Destroy()
		edges[edge.Id] = nil
		settling[edge] = nil
		if selectedEdge == edge then
			selectedEdge = nil
		end
	end

	function canvas.RemoveNode(node)
		if selected == node then
			canvas.Deselect()
		end
		for _, edge in pairs(table.clone(edges)) do
			if edge.From == node.Id or edge.To == node.Id then
				destroyEdge(edge)
			end
		end
		nodes[node.Id] = nil
		arranging[node] = nil
		subjectDirty = true
		local frame = node.Frame
		tween(node.Scale, Ease.Hover, { Scale = 0.85 })
		task.delay(0.15, function()
			frame:Destroy()
		end)
		changed()
	end

	function canvas.AddEdge(fromId, toId, labelText, id, extra)
		if fromId == toId or not nodes[fromId] or not nodes[toId] then
			return nil
		end
		extra = extra or {}
		if not id then
			for _, edge in pairs(edges) do
				if edge.From == fromId and edge.To == toId then
					if labelText and labelText ~= "" then
						edge.Label = labelText
						renderChip(edge)
					end
					changed()
					return edge
				end
			end
			edgeSeq += 1
			id = "e" .. edgeSeq
		end
		local chip = create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(14, 14),
			ZIndex = 2,
			Parent = edgesLayer,
			round(),
		})
		theme:Bind(chip, { BackgroundColor3 = "Elevated" })
		local chipStroke = create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = chip })
		theme:Bind(chipStroke, { Color = "StrokeColor", Transparency = "StrokeT" })
		local chipLabel = label(theme, {
			Text = "",
			FontFace = Fonts.Medium,
			TextSize = 11,
			Color = "SubText",
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 2,
			Parent = chip,
		})
		local chipDot = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(4, 4),
			ZIndex = 2,
			Parent = chip,
			round(),
		})
		theme:Bind(chipDot, { BackgroundColor3 = "Muted" })
		local edge = {
			Id = id,
			From = fromId,
			To = toId,
			Label = labelText,
			Source = extra.Source,
			Proof = extra.Proof,
			Time = extra.Time or (not history.Busy and os.time() or nil),
			ChipScale = create("UIScale", { Scale = math.max(1, 0.8 / zoom), Parent = chip }),
			Segments = {},
			Parent = edgesLayer,
			Key = "Wire",
			Head = { Segments = {}, Key = "Wire" },
			Chip = chip,
			ChipStroke = chipStroke,
			ChipLabel = chipLabel,
			ChipDot = chipDot,
			ArrowA = newSegment(edgesLayer, "Wire"),
			ArrowB = newSegment(edgesLayer, "Wire"),
		}
		chip.MouseButton1Click:Connect(function()
			canvas.SelectEdge(edge)
		end)
		chip.MouseButton2Click:Connect(function()
			if opts.EdgeMenu then
				local items = opts.EdgeMenu(edge)
				if items then
					window:OpenMenu(items)
				end
			end
		end)
		chip.MouseEnter:Connect(function()
			if edge ~= selectedEdge then
				theme:Set(chipStroke, "Transparency", "FocusT", Ease.Hover)
			end
		end)
		chip.MouseLeave:Connect(function()
			if edge ~= selectedEdge then
				theme:Set(chipStroke, "Transparency", "StrokeT", Ease.Hover)
			end
		end)
		edges[id] = edge
		subjectDirty = true
		renderChip(edge)
		fadeChip(edge)
		placePair(fromId, toId)
		changed()
		return edge
	end

	function canvas.UpdateEdge(edge, data)
		if not edges[edge.Id] then
			return
		end
		if data.Label ~= nil then
			edge.Label = data.Label
		end
		if data.Source ~= nil then
			edge.Source = data.Source ~= "" and data.Source or nil
		end
		if data.Proof ~= nil then
			edge.Proof = data.Proof ~= "" and data.Proof or nil
		end
		renderChip(edge)
		if data.Reverse then
			edge.From, edge.To = edge.To, edge.From
			edge.Route = nil
		end
		placePair(edge.From, edge.To)
		changed()
	end

	function canvas.RemoveEdge(edge)
		local was = selectedEdge == edge
		destroyEdge(edge)
		placePair(edge.From, edge.To)
		if was and opts.OnSelect then
			fire(opts.OnSelect, nil)
		end
		changed()
	end

	function canvas.Connections(node)
		local out = {}
		for _, edge in pairs(edges) do
			if edge.From == node.Id then
				table.insert(out, { Edge = edge, Other = nodes[edge.To], Outgoing = true })
			elseif edge.To == node.Id then
				table.insert(out, { Edge = edge, Other = nodes[edge.From], Outgoing = false })
			end
		end
		return out
	end

	function canvas.NodeById(id)
		return nodes[id]
	end

	local function clearAll()
		canvas.Deselect()
		for _, edge in pairs(table.clone(edges)) do
			destroyEdge(edge)
		end
		for _, node in pairs(nodes) do
			node.Frame:Destroy()
		end
		table.clear(nodes)
		table.clear(edges)
		table.clear(arranging)
		subjectId = nil
		subjectDirty = true
		pan, zoom = Vector2.zero, 1
		targetPan, targetZoom = Vector2.zero, 1
		nodeSeq, edgeSeq = 0, 0
		applyView()
	end

	function canvas.IsEmpty()
		return next(nodes) == nil
	end

	function canvas.Serialize()
		local data = { pan = { targetPan.X, targetPan.Y }, zoom = targetZoom, subject = subjectId, nodes = {}, edges = {} }
		for _, node in pairs(nodes) do
			table.insert(data.nodes, {
				Id = node.Id,
				Type = node.Type,
				Fields = node.Fields,
				Comments = node.Comments,
				Created = node.Created,
				X = math.floor(node.TX or node.X),
				Y = math.floor(node.TY or node.Y),
			})
		end
		for _, edge in pairs(edges) do
			table.insert(data.edges, {
				Id = edge.Id,
				From = edge.From,
				To = edge.To,
				Label = edge.Label,
				Source = edge.Source,
				Proof = edge.Proof,
				Time = edge.Time,
			})
		end
		return data
	end
	snapshot = function()
		return deepCopy(canvas.Serialize())
	end

	local function loadAll(data)
		clearAll()
		data = data or {}
		if data.pan then
			targetPan = Vector2.new(tonumber(data.pan[1]) or 0, tonumber(data.pan[2]) or 0)
			pan = targetPan
		end
		targetZoom = math.clamp(tonumber(data.zoom) or 1, ZOOM_MIN, ZOOM_MAX)
		zoom = targetZoom
		local maxN, maxE = 0, 0
		for _, node in ipairs(data.nodes or {}) do
			makeNode(node)
			local num = tonumber(tostring(node.Id):match("^n(%d+)"))
			if num then
				maxN = math.max(maxN, num)
			end
		end
		for index, edge in ipairs(data.edges or {}) do
			canvas.AddEdge(edge.From, edge.To, edge.Label, edge.Id or ("e" .. index), edge)
			local num = tonumber(tostring(edge.Id):match("^e(%d+)"))
			if num then
				maxE = math.max(maxE, num)
			end
		end
		nodeSeq = math.max(nodeSeq, maxN)
		edgeSeq = math.max(edgeSeq, maxE)
		subjectId = (data.subject ~= nil and nodes[data.subject] ~= nil) and data.subject or nil
		subjectDirty = true
		applyView()
		refreshEdges()
	end

	local function resetHistory()
		table.clear(history.Undo)
		table.clear(history.Redo)
		history.Last = snapshot()
	end

	function canvas.Clear()
		history.Busy = true
		clearAll()
		history.Busy = false
		resetHistory()
	end

	function canvas.Load(data)
		history.Busy = true
		loadAll(data)
		history.Busy = false
		resetHistory()
	end

	local afterRestore
	-- applies a snapshot as a diff so surviving nodes glide to their old places instead of being rebuilt
	local function restore(data)
		history.Busy = true
		history.Pop = true
		data = deepCopy(data)
		local wanted = {}
		for _, item in ipairs(data.nodes or {}) do
			wanted[item.Id] = item
		end
		for id, node in pairs(table.clone(nodes)) do
			if not wanted[id] then
				if selected == node then
					canvas.Deselect()
				end
				for _, edge in pairs(table.clone(edges)) do
					if edge.From == id or edge.To == id then
						destroyEdge(edge)
					end
				end
				nodes[id] = nil
				arranging[node] = nil
				local frame = node.Frame
				tween(node.Scale, Ease.Hover, { Scale = 0.85 })
				task.delay(0.15, function()
					frame:Destroy()
				end)
			end
		end
		for id, item in pairs(wanted) do
			local node = nodes[id]
			if node then
				node.Type = item.Type
				node.Fields = item.Fields or {}
				node.Comments = item.Comments or {}
				node.Created = item.Created
				renderNode(node)
				local x, y = item.X or node.X, item.Y or node.Y
				if node.TX or math.abs(node.X - x) > 0.5 or math.abs(node.Y - y) > 0.5 then
					node.TX, node.TY = x, y
					arranging[node] = true
				end
			else
				makeNode(item)
			end
		end
		local wantedEdges = {}
		for index, item in ipairs(data.edges or {}) do
			item.Id = item.Id or ("e" .. index)
			wantedEdges[item.Id] = item
		end
		for id, edge in pairs(table.clone(edges)) do
			local item = wantedEdges[id]
			if not item or item.From ~= edge.From or item.To ~= edge.To then
				if selectedEdge == edge then
					canvas.Deselect()
				end
				destroyEdge(edge)
				placePair(edge.From, edge.To)
			end
		end
		for id, item in pairs(wantedEdges) do
			local edge = edges[id]
			if edge then
				edge.Label, edge.Source, edge.Proof, edge.Time = item.Label, item.Source, item.Proof, item.Time
				renderChip(edge)
				placePair(edge.From, edge.To)
			else
				canvas.AddEdge(item.From, item.To, item.Label, id, item)
			end
		end
		subjectId = (data.subject ~= nil and nodes[data.subject] ~= nil) and data.subject or nil
		subjectDirty = true
		history.Pop = false
		history.Busy = false
		if afterRestore then
			afterRestore()
		end
		if selected and opts.OnSelect then
			fire(opts.OnSelect, selected)
		elseif selectedEdge and opts.OnEdge then
			fire(opts.OnEdge, selectedEdge)
		end
		if opts.OnChange then
			fire(opts.OnChange)
		end
		if opts.OnRestore then
			fire(opts.OnRestore)
		end
	end

	function canvas.Undo()
		local previous = table.remove(history.Undo)
		if not previous then
			return false
		end
		table.insert(history.Redo, history.Last)
		history.Last = previous
		restore(previous)
		return true
	end

	function canvas.Redo()
		local following = table.remove(history.Redo)
		if not following then
			return false
		end
		table.insert(history.Undo, history.Last)
		history.Last = following
		restore(following)
		return true
	end

	function canvas.Commit()
		changed()
	end

	-- undirected walk from the subject; maps every reachable node id to the id it was reached from
	local function trace()
		if not (subjectId and nodes[subjectId]) then
			return nil
		end
		local previous = { [subjectId] = subjectId }
		local queue = { subjectId }
		local head = 1
		while queue[head] do
			local id = queue[head]
			head += 1
			for _, edge in pairs(edges) do
				local other = (edge.From == id and edge.To) or (edge.To == id and edge.From) or nil
				if other and previous[other] == nil and nodes[other] then
					previous[other] = id
					table.insert(queue, other)
				end
			end
		end
		return previous
	end

	local function refreshSubject()
		subjectDirty = false
		if subjectId and not nodes[subjectId] then
			subjectId = nil
		end
		local previous = trace()
		for id, node in pairs(nodes) do
			local far = previous ~= nil and previous[id] == nil
			node.Mark.Visible = id == subjectId
			if node.Far ~= far then
				node.Far = far
				tween(node.Veil, Ease.Smooth, { BackgroundTransparency = far and 0.5 or 1 })
			end
		end
	end

	function canvas.SetSubject(node)
		subjectId = node and node.Id or nil
		refreshSubject()
		changed()
	end

	function canvas.GetSubject()
		return subjectId and nodes[subjectId] or nil
	end

	function canvas.PathToSubject(node)
		local previous = trace()
		if not previous or previous[node.Id] == nil then
			return nil
		end
		local path = {}
		local id = node.Id
		while id ~= subjectId and #path < 200 do
			table.insert(path, nodes[id])
			id = previous[id]
		end
		table.insert(path, nodes[subjectId])
		return path
	end

	function canvas.SetZoom(value)
		zoomTo(value)
	end

	function canvas.GetZoom()
		return targetZoom
	end

	function canvas.FitView()
		local minX, minY, maxX, maxY
		for _, node in pairs(nodes) do
			local x, y = node.TX or node.X, node.TY or node.Y
			minX = math.min(minX or x, x)
			minY = math.min(minY or y, y)
			maxX = math.max(maxX or x + NODE_W, x + NODE_W)
			maxY = math.max(maxY or y + NODE_H, y + NODE_H)
		end
		local vp = viewSize()
		local width = panelOpen and (vp.X - PANEL_W - 12) or vp.X
		if not minX then
			targetZoom = 1
			targetPan = Vector2.zero
			applyView()
			return
		end
		local bw, bh = maxX - minX, maxY - minY
		local fit = math.min(width / (bw + 120), (vp.Y - 70) / (bh + 120))
		targetZoom = math.clamp(fit, ZOOM_MIN, 1)
		local center = Vector2.new((minX + maxX) / 2, (minY + maxY) / 2)
		targetPan = Vector2.new(width / 2, (vp.Y - 50) / 2) - center * targetZoom
		applyView()
	end

	function canvas.Focus(node)
		local vp = viewSize()
		local width = panelOpen and (vp.X - PANEL_W - 12) or vp.X
		local center = Vector2.new(node.X + NODE_W / 2, node.Y + NODE_H / 2)
		targetPan = Vector2.new(width / 2, vp.Y / 2) - center * targetZoom
	end

	function canvas.Arrange()
		local ids = {}
		for id in pairs(nodes) do
			table.insert(ids, id)
		end
		if #ids == 0 then
			return
		end
		table.sort(ids)
		local links, incoming = {}, {}
		for _, id in ipairs(ids) do
			links[id] = {}
			incoming[id] = 0
		end
		local edgeIds = {}
		for id in pairs(edges) do
			table.insert(edgeIds, id)
		end
		table.sort(edgeIds)
		for _, id in ipairs(edgeIds) do
			local edge = edges[id]
			if links[edge.From] and links[edge.To] then
				table.insert(links[edge.From], edge.To)
				table.insert(links[edge.To], edge.From)
				incoming[edge.To] += 1
			end
		end
		local roots = {}
		if subjectId and nodes[subjectId] then
			table.insert(roots, subjectId)
		end
		local rest = table.clone(ids)
		table.sort(rest, function(a, b)
			if (incoming[a] == 0) ~= (incoming[b] == 0) then
				return incoming[a] == 0
			end
			if #links[a] ~= #links[b] then
				return #links[a] > #links[b]
			end
			return a < b
		end)
		for _, id in ipairs(rest) do
			table.insert(roots, id)
		end
		local GAP_X, GAP_Y = NODE_W + 52, NODE_H + 100
		local seen = {}
		local cursor = 0
		for _, root in ipairs(roots) do
			if not seen[root] then
				seen[root] = true
				local levels = { { root } }
				local depth = 1
				while true do
					local following = {}
					for _, id in ipairs(levels[depth]) do
						for _, other in ipairs(links[id]) do
							if not seen[other] then
								seen[other] = true
								table.insert(following, other)
							end
						end
					end
					if #following == 0 then
						break
					end
					depth += 1
					levels[depth] = following
				end
				local widest = 1
				for _, level in ipairs(levels) do
					widest = math.max(widest, #level)
				end
				local span = widest * GAP_X
				local center = cursor + span / 2
				for d, level in ipairs(levels) do
					for i, id in ipairs(level) do
						local node = nodes[id]
						node.TX = snap(center + (i - (#level + 1) / 2) * GAP_X - NODE_W / 2)
						node.TY = snap((d - 1) * GAP_Y)
						arranging[node] = true
					end
				end
				cursor += span + 60
			end
		end
		canvas.FitView()
		changed()
	end

	local function reveal_(node)
		local vp = viewSize()
		local limit = vp.X - PANEL_W - 28
		local right = (node.X + NODE_W) * targetZoom + targetPan.X
		if right > limit then
			targetPan -= Vector2.new(right - limit, 0)
		end
	end

	local lastClick = { time = 0, pos = Vector2.zero }
	bg.InputBegan:Connect(function(input)
		if isPress(input) then
			grabbed = { kind = "bg", moved = 0, last = window._pointer() }
		end
	end)

	window:_connect(UserInputService.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			if window.ActivePage ~= page or not window.Visible or window._modals > 0 then
				return
			end
			local p = localPointer()
			local vp = viewSize()
			if p.X < 0 or p.Y < 0 or p.X > vp.X or p.Y > vp.Y then
				return
			end
			if panelOpen and p.X > vp.X - PANEL_W - 12 then
				return
			end
			local step = fineZoom() and 1.025 or 1.12
			zoomTo(targetZoom * (input.Position.Z > 0 and step or 1 / step), p)
			return
		end
		if not grabbed or not isMove(input) then
			return
		end
		if grabbed.kind == "link" then
			local from = grabbed.node
			local side = grabbed.side
			local start = Vector2.new(from.X + (side == 1 and NODE_W or 0), from.Y + NODE_H / 2)
			local point = worldPoint()
			local target = nodeAt(point, from)
			if target then
				local border, normal = anchor(target, start)
				drawCurve(tempWire, start, Vector2.new(side, 0), border + normal * 4, normal)
			else
				local back = start - point
				local normal = back.Magnitude > 1 and back.Unit or Vector2.new(-side, 0)
				drawCurve(tempWire, start, Vector2.new(side, 0), point, normal * 0.4)
			end
			if target ~= linkTarget then
				local old = linkTarget
				linkTarget = target
				if old then
					styleNode(old)
				end
				if target then
					styleNode(target)
				end
			end
			return
		end
		local p = window._pointer()
		local delta = (p - grabbed.last) / scaleNow()
		grabbed.last = p
		grabbed.moved += delta.Magnitude
		if grabbed.kind == "bg" then
			targetPan += delta
			pan += delta
			applyView()
		elseif grabbed.kind == "node" then
			local node = grabbed.node
			node.X += delta.X / zoom
			node.Y += delta.Y / zoom
			node.Frame.Position = UDim2.fromOffset(node.X, node.Y)
			refreshEdges(node)
		end
	end)

	window:_connect(UserInputService.InputEnded, function(input)
		if not grabbed or not isPress(input) then
			return
		end
		local g = grabbed
		grabbed = nil
		if g.kind == "link" then
			showTemp(false)
			local target = nodeAt(worldPoint(), g.node)
			local old = linkTarget
			linkTarget = nil
			if old then
				styleNode(old)
			end
			for _, other in pairs(nodes) do
				showPorts(other)
			end
			if target and opts.OnLink then
				fire(opts.OnLink, g.node, target)
			end
		elseif g.kind == "node" then
			g.node.Frame.ZIndex = 1
			tween(g.node.Scale, Ease.Pop, { Scale = 1 })
			if g.moved < 5 then
				select(g.node)
			else
				local free = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)
				if not free then
					g.node.TX, g.node.TY = snap(g.node.X), snap(g.node.Y)
					arranging[g.node] = true
				end
				changed()
			end
		elseif g.kind == "bg" and g.moved < 5 then
			local now = os.clock()
			local p = localPointer()
			if now - lastClick.time < 0.35 and (p - lastClick.pos).Magnitude < 8 then
				lastClick.time = 0
				if opts.OnCreate then
					local point = worldPoint()
					fire(opts.OnCreate, point.X - NODE_W / 2, point.Y - NODE_H / 2)
				end
			else
				lastClick.time, lastClick.pos = now, p
				if selected or selectedEdge then
					canvas.Deselect()
				end
			end
		elseif g.kind == "bg" then
			changed(true)
		end
	end)

	local function pill(props)
